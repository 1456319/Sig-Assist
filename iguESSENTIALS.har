            "text": "/******************************************************************************/\r\n/* ------------------------------ HELP MODAL ---------------------------------*/\r\n\r\n\r\n.helpTooltip \r\n{\r\n   -moz-border-radius-bottomleft: 8px;\r\n   -moz-border-radius-bottomright: 8px;\r\n   -moz-border-radius-topleft: 8px;\r\n   -moz-border-radius-topright: 8px;\r\n   background:#d2e6f4 url(/js/help_popup/ttclose.gif) no-repeat scroll 95% 9px; /* Light Blue Background */\r\n   border: 3px solid #FFFFFF;\r\n   font-size:10px;\r\n   line-height:16px;\r\n   margin:7px 0 0 7px;\r\n   padding:10px 12px 12px;\r\n   position:absolute;\r\n   text-align:left;\r\n   width:250px;\r\n   z-index:5998;\r\n   display:none;\r\n}\r\n\r\n.helpTooltip b \r\n{\r\n   border-bottom:1px solid #AAAAAA;\r\n   color:#3c667d !important;  /* Tooltip Heading Color */\r\n   cursor:pointer;\r\n   display:block;\r\n   font-size:10px;\r\n   text-transform: uppercase;\r\n   margin:0 0 10px;\r\n   padding-bottom:5px;\r\n   width:100%;\r\n}\r\n\r\n.helpTooltip em \r\n{\r\n   color:#222222;\r\n   display:block;\r\n   font-style:normal;\r\n   font-weight:normal;\r\n   letter-spacing:0.02em;\r\n   margin:0 0 7px;\r\n}\r\n.helpIcon\r\n{\r\n   text-decoration:none;\r\n   cursor:help;\r\n}\r\n.helpIcon img\r\n{\r\n   vertical-align:middle;\r\n   margin-bottom:.25em;\r\n}"
          },
