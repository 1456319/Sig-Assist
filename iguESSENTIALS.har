src=\"images/log-browser-nowrap.gif?ver_hash=571F6291\" />\r\n      </div>\r\n      <div id=\"previewWrapTextControlGrey\" style=\"padding:0 16px 0 0; float:right; display:none;\">\r\n         <img id=\"previewWrapTextGrey\" class=\"button\"\r\n            \n    \n    onMouseOver=\"TOOLtooltipLink('You cannot wrap text in this view mode.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\r\n            src=\"images/log-browser-nowrap-grey.gif?ver_hash=571F6291\" />\r\n      </div>\r\n      <div id=\"entryPreviewViewControlContainer\" style=\"float:right; padding-right:3px;\">\r\n         <div class=\"dropdownButtonWrapper\">\r\n            <img id=\"logPreviewSelectDropdownButton\" class=\"ViewDropdownButton\"\r\n               src=\"images/log_views/dropdown-text.gif?ver_hash=571F6291\"\r\n               \n    \n    onMouseOver=\"TOOLtooltipLink('Change the preview mode for this message.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\r\n               onclick=\"javascript:toggleDropdown('logPreviewSelectDropdown', 'logPreviewSelectDropdownButton', CurrentPreviewMode);\">\r\n            </img>\r\n         </div>\r\n         <div id=\"logPreviewSelectDropdown\" style=\"display:none; right:49px;\"\r\n            onclick=\"javascript:hideDropdown('logPreviewSelectDropdown', 'logPreviewSelectDropdownButton', CurrentPreviewMode);\">\r\n            <a class=\"logViewDropdownOption Hex\" onclick=\"showHexPreview(false);\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview hex-dump of this message.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Hex-dump</span>\r\n            </a>\r\n            <a class=\"logViewDropdownOption Text\" onclick=\"showTextPreview(false);\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview plain-text for this message.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Plain-text</span>\r\n            </a>\r\n            <div class=\"logViewDropdownDivider messageOption\" onclick=\"cancelBubble(event);\"></div>\r\n            <a class=\"logViewDropdownOption SegmentMessage messageOption\" onclick=\"showParsedPreview('SegmentMessage', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview segments and composites generated by parse.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Segment View</span>\r\n            </a>\r\n            <a class=\"logViewDropdownOption SegmentGrammar parseOption\" onclick=\"showParsedPreview('SegmentGrammar', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview segment grammar populated with parse results.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Segment Grammar View</span>\r\n            </a>\r\n            <div class=\"logViewDropdownDivider parseOption\" onclick=\"cancelBubble(event);\"></div>\r\n            <a class=\"logViewDropdownOption Table parseOption\" onclick=\"showParsedPreview('Table', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview tables generated by complete parse. (Graphical)', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Table View (Graphical)</span>\r\n            </a>\r\n            <a class=\"logViewDropdownOption TableText parseOption\" onclick=\"showParsedPreview('TableText', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview tables generated by complete parse. (Plain-text)', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Table View (Plain-text)</span>\r\n            </a>\r\n            <a class=\"logViewDropdownOption SQL parseOption\" onclick=\"showParsedPreview('SQL', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview SQL statements generated by complete parse.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>SQL View</span>\r\n            </a>\r\n            <div class=\"logViewDropdownDivider pluginOption\" onclick=\"cancelBubble(event);\"></div>\r\n            <a class=\"logViewDropdownOption PluginOutput pluginOption\" onclick=\"showPluginOutputPreview(false);\" \n    \n    onMouseOver=\"TOOLtooltipLink('View the plugin resubmission preview.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Plugin Output</span>\r\n            </a>\r\n            <div class=\"logViewDropdownDivider mapperOption\" onclick=\"cancelBubble(event);\"></div>\r\n            <a class=\"logViewDropdownOption MapperOutput mapperOption\" onclick=\"LOGshowMapperOutputPreview(false);\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview the output generated by the translator.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Translator Output</span>\r\n            </a>\r\n         </div>\r\n      </div