            "text": "/******************************************************************************/\r\n/* -------------------------- IGUANA GUI LAYOUT ------------------------------*/\r\n\r\n#header {\r\n   height: 120px;\r\n   background-image: url(\"/images/header_bg.gif\");\r\n   background-position: bottom center;\r\n   width: 100%;\r\n}\r\n\r\n#logo {\r\n   position: absolute;\r\n   top: 45px;\r\n   left: 20px;\r\n}\r\n\r\n#version {\r\n   color: #FFFFFF;\r\n   font-size: 11px;\r\n   font-weight: bold;\r\n   position: absolute;\r\n   top: 69px;\r\n   left: 235px;\r\n}\r\n\r\n#version a{\r\n   color: #FFFFFF;\r\n}\r\n   \r\n#login {\r\n   position: absolute;\r\n   top: 49px;\r\n   right: 95px;\r\n   font-size: 10px;\r\n   font-weight: bold;\r\n   color: #244d02;\r\n}\r\n\r\n#login a {\r\n   color: #244d02;\r\n}\r\n\r\n#change_skin {\r\n   position: absolute;\r\n   top: 75px;\r\n   right: 26px;\r\n   color: #244D02;\r\n   font-size: 10px;\r\n   font-weight: bold;\r\n}\r\n\r\n#change_skin a {\r\n   color: #244D02;\r\n}\r\n\r\n#skinning_window {\r\n   position: absolute;\r\n   width: 350px;\r\n   height: 250px;\r\n   z-index: 6000;\r\n   font-size: 11px;\r\n   font-weight: bold;\r\n   color: #78560F;\r\n   text-align: center;\r\n   background-color: #f9fdcb;\r\n   border-top: 2px solid #d5a95d;\r\n   border-left: 2px solid #d5a95d;\r\n   border-bottom: 2px solid #936d27;\r\n   border-right: 2px solid #936d27;\r\n}\r\n\r\n#skinning_window h3 {\r\n   color: #c46a00;\r\n   font-size: 11px;\r\n   font-weight: bold;\r\n   text-transform: uppercase;\r\n   margin-top: 20px;\r\n   margin-bottom: 5px;\r\n   }\r\n\r\n#skinning_window img {\r\n   border: 0px;\r\n   margin-top: 15px;\r\n   margin-left: 8px;\r\n   margin-right: 8px;\r\n   }\r\n\r\n#help_button {\r\n   position: absolute;\r\n   top: 45px;\r\n   right: 26px;\r\n}\r\n\r\n#help_button a {\r\n   display: block;\r\n   height: 23px;\r\n   width: 56px;\r\n   background: url(\"/images/help_button.gif\") 0 0 no-repeat;\r\n}\r\n\r\n#help_button a:hover {\r\n   background-position: 0 -23px;\r\n}\r\n\r\n#help_button a:active {\r\n   background-position: 0 -46px;\r\n}\r\n\r\n#tabs {\r\n   position: relative;\r\n   top: 96px;\r\n}\r\n\r\nbody.tableft {\r\n   background: #D0D6B8; /* Light Beige Background for pages with Tabs on left side */\r\n}\r\n\r\nbody.tabright {\r\n   background: #A5A798; /* Light Grey Background for pages with Tabs on right side */\r\n}\r\n\r\n\r\n\r\n\r\n/* ----- Main Workspace Area on Left Side ----- */\r\n\r\n#main {\r\n   margin: 115px 275px 25px 25px; /* The value for the right margin (275px) must equal to the width of the side panel (230px) + the side panel's right margin (25px) + the space between the main section and the side panel (20px) */\r\n   padding: 0px;\r\n   }\r\n\r\n#iguana {\r\n   width: 100%;\r\n   font-size: 10px;\r\n   border: 2px solid #757671;\r\n   border-spacing: 0px;\r\n   border-collapse: collapse;\r\n   background: #FFFFFF;\r\n}\r\n\r\n\r\n\r\n\r\n/* ----- Side Panel Area on Right Side ----- */\r\n\r\n#side_panel {\r\n   position:absolute;\r\n   top:115px;\r\n   right:25px;\r\n   width:230px;\r\n   padding:0px;\r\n   /* background-color:#eee; */\r\n   border:0px;\r\n/* Internet Explorer Hack */\r\n   voice-family: \"\\\"}\\\"\";\r\n   voice-family:inherit;\r\n   width:230px; /* This value should be = real width - padding - border */\r\n   }\r\n/* Opera 5 */\r\nbody>#side_panel {width:230px;}\r\n\r\n#side_table {\r\n   width: 100%;\r\n   background: #eeefea;\r\n   border: 2px solid #757671;\r\n   border-spacing: 10px;\r\n   border-collapse: collapse;\r\n   margin-bottom: 15px;\r\n}\r\n\r\n/* definitions for help links table, if we need them */\r\n#help_link_table {\r\n   padding: 0px;\r\n   border: 0px;\r\n}\r\n\r\n#help_link_icon {\r\n   padding: 0px;\r\n   border: 0px;\r\n   padding-top: 4px;\r\n   padding-right: 10px;\r\n   padding-bottom: 5px;\r\n   vertical-align: top;\r\n}\r\n\r\n#help_link_name {\r\n   padding: 0px;\r\n   border: 0px;\r\n   padding-bottom: 5px;\r\n}\r\n\r\n#help_log_link_icon {\r\n   padding: 0px;\r\n   border: 0px;\r\n   padding-top: 4px;\r\n   padding-right: 10px;\r\n   vertical-align: top;\r\n}\r\n\r\n#help_log_link_name {\r\n   padding: 0px;\r\n   border: 0px;\r\n}\r\n\r\n\r\n\r\nul.help_link_icon {\r\n   list-style-type: none;\r\n   padding-left: 0;\r\n   margin-left: 0;\r\n}\r\n\r\nul.help_link_icon li {\r\n   list-style-image: none;\r\n   background-image: url(/images/help_icon.gif);\r\n   background-repeat: no-repeat;\r\n   background-position: 0px 1px;\r\n   padding-left: 20px;\r\n   padding-bottom: 4px;\r\n}\r\n\r\nul.help_link_icon li a {\r\n   font-size: 10px;\r\n   font-weight: normal;\r\n   /*color: #6e4402;*/\r\n}\r\n\r\n/* If we want to change the color of the links on mouseover */\r\n/*\r\nul.help_link_icon li a:hover {\r\n   color: #6d6500;\r\n}\r\n*/\r\n\r\n\r\n#side_header,\r\n#popup_header {\r\n   background-color: #e4e5e0;\r\n   background-image: none;\r\n   padding-top: 0px;\r\n   padding-bottom: 0px;\r\n   padding-left: 15px;\r\n   padding-right: 15px;\r\n   color: #787a77;\r\n   text-align: left;\r\n   font-size: 11px;\r\n   font-weight: bold;\r\n   text-transform: none;\r\n   letter-spacing: 0em;\r\n   height:35px;\r\n}\r\n\r\n#side_body,\r\n#popup_body {\r\n   padding-top: 0px;\r\n   padding-bottom: 15px;\r\n   padding-left: 15px;\r\n   padding-right: 15px;\r\n   color: #343434;\r\n   text-align: left;\r\n   font-size: 10px;\r\n   font-weight: normal;\r\n   line-height: 1.5em;\r\n   border-top: 1px solid #757671;\r\n}\r\n\r\nh4.side_title, h4.side_title a {\r\n   font-size: 11px;\r\n   font-weight: bold;\r\n   margin-top: 15px;\r\n   margin-bottom: 10px;\r\n   color: #3d8204;\r\n}\r\n\r\n\r\n\r\n/* Tabular data - left and right aligned on the same row */\r\n\r\ndiv.textrow {\r\n   clear: both;\r\n   margin: 0px;\r\n   height: 16px;\r\n}\r\n\r\np.alignleft {\r\n   float: left;\r\n   margin: 0px;\r\n}\r\n\r\np.alignright  {\r\n   float: right;\r\n   margin: 0px;\r\n   font-weight: bold;\r\n}\r\n\r\n\r\n/* Form Field styles */\r\n\r\ninput, select, textarea {\r\n\tbackground-color: #FFFFFF;\r\n\tborder: 1px solid #BBBBBB;\r\n\tpadding-left: 4px;\r\n}\r\n\r\ninput[type=\"radio\"], input[type=\"checkbox\"] {\r\n\tborder-style: none; \t/* This removes the border from radio buttons & checkboxes, but of course, does not work in IE6 */\r\n        background:transparent;\r\n} \r\n\r\ninput.no_style {\r\n\tborder: none;\r\n\tbackground: none;\r\n}\r\n\r\n\r\n/* ----- Pop-Up Windows ----- */\r\n\r\n\r\n#popup_window {\r\n   background: #eeefea;\r\n   border: 2px solid #757671;\r\n   border-spacing: 10px;\r\n   border-collapse: collapse;\r\n}\r\n\r\n/* Need this to overwrite the black colour used by .ui-widget-content. */\r\n#demo-popup a {\r\n   color: #215fa3;\r\n}\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ---------------------------- NAVIGATION TABS ------------------------------*/\r\n\r\n\r\n/* ----- Old Navigation Tab Styles ----- */\r\n\r\n/*\r\n#navcontainer ul\r\n{\r\n   font-weight: bold;\r\n   letter-spacing: 0.05em;\r\n   padding-left: 0px;\r\n   margin: 0px;\r\n   background-color: #CCCCCC;\r\n   background: url(\"/images/button_bgv4.gif\") repeat-x;\r\n   color: #444444;\r\n   float: left;\r\n   width: 100%;\r\n   height: 29px;\r\n}\r\n\r\n#navcontainer ul li { \r\n   display: inline; \r\n}\r\n\r\n#navcontainer ul li a\r\n{\r\n   padding-top: 6px;\r\n   padding-bottom: 6px;\r\n   padding-left: 15px;\r\n   padding-right: 15px;\r\n   background: url(\"/images/button_bgv4.gif\") repeat-x;\r\n   color: #444444;\r\n   text-decoration: none;\r\n   text-transform: uppercase;\r\n   float: left;\r\n   border-right: 1px solid #A0A0A0;\r\n}\r\n\r\n#navcontainer ul li a:hover\r\n{\r\n   background-color: #CCCCCC;\r\n   background: url(\"/images/button_bg_onv4.gif\") repeat-x;\r\n   color: #000000;\r\n}\r\n\r\n#navcontainer a.current\r\n{\r\n   background-color: #CCCCCC;\r\n   background: url(\"/images/button_bg_onv4.gif\") repeat-x;\r\n   color: #000000;\r\n}\r\n*/\r\n\r\n\r\n\r\n/* ----- New Navigation Tab Style - BEGIN ----- */\r\n\r\n\r\n    #tabs_left {\r\n      float:left;\r\n      width:64%;\r\n      font-size: 11px;\r\n      font-weight: bold;\r\n      line-height:13px;\r\n      }\r\n    #tabs_left ul {\r\n     margin:0;\r\n     padding:0px 25px 0 25px;\r\n     list-style:none;\r\n      }\r\n    #tabs_left li {\r\n      display:inline;\r\n      margin:0;\r\n      padding:0;\r\n      }\r\n    #tabs_left a {\r\n      float:left;\r\n      background:url(\"/images/tableft.gif\") no-repeat left top;\r\n      margin:0;\r\n      padding:0 0 0 5px;\r\n      text-decoration:none;\r\n      }\r\n    #tabs_left a span {\r\n      float:left;\r\n      display:block;\r\n      background:url(\"/images/tabright.gif\") no-repeat right top;\r\n      height:13px;\t  \r\n      width:20px;\r\n      padding:6px 15px 5px 6px;\r\n      color:#244d02; /* Dark Green */\r\n      margin-right: 1px;\r\n      }\r\n      /* folowing rule ignored by IE6 */\r\n      html>body #tabs_left a span { \r\n      width: auto; \r\n      }\r\n    #tabs_left a.current {\r\n      float:left;\r\n      background:url(\"/images/tableft_left_current.gif\") no-repeat left top;\r\n      margin:0;\r\n      padding:0 0 0 5px;\r\n      text-decoration:none;\r\n      }\r\n    #tabs_left a.current span {\r\n      float:left;\r\n      display:block;\r\n      background:url(\"/images/tabright_left_current.gif\") no-repeat right top;\r\n      height:13px;\t  \r\n      width:20px;\r\n      padding:6px 15px 5px 6px;\r\n      color:#30302C;\r\n      margin-right: 1px;\r\n      }     \r\n      /* folowing rule ignored by IE6 */\r\n      html>body #tabs_left a.current span { \r\n      width: auto; \r\n      }\r\n    /* Commented Backslash Hack hides rule from IE5-Mac \\*/\r\n    #tabs_left a span {float:none;}\r\n    /* End IE5-Mac hack */\r\n    #tabs_left a:hover span {\r\n      color:#30302C;\r\n      }\r\n    #tabs_left a:hover {\r\n      background-position:0% -24px;\r\n      }\r\n    #tabs_left a:hover span {\r\n      background-position:100% -24px;\r\n      }\r\n      \r\n      \r\n      \r\n    #tabs_right {\r\n      float:right;\r\n      width:35%;\r\n      font-size:11px;\r\n      font-weight: bold;\r\n      line-height:13px;\r\n      }\r\n    #tabs_right ul {\r\n      float: right;\r\n     margin:0;\r\n     padding:0px 25px 0 25px;\r\n     list-style:none;\r\n      }\r\n    #tabs_right li {\r\n      display:inline;\r\n      margin:0;\r\n      padding:0;\r\n      }\r\n    #tabs_right a {\r\n      float:left;\r\n      background:url(\"/images/tableft.gif\") no-repeat left top;\r\n      margin:0;\r\n      padding:0 0 0 5px;\r\n      text-decoration:none;\r\n      }\r\n    #tabs_right a span {\r\n      float:left;\r\n      display:block;\r\n      background:url(\"/images/tabright.gif\") no-repeat right top;\r\n      height:13px;\t \r\n      width:20px;\r\n      padding:6px 15px 5px 6px;\r\n      color:#244d02; /* Dark Green */\r\n      }\t  \r\n      /* folowing rule ignored by IE6 */\r\n      html>body #tabs_right a span { \r\n      width: auto; \r\n      }\r\n    #tabs_right a.current {\r\n      float:left;\r\n      background:url(\"/images/tableft_right_current.gif\") no-repeat left top;\r\n      margin:0;\r\n      padding:0 0 0 5px;\r\n      text-decoration:none;\r\n      }\r\n    #tabs_right a.current span {\r\n      float:left;\r\n      display:block;\r\n      background:url(\"/images/tabright_right_current.gif\") no-repeat right top;\r\n      height:13px;\t  \r\n      width:20px; /* folowing rule ignored by IE6 */\r\n      padding:6px 15px 5px 6px;\r\n      color:#30302C;\r\n      }\r\n      /* folowing rule ignored by IE6 */\r\n      html>body #tabs_right a.current span { \r\n      width: auto; \r\n      }\r\n    /* Commented Backslash Hack hides rule from IE5-Mac \\*/\r\n    #tabs_right a span {float:none;}\r\n    /* End IE5-Mac hack */\r\n    #tabs_right a:hover span {\r\n      color:#30302C;\r\n      }\r\n    #tabs_right a:hover {\r\n      background-position:0% -24px;\r\n      }\r\n    #tabs_right a:hover span {\r\n      background-position:100% -24px;\r\n      }\r\n\r\n/* ----- New Navigation Tab Style - END ----- */\r\n\r\n\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* -------------------------- DASHBOARD LAYOUT ------------------------------*/\r\n\r\n\r\n#dashboard_body {\r\n   border: 0px solid #A0A0A0;\r\n   background-color: #FFFFFF;\r\n   background-repeat: no-repeat;\r\n   background-position: bottom right;\r\n   padding: 10px;\r\n   margin-bottom: 0px;\r\n   color: #000000;\r\n   vertical-align: top;\r\n   text-align: left;\r\n}\r\n\r\n#cookie_crumb {\r\n   background-color: #e4e5e0;\r\n   padding-top: 0px;\r\n   padding-bottom: 0px;\r\n   padding-left: 15px;\r\n   padding-right: 15px;\r\n   color: #787a77;\r\n   text-align: left;\r\n   font-size: 11px;\r\n   font-weight: bold;\r\n   border-bottom: 1px solid #757671;\r\n   height:35px;\r\n}\r\n\r\n#dashboard_footer {\r\n   background-color: #CCCCCC;\r\n   padding-top: 7px;\r\n   padding-bottom: 7px;\r\n   padding-left: 15px;\r\n   padding-right: 15px;\r\n   color: #444444;\r\n   text-align: right;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ----------------- STANDARD STYLES FOR COMMONLY USED TAGS ----------------- */\r\n\r\nbody {\r\n   font-family: Verdana, Arial, Helvetica, Geneva, Lucida, sans-serif;\r\n   background: #FFFFFF;\r\n   margin: 0px;\r\n   padding: 0px;\r\n}\r\n\r\na {\r\n   color: #215fa3;      /* Blue */\r\n}\r\n\r\na span.text{\r\n   text-decoration:underline;\r\n}\r\n\r\n\r\nh2 {\r\n   color: #367900;      /* Green */\r\n   font-size: 16px;\r\n   margin-top: 15px;\r\n}\r\n\r\nh3 {\r\n   color: #37485A;      /* Greyish-Blue */\r\n   font-size: 14px;\r\n}\r\n\r\n\r\n/* ----- Tables ----- */\r\n\r\nth\r\n{\r\n   background: #3d8204 url(\"/images/th-fade-bg.gif\") top left repeat-x;\r\n   text-align: center;\r\n   text-transform: uppercase;\r\n   font-weight: bold;\r\n   font-size: 10px;\r\n   letter-spacing: 0.05em;\r\n   color: #FFFFFF;\r\n   padding-top: 7px;\r\n   padding-bottom: 7px;\r\n   padding-left: 8px;\r\n   padding-right: 8px;\r\n}\r\n\r\nth.sortable\r\n{\r\n   cursor: pointer;\r\n}\r\n\r\nth.sortable_hover\r\n{\r\n   cursor: pointer;\r\n   background: #509119 url(\"/images/th-fade-bg-hover.gif\") top left repeat-x;\r\n}\r\n\r\ntd\r\n{\r\n   font-size: 11px;\r\n   padding-top: 5px;\r\n   padding-bottom: 3px;\r\n   padding-left: 8px;\r\n   padding-right: 8px;\r\n}\r\n\r\ntd.left\r\n{\r\n   text-align: left;\r\n}\r\n\r\ntd.right\r\n{\r\n   text-align: right;\r\n}\r\n\r\ntd.center\r\n{\r\n   text-align: center;\r\n}\r\n\r\ntable.configuration\r\n{\r\n   width: auto;\r\n   color: #000000;\r\n   background: #dcdfce url(\"/images/table-fade-bg.gif\") top left repeat-x;\r\n   border: 2px #adb1a5 solid;\r\n   border-collapse: collapse;\r\n   border-spacing: 0px;\r\n   text-align: left;\r\n}\r\n\r\ntable.configuration th\r\n{\r\n   background-color: #3d8204;\r\n   border: 1px #adb1a5 solid;\r\n   text-transform: uppercase;\r\n   font-weight: bold;\r\n   font-size: 10px;\r\n   letter-spacing: 0.05em;\r\n   color: #FFFFFF;\r\n   padding: 10px;\r\n}\r\n\r\ntable.configuration td\r\n{\r\n   border-bottom: 1px #adb1a5 dotted;\r\n   border-right: 1px #adb1a5 dotted;\r\n   text-align: left;\r\n   font-weight: normal;\r\n   font-size: 11px;\r\n   color: #000000;\r\n   padding: 6px;\r\n}\r\n\r\ntable.configuration table td\r\n{\r\n   border: 0px;\r\n   padding-top: 0px;\r\n    padding-right: 0px;\r\n    padding-bottom: 0px;\r\n    padding-left: 0px;\r\n}\r\n\r\ntable.configuration td.left_column\r\n{\r\n   font-weight:bold;\r\n   text-align:left;\r\n}\r\n\r\n.admin_only_privilleges\r\n{\r\n   color:#000000;\r\n   text-align:center;\r\n}\r\n\r\n/*\r\ntable.configuration tr:hover\r\n{\r\n  background-color: #e8eece;\r\n  color: #fff;\r\n}\r\n*/\r\n\r\n\r\ntr.first\r\n{\r\n   background-color: #eeefea; /* Alternating row colours eeefea */\r\n}\r\n\r\ntr.second\r\n{\r\n   background-color: #e0e1dd; /* Alternating row colours dfe0dc */\r\n}\r\n\r\n\r\n/* ----- Tooltips ----- */\r\n\r\n.tooltip\r\n{\r\n   position: absolute;\r\n   visibility: hidden;\r\n   z-index: 3;\r\n}\r\n\r\n.tooltip_top\r\n{\r\n   background-repeat: no-repeat;\r\n   height: 18px;\r\n   position: relative;\r\n   top: 2px;\r\n   width: 1px;\r\n}\r\n\r\n.tooltip_bottom\r\n{\r\n   background-repeat: no-repeat;\r\n   height: 18px;\r\n   position: relative;\r\n   top: -2px;\r\n   width: 1px;\r\n}\r\n\r\n.tooltip_body\r\n{\r\n   font-size: 11px;\r\n   color: #333333;\r\n   background-color: #ffc;\r\n   border: 2px solid #c5c6a4;\r\n   padding: 8px;\r\n   -moz-border-radius: 8px;\r\n}\r\n\r\n\r\n\r\n/* Style for Tooltips with tabular data */\r\ntable.IGUlogUsageToolTip {\r\n   margin-top: 0px;\r\n   margin-bottom: 0px;\r\n}\r\n\r\ntable.ComponentToolTip th.ToolTipHeading {\r\n   border-bottom: 1px solid #c5c6a4;\r\n   text-align: center;\r\n   text-transform: uppercase;\r\n   font-weight: normal;\r\n   letter-spacing: 0.05em;\r\n   padding-top: 2px;\r\n   padding-bottom: 6px;\r\n}\r\n\r\ntable.IGUlogUsageToolTip th,\r\ntable.ComponentToolTip th,\r\ntable.ComponentToolTip span.fakeTh {\r\n   border: 0px;\r\n   background: none;\r\n   color: #505040;\r\n   font-size: 10px;\r\n   font-weight: bold;\r\n   text-align: right;\r\n   text-transform: none;\r\n   padding-top: 6px;\r\n   padding-bottom: 0px;\r\n   vertical-align: top;\r\n}\r\n\r\n/*\r\n * The \"table.configuration table.ComponentToolTip td\" is present to\r\n * Prevent the style of \"table.configuration table td\" from\r\n * overriding this style.\r\n */\r\ntable.IGUlogUsageToolTip td,\r\ntable.ComponentToolTip td,\r\ntable.configuration table.ComponentToolTip td {\r\n   background: none;\r\n   color: #222;\r\n   font-size: 10px;\r\n   text-align: left;\r\n   text-transform: none;\r\n   padding-top: 6px;\r\n   padding-bottom: 0px;\r\n   padding-left: 0px;\r\n   line-height: 13px;\r\n   white-space:pre;\r\n}\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ------------------------------ PROGRESS BARS ----------------------------- */\r\n/* See send_validation_email.cs for an example of how to use the progress bar */\r\n\r\ndiv.progress_bar_container {\r\n   border: 1px solid #757671;\r\n   width: 202px;\r\n   height: 18px;\r\n   text-align: left;\r\n}\r\n\r\n/*\r\n * Put the progress bar inside the progress bar container and set its src to\r\n * some image (for example, \"./images/progress_bar.gif\").  Then use some\r\n * AJAX to query the progress, and change the img's width with javascript.\r\n * The maximum width should be 200px.\r\n */\r\nimg.progress_bar { /* starts with no progress (width: 0px) */\r\n   width: 0px;\r\n   height: 16px;\r\n   position: relative;\r\n   top: 1px;\r\n   left: 1px;\r\n}\r\n\r\ndiv.percent_used_container {\r\n   border: 1px solid #888c78;\r\n   background: #bbbeab;\r\n   width: 200px;\r\n   height: 12px;\r\n   text-align: left;\r\n}\r\n\r\n/*\r\n * Put the progress bar inside the progress bar container and set its src to\r\n * some image (for example, \"./images/progress_bar.gif\").  Then use some\r\n * AJAX to query the progress, and change the img's width with javascript.\r\n * The maximum width should be 200px.\r\n */\r\nimg.percent_used { /* starts with no progress (width: 0px) */\r\n   width: 0px;\r\n   height: 12px;\r\n   position: relative;\r\n   top: 0px;\r\n   left: 0px;\r\n}\r\n\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ------------- 3D BUTTONS INSTEAD OF HYPERLINKS/SUBMIT BUTTONS ------------ */\r\n\r\n\r\n.clear { /* generic container (i.e. div) for floating buttons */\r\n    overflow: hidden;\r\n    width: 100%;\r\n}\r\n\r\na.button {\r\n    background: transparent url('/images/bg_button_a.gif') no-repeat scroll top right;\r\n    color: #4d7500;\r\n    display: block;\r\n    float: left;\r\n    font: bold 10px verdana, arial, sans-serif;\r\n    height: 22px;\r\n    margin-right: 0px;\r\n    padding-right: 14px; /* sliding doors padding */\r\n    text-decoration: none;\r\n    cursor: pointer;\r\n}\r\n\r\na.button span {\r\n    background: transparent url('/images/bg_button_span.gif') no-repeat;\r\n    display: block;\r\n    line-height: 12px;\r\n    padding: 5px 0 5px 14px;\r\n    white-space: nowrap;\r\n    height:12px;\r\n}\r\n/* Make sure the span's vertical padding (5 + 5) and line-height (12) amount to the total height of the button (22). Using a different padding, means setting a different height. */\r\n\r\n\r\n/* ----- Button Press ----- */\r\n\r\na.button:active {\r\n    background-position: bottom right !important;\r\n    color: #385500;\r\n    outline: none; /* hide dotted outline in Firefox */\r\n}\r\n\r\na.button:active span {\r\n    background-position: bottom left !important;\r\n    padding: 6px 0 4px 14px; /* push text down 1px */\r\n} \r\n\r\n\r\n/* ----- Button Hover ----- */\r\n\r\na.button:hover {\r\n    background-position: center right;\r\n    color: #385500;\r\n    outline: none; /* hide dotted outline in Firefox */\r\n}\r\n\r\na.button:hover span {\r\n    background-position: center left;\r\n} \r\n\r\n\r\n/* ----- Changing Submit Buttons ----- */\r\n\r\n/*\r\n * Submit buttons will be present but hidden, so that fancy buttons\r\n * can be shown instead.\r\n */\r\ninput.hidden_submit {\r\n   display: none;\r\n}\r\n\r\n\r\n/* ----- Centering the Special 3D Buttons - they need to be put in a table with the 'buttons' ID ----- */\r\n\r\n#buttons {\r\n   text-align: center;\r\n   border-collapse: collapse;\r\n   }\r\n\r\n#buttons td {\r\n   padding: 4px;\r\n}\r\n\r\n/* ----- Icons inside the buttons ----- */\r\n\r\na.button span img {\r\n   border-width: 0px;\r\n   margin-left: -6px;\r\n   margin-top: -2px;\r\n   margin-bottom: -4px;\r\n}\r\n\r\ndiv.button_disable {\r\n    background: transparent url('/images/bg_button_a_disable.gif') no-repeat scroll top right;\r\n    color: #b4b4b4;\r\n    display: block;\r\n    float: left;\r\n    font: bold 10px verdana, arial, sans-serif;\r\n    height: 22px;\r\n    margin-right: 0px;\r\n    padding-right: 14px; /* sliding doors padding */\r\n    text-decoration: none;\r\n    cursor: default;\r\n}\r\n\r\ndiv.button_disable span {\r\n    background: transparent url('/images/bg_button_span_disable.gif') no-repeat;\r\n    display: block;\r\n    line-height: 12px;\r\n    padding: 5px 0 5px 14px;\r\n    white-space: nowrap;\r\n}\r\n\r\ndiv.button_disable span img {\r\n   border-width: 0px;\r\n   margin-left: -6px;\r\n   margin-top: -2px;\r\n   margin-bottom: -4px;\r\n}\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ---------------------------  NAVIGATION TABS ------------------------------*/\r\n\r\n\r\n/* div container both the tabs (navcontainer) AND the tab contents */\r\ndiv.tabs_and_contents {\r\n   background-color: #f0f0f0;\r\n   border-bottom: 1px solid #888;\r\n   margin-left: -10px;\r\n   margin-right: -10px;\r\n   margin-top: -10px;\r\n   margin-bottom: -10px;\r\n}\r\n\r\n.navcontainer {\r\n   /* The following two properties are to stop the tabs from disappearing due to an IE6 bug */\r\n   z-index: 1;\r\n   position: relative;\r\n   background-color: #ccc;\r\n   padding-bottom: 4px;\r\n   border-bottom: 1px solid #888;\r\n}\r\n\r\n.navcontainer h2 {\r\n\tx-text-transform: uppercase;\r\n\tfont-weight: bold;\r\n\tfont-size: 10px;\r\n\tletter-spacing: 0.05em;\r\n\tcolor: #000;\r\n\tmargin-bottom: 13px;\r\n\tmargin-top: 0px;\r\n\tpadding-top: 10px;\r\n}\r\n\r\n.navcontainer a {\r\n\tfont-family: Verdana;\r\n\tfont-weight: bold;\r\n\tfont-size: 11px;\r\n\tpadding: 4px 11px 4px 11px;\r\n\tcolor: #949494;\r\n\tbackground-color: #ffffff; \r\n\ttext-decoration: none;\r\n\tborder: 1px solid #afafaf;\r\n\tborder-bottom: none;\r\n\tmargin-left: 1px;\r\n\tmargin-right: 0px;\r\n   -moz-border-radius-topleft: 4px;\r\n   -moz-border-radius-topright: 4px;\r\n}\r\n\r\n.navcontainer a:hover {\r\n\tcolor: #000;\r\n\tbackground-color: #cfcfcf;\r\n\tborder: 1px solid #888;\r\n}\r\n\r\n.navcontainer a.current {\r\n\tcolor: #315d00;\r\n\tbackground-color: #f1f2ef; \r\n\t/*background: #f1f2ef url(\"/images/config_tab_bg.gif\") repeat-x top;*/\r\n\tpadding: 7px 12px 4px 12px;\t\r\n\tborder: 1px solid #888;\r\n\tborder-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.navcontainer a span.icon_warning {\r\n\tmargin-bottom: -2px;\r\n\tborder: none;\r\n}\r\n\r\n.navcontainer a img.icon_error,\r\n.navcontainer a img.icon_warning {\r\n   margin-bottom: -2px;\r\n   border: none;\r\n}\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* -----------------------  ERROR & WARNING MESSAGES -------------------------*/\r\n\r\n\r\ndiv.warning_message\r\n{\r\n   background-color: #f9fdcb;\r\n   background-image: url('/images/icon_warning_large.gif');\r\n   background-repeat: no-repeat;\r\n   background-position: 15px 12px;\r\n   height: auto;\r\n   text-align: left;\r\n   padding-left: 58px;\r\n   padding-right: 15px;\r\n   padding-top: 10px;\r\n   padding-bottom: 10px;\r\n   border: 1px solid #d5a95d;\r\n   margin: none;\r\n}\r\n\r\ndiv.warning_heading\r\n{\r\n\tcolor: #e00101;\t\t/* Red Warning heading */\r\n\tfont-weight: bold;\r\n\tfont-size: 10px;\r\n\tmargin-bottom: 3px;\r\n\tdisplay: block;\r\n}\r\n\r\ndiv.warning_text\r\n{\r\n   color: #704b16;\t\t/* Brown Warning text */\r\n   font-weight: bold;\r\n}\r\n\r\n\r\ndiv.error_message\r\n{\r\n   background-color: #ffdcdb; \t\t/* Light Red Background */\r\n   background-image: url('/images/icon_error_large.gif');\r\n   background-repeat: no-repeat;\r\n   background-position: 15px 12px;\r\n   height: auto;\r\n   text-align: left;\r\n   padding-left: 58px;\r\n   padding-right: 8px;\r\n   padding-top: 8px;\r\n   padding-bottom: 8px;\r\n   border: 1px solid #FFA19C;\r\n   margin: none;\r\n}\r\n\r\ndiv.error_heading\r\n{\r\n\tcolor: #FF0000;\t\t/* Red Error heading */\r\n\tfont-weight: bold;\r\n\tfont-size: 10px;\r\n\tmargin-bottom: 3px;\r\n\tdisplay: block;\r\n}\r\n\r\ndiv.error_text\r\n{\r\n   color: #343434;\t\t/* Grey Error text */\r\n   font-weight: bold;\r\n}\r\n\r\ntr.error_row {\r\nbackground-color: #ffdcdb;       /* Light Red Background */\r\n}\r\n\r\nspan.validation_error_message_container {\r\nwhite-space: nowrap;\r\ncolor: #FF0000;     /* Red text */\r\nline-height: 18px;\r\n}\r\n\r\nspan.validation_error_message_container img\r\n{\r\n   vertical-align: middle;\r\n   margin-bottom: .25em;\r\n}\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ---------------------------  PATH PREVIEWS --------------------------------*/\r\n\r\n\r\ndiv.path_preview {\r\n   padding: 3px 3px 3px 0px;\r\n   margin: 0px;\r\n   color: #777777;\r\n   font-size: 11px;\r\n}\r\n\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ------------------------  ADVANCED_SETTINGS.CS ----------------------------*/\r\n\r\n/* ----- Rollover Buttons - START ----- */\r\n\r\na.settings_button img {\r\n   margin: 4px 4px 4px 4px;\r\n}\r\n\r\n#button_container {\r\n   max-width: 665px;\r\n   width:expression(document.body.clientWidth > 1000? \"665px\": \"auto\" );\r\n}\r\n\r\n/*\r\n#settings_button  a {\r\n  display: block;\r\n  width: 150px;\r\n  height: 60px;\r\n  margin: 5px;\r\n\r\n#settings_button a:hover\r\n{ \r\n  background-position: 0 -60px;\r\n}\r\n\r\n#settings_button a:active\r\n{ \r\n  background-position: 0 -120px;\r\n}\r\n\r\n#settings_button span\r\n{\r\n  display: none;\r\n}\r\n*/\r\n\r\n/* Add new buttons here as necessary */\r\n\r\n/*\r\na.change_password\r\n{\r\n\r\n  background: url(\"../images/change_password.gif\") no-repeat 0 0;\r\n}\r\n\r\na.users_and_groups\r\n{\r\n\r\n  background: url(\"../images/users_and_groups.gif\") no-repeat 0 0;\r\n}\r\n\r\na.license_entitlement\r\n{\r\n\r\n  background: url(\"../images/license_entitlement.gif\") no-repeat 0 0;\r\n}\r\n\r\na.email_notification\r\n{\r\n\r\n  background: url(\"../images/email_notification.gif\") no-repeat 0 0;\r\n}\r\n\r\na.logging\r\n{\r\n\r\n  background: url(\"../images/logging.gif\") no-repeat 0 0;\r\n}\r\n\r\na.web_server_configuration\r\n{\r\n\r\n  background: url(\"../images/web_server_configuration.gif\") no-repeat 0 0;\r\n}\r\n\r\na.database_settings\r\n{\r\n\r\n  background: url(\"../images/database_settings.gif\") no-repeat 0 0;\r\n}\r\n\r\na.plugin_settings\r\n{\r\n\r\n  background: url(\"../images/plugin_settings.gif\") no-repeat 0 0;\r\n}\r\n*/\r\n\r\n/* ----- Rollover Buttons - END ----- */\r\n\r\n\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ------------------------------ CHANNEL.CS ---------------------------------*/\r\n\r\n/* Table containing configuration tabs.  Make it 100% width so the width doesn't change as we change active tabs */\r\ntable#configuration_tabs_table {\r\n   width: 100%;\r\n   margin-top: 15px;\r\n}\r\n\r\ntd.no_padding {\r\npadding: 0px;\r\ntext-align: center;\r\n}\r\n\r\ntable#channel_configuration_table {\r\npadding-top: 0px;\r\nmargin-top: 0px;\r\n}\r\n\r\ntable#channel_configuration_table tr {\r\npadding-top: 0px;\r\nmargin-top: 0px;\r\nheight:25px;\r\n}\r\n\r\ndiv#channel_configuration_container {\r\noverflow: auto;\r\nposition: relative; /* so that nested \"position:relative\" items are displayed properly in ie6 */\r\n}\r\n\r\n/* Heading inside the tab contents, (eg, \"Source: LLP Listener\") */\r\ntd.component_label\r\n{\r\n   text-align: center;\r\n   text-transform: uppercase;\r\n   font-weight: bold;\r\n   font-size: 10px;\r\n   letter-spacing: 0.05em;\r\n   padding-top: 7px;\r\n   padding-bottom: 7px;\r\n   padding-left: 8px;\r\n   padding-right: 8px;\r\n}\r\n\r\n\r\n/* ----- Ignored Messages ----- */\r\n\r\ntable tr.ignored_message_row td\r\n{\r\n   padding-top: 2px;\r\n   padding-bottom: 2px;\r\n   line-height: 18px;\r\n}\r\n\r\na.ignored_message {\r\n    background: transparent url('/images/bg_recipient_a.gif') no-repeat scroll top right;\r\n    color: #555555;\r\n    display: block;\r\n    float: left;\r\n    font: normal 10px verdana, arial, sans-serif;\r\n    height: 20px;\r\n    margin-right: 5px;\r\n    margin-top: 2px;\r\n    margin-bottom: 2px;\r\n    padding-right: 11px; /* sliding doors padding */\r\n    text-decoration: none;\r\n    cursor: default;\r\n}\r\n\r\na.ignored_message span {\r\n    background: transparent url('/images/bg_recipient_span.gif') no-repeat;\r\n    display: block;\r\n    line-height: 20px;\r\n    padding: 0px 0 0px 11px;\r\n    white-space: nowrap;\r\n}\r\n\r\n\r\n/* Styles for Tables that contain form fields */\r\n\r\ntable.channel_configuation_form {\r\n   margin-top: -5px;\r\n   padding-top: 0px;\r\n\r\n}\r\n\r\ntable.channel_configuation_form th {\r\n\tbackground: none;\r\n\tcolor: #4f9100;\r\n\ttext-transform: none;\r\n\tletter-spacing: 0em;\r\n\tfont-size: 11px;\r\n\tpadding-top: 0px;\r\n}\r\n\r\ntable.channel_configuation_form td\r\n{\r\n   border-top: 1px #c1c1c1 dotted;\r\n   text-align: left;\r\n   font-weight: normal;\r\n   font-size: 11px;\r\n   color: #000000;\r\n   padding: 6px;\r\n}\r\n\r\ntable.channel_configuation_form td.first_row\r\n{\r\n   border-top: 0px;   \r\n}\r\n\r\ntable.channel_configuation_form table td\r\n{\r\n   border: 0px;\r\n   padding-top: 0px;\r\n    padding-right: 10px;\r\n    padding-bottom: 0px;\r\n    padding-left: 0px;\r\n}\r\n\r\ntable.channel_configuation_form td.left_column\r\n{\r\n   font-weight:bold;\r\n   text-align:right;\r\n}\r\n\r\nspan.configurationFillerText\r\n{\r\n   color: #777777;\r\n}\r\n\r\ntr.channel_configuration_section_heading_row td\r\n{\r\n   border-top: 0px;\r\n}\r\n\r\ntr.channel_configuration_section_heading_row td table\r\n{\r\n   padding: 0px;\r\n   width: 100%;\r\n}\r\n\r\ntr.channel_configuration_section_heading_row td table td.channel_configuration_section_heading\r\n{\r\n   white-space: nowrap;\r\n   color: #505050;\r\n   padding: 0px;\r\n}\r\n\r\n/* Message Import */\r\n\r\n/******************************************************************************/\r\n/* -------------------------- COMPONENT_MACROS.CS ----------------------------*/\r\n\r\ninput.file {\r\n   position: relative;\r\n   text-align: left;\r\n   z-index: 1;\r\n   padding-top: 2px;\r\n   padding-bottom: 2px;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ------------------------- COMPONENT_TO_FILE.CS ----------------------------*/\r\n\r\n\r\nspan.invalidFilenameMaskCharacter {\r\n   background-color: pink;\r\n   color: red;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ----------------------------- DASHBOARD.CS --------------------------------*/\r\n\r\n\r\ndiv.left_align\r\n{\r\n   text-align: left;\r\n}\r\n\r\ndiv.center_align\r\n{\r\n   text-align: center;\r\n}\r\n\r\n\r\n/* WARNING message styles */\r\n\r\ndiv.ajax_warning\r\n{\r\n   background-color: #f9fdcb;\r\n   background-image: url('/images/icon_warning_large.gif');\r\n   background-repeat: no-repeat;\r\n   background-position: 15px 12px;\r\n   height: auto;\r\n   text-align: left;\r\n   padding-left: 60px;\r\n   padding-right: 15px;\r\n   padding-top: 10px;\r\n   padding-bottom: 10px;\r\n   border: 1px solid #d5a95d;\r\n   margin-left: 2px;\r\n   margin-bottom: 10px;\r\n}\r\n\r\n\r\n/* ERROR message styles */\r\ndiv.ajax_error\r\n{\r\n   background-color: #ffdcdb; \t\t/* Light Red Background */\r\n   background-image: url('/images/icon_error_large.gif');\r\n   background-repeat: no-repeat;\r\n   background-position: 15px 12px;\r\n   height: auto;\r\n   text-align: left;\r\n   padding-left: 58px;\r\n   padding-right: 15px;\r\n   padding-top: 10px;\r\n   padding-bottom: 10px;\r\n   border: 1px solid #FFA19C;\r\n}\r\n\r\nspan.ajax_error_heading\r\n{\r\n\tcolor: #FF0000;\t\t/* Red Error heading */\r\n\tfont-weight: bold;\r\n}\r\n\r\ndiv.ajax_error_text\r\n{\r\n   color: #343434;\t\t/* Grey Error text */\r\n   font-weight: bold;\r\n}\r\n\r\ndiv.dashboard_channel_list\r\n{\r\n   height: 100%;\r\n   text-align: left;\r\n   overflow-y: auto;\r\n   overflow-x: auto;\r\n}\r\n\r\ntable.dashboard_channel_list_table\r\n{\r\n   width: 100%;\r\n}\r\n\r\ndiv.no_channels_message\r\n{\r\n   text-align: center;\r\n   width: 100%;\r\n}\r\n\r\ndiv.dashboard_channel_headings\r\n{\r\n   text-align: left;\r\n   position: absolute;\r\n   background-color: #FFFFFF;\r\n   overflow: hidden;\r\n}\r\n\r\ntable.dashboard_channel_headings_table\r\n{\r\n   position: relative;\r\n   overflow: hidden;\r\n}\r\n\r\ninput.pause_or_resume_button\r\n{\r\n   background-color: #DDDDDD;\r\n   border: #BBBBBB 1px solid;\r\n   font-family: verdana;\r\n   font-size: 7pt;\r\n   color: #787a77;\r\n   padding-top: 0px;\r\n   padding-bottom: 0px;\r\n   margin-left: 4px;\r\n}\r\n\r\n/* Search field */\r\n\r\ntable.search_field_container\r\n{\r\n   float: right;\r\n}\r\n\r\ndiv.search_field\r\n{\r\n   border: 1px solid #BBBBBB;\r\n   background-color: #FFFFFF;\r\n   height: 20px;\r\n   padding-right: 2px;\r\n}\r\n\r\ndiv.search_field img\r\n{\r\n   position: relative;\r\n   top: 3px;\r\n}\r\n\r\ndiv.search_field img#imgClearFilterIcon\r\n{\r\n   visibility: hidden;\r\n   cursor: pointer;\r\n}\r\n\r\ndiv.search_field img#imgMagnifyingGlass\r\n{\r\n   left: 3px;\r\n}\r\n\r\ndiv.search_field input#inputChannelFilter\r\n{\r\n   border-width: 0px;\r\n   color: #343434;\r\n   position: relative;\r\n   left: 2px;\r\n   top: 1px;\r\n   width: 100px;\r\n   font-size: 11px;\r\n}\r\n\r\n/* Remove 'x' in IE10+ */\r\ndiv.search_field input#inputChannelFilter::-ms-clear {\r\n    display: none;\r\n}\r\n\r\n\r\nspan.dashboard_search_match\r\n{\r\n   background-color: #FFFF00;\r\n}\r\n\r\ntd.channel_name span.dashboard_search_match\r\n{\r\n   text-decoration: underline;\r\n}\r\n\r\n/******************************************************************************/\r\n/* --------------------------  EMAIL_RULE_EDIT.CS -----------------------------*/\r\n\r\n\r\ntable.configuration tr td table.time_filter_table {\r\n\tborder-collapse: separate;\r\n\tborder-spacing: 1px;\r\n\t*border-collapse: expression('separate', cellSpacing = '1px'); /* IE hack for cellspacing property */\r\n\tfont-family: Arial, Tahoma, Verdana;\r\n\tcolor: #52544e; /* table font colour */\r\n}\r\n\r\n\r\ntable.configuration tr td tr.time_filter_row {\r\n}\r\n\r\ntable.configuration tr td tr.time_filter_row_weekend  div.off {\r\n\tbackground-color: #bdbfb2;\t/* weekend background colour */\r\n}\r\n\r\ndiv.off {\r\n\theight: 12px;\r\n\twidth: 17px;\r\n\tbackground-color: #cccec1;  /* weekday background colour */\r\n}\r\n\r\ndiv.on {\r\n\theight: 12px;\r\n\twidth: 17px;\r\n\tbackground: #629b02 url('/images/green_fade.gif') repeat-x scroll left top;  /* selected background color */\r\n}\r\n\r\ntable.configuration tr td td.time_filter_cell {\r\n\tpadding: 0px;\r\n\tfont-size: 9px;\r\n\ttext-align: center;\r\n}\r\n\r\ntable.configuration tr td td.time_filter_cell_day {\r\n\tpadding: 0px 5px 0px 0px;\r\n\tfont-size: 9px;\r\n\ttext-transform: uppercase;\r\n}\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* --------------------------  EMAIL_SETTINGS.CS -----------------------------*/\r\n\r\ntd.radio_button\r\n{\r\n   padding-top: 0px;\r\n   padding-bottom: 0px;\r\n   padding-left: 0px;\r\n   padding-right: 5px;\r\n}\r\n\r\n#recipient_text_area\r\n{\r\n   font-family: Verdana, Arial, Helvetica, Geneva, Lucida, sans-serif;\r\n   font-size: 12px;\r\n   overflow: auto;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n/***********************************************************************************/\r\n/* --------------------------  EMAIL_SETTINGS_VIEW.CS -----------------------------*/\r\n\r\nul.configuration_table_list\r\n{\r\n   padding-left: 15px;\r\n   margin: 0px;\r\n}\r\n\r\n#email_details_panel\r\n{\r\n   height: 300px;\r\n   width: 480px;\r\n   overflow: auto;\r\n   border-width: 1px;\r\n   text-align: left;\r\n   border: 1px solid #757671;\r\n   background-color:  #eeefea;\r\n   white-space: nowrap\r\n}\r\n\r\nspan.client_message\r\n{\r\n   color: blue;\r\n}\r\n\r\nspan.server_message\r\n{\r\n   color: purple;\r\n}\r\n\r\n/*\r\na.recipient\r\n{\r\n   background-color: #E0FFFF;\r\n   padding: 1px 7px 1px 7px;\r\n   border: 1px solid #B7CEEC;\r\n   cursor: default;\r\n   text-decoration: none;\r\n   color: #15317E;\r\n   white-space: nowrap;\r\n   font-size: 9px;\r\n}\r\n\r\na.recipient:hover\r\n{\r\n   background-color: #ffc;\r\n}\r\n*/\r\n\r\ntable tr.recipient_row td\r\n{\r\n   padding-top: 2px;\r\n   padding-bottom: 2px;\r\n   line-height: 18px;\r\n}\r\n\r\n\r\n\r\n.clear { /* generic container (i.e. div) for floating buttons */\r\n\toverflow: hidden;\r\n\twidth: 100%;\r\n}\r\n\r\n\r\n/* ----- Recipient Background ----- */\r\n\r\na.recipient {\r\n    background: transparent url('/images/bg_recipient_a.gif') no-repeat scroll top right;\r\n    color: #555555;\r\n    display: block;\r\n    float: left;\r\n    font: normal 10px verdana, arial, sans-serif;\r\n    height: 20px;\r\n    margin-right: 5px;\r\n    margin-top: 2px;\r\n    margin-bottom: 2px;\r\n    padding-right: 11px; /* sliding doors padding */\r\n    text-decoration: none;\r\n}\r\n\r\na.recipient_broken {\r\n   color: red;\r\n}\r\n\r\na.recipient_no_link {\r\n    cursor: default;\r\n}\r\n\r\na.recipient span {\r\n    background: transparent url('/images/bg_recipient_span.gif') no-repeat;\r\n    display: block;\r\n    line-height: 20px;\r\n    padding: 0px 0 0px 11px;\r\n    white-space: nowrap;\r\n}\r\n\r\n/* ----- Recipient Background Hover ----- */\r\n\r\na.recipient:hover {\r\n    background-position: bottom right;\r\n    color: #000000;\r\n    outline: none; /* hide dotted outline in Firefox */\r\n}\r\n\r\na.recipient:hover span {\r\n    background-position: bottom left;\r\n} \r\n\r\n\r\n/******************************************************************************/\r\n/* ---------------------------  EXPORT_TABLES.CS -----------------------------*/\r\n\r\ntextarea.export_error\r\n{\r\n   background-color: #EDF0F4;\r\n   width: 90%;\r\n   height: 150px;\r\n   color: red;\r\n   padding: 10px;\r\n}\r\n\r\ntextarea.export_status\r\n{\r\n   background-color: #EDF0F4;\r\n   width: 90%;\r\n   height: 150px;\r\n   color: black;\r\n   padding: 10px;\r\n}\r\n\r\ntextarea.export_preview\r\n{\r\n   background-color: #EDF0F4;\r\n   width: 90%;\r\n   height: 150px;\r\n   padding: 10px;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ---------------------------  LOG_BROWSE.CS --------------------------------*/\r\n\r\n/* Style for Hex View of Logs */\r\ndiv.ho\r\n{  \r\n   background-color: #C8C8EF;\r\n}\r\n\r\nfont.hst\r\n{\r\n   background-color: #A0A0D0;\r\n}\r\n\r\n\r\n/* Style for Tooltip table on logs page */\r\ntable.IGUlogUsageToolTip {\r\n   margin-top: 0px;\r\n   margin-bottom: 0px;\r\n}\r\n\r\ntable.IGUlogUsageToolTip th {\r\n   background: none;\r\n   color: #505040;\r\n   font-size: 10px;\r\n   font-weight: bold;\r\n   text-align: right;\r\n   text-transform: none;\r\n   padding-top: 2px;\r\n   padding-bottom: 3px;\r\n}\r\n\r\ntable.IGUlogUsageToolTip td {\r\n   background: none;\r\n   color: #222;\r\n   font-size: 10px;\r\n   text-align: left;\r\n   text-transform: none;\r\n   padding-top: 2px;\r\n   padding-bottom: 3px;\r\n   padding-left: 0px;\r\n}\r\n\r\ndiv.entryViewPleaseWaitBar\r\n{\r\n   padding: 3px;\r\n   border: 1px solid #CCCC00;\r\n   background-color: #FFFF33;\r\n   color: #555500;\r\n   text-align: center;\r\n   opacity: 0.75;\r\n}\r\n\r\ndiv#entryArea pre,\r\ndiv#resubmitPreview pre,\r\ndiv#textViewContainer\r\n{\r\n   margin: 0px;\r\n   padding-left: 4px;\r\n}\r\n\r\ndiv#entryArea pre pre.innerPreChunk,\r\ndiv#resubmitPreview pre pre.innerPreChunk\r\n{\r\n   padding-left: 0;\r\n}\r\n\r\ndiv.viewSelectDropdown\r\n{\r\n   height: 32px;\r\n}\r\n\r\ndiv.dropdownButtonWrapper\r\n{\r\n   width: 40px;\r\n   height: 30px;\r\n   overflow-y: visible;\r\n}\r\n\r\nimg.ViewDropdownButton\r\n{\r\n   cursor: pointer;\r\n}\r\n\r\ndiv#logViewSelectDropdown,\r\ndiv#logPreviewSelectDropdown\r\n{\r\n   position: absolute;\r\n   z-index: 1;\r\n   background-color: #FFFFFF;\r\n   border: 1px solid #757671;\r\n}\r\n\r\na.logViewDropdownOption\r\n{\r\n   display: block;\r\n   height: 28px;\r\n   width: 16em;\r\n   padding-right: 10px;\r\n   border-bottom: solid #666666 1px;\r\n   cursor: pointer;\r\n}\r\n\r\na.logViewDropdownOption img\r\n{\r\n   margin-right: 5px;\r\n}\r\n\r\na.logViewDropdownOption span\r\n{\r\n   position: relative;\r\n   top: -9px;\r\n}\r\n\r\ndiv.logViewDropdownDivider\r\n{\r\n   height: 1px;\r\n   width: 16em;\r\n   padding-right: 10px;\r\n   background-color: #AAAAAA;\r\n   border-bottom: solid #666666 1px;\r\n}\r\n\r\na.logViewDropdownOption:hover\r\n{\r\n   background-color: #D6E7D2;\r\n}\r\n\r\na.logViewDropdownOption.disabled\r\n{\r\n   color: #B5B6B1;\r\n}\r\n\r\na.logViewDropdownOption.disabled:hover\r\n{\r\n   background-color: inherit;\r\n}\r\n\r\n\r\n/* Styles for Segment View */\r\n\r\ndiv#SegmentViewErrorPanelControls\r\n{\r\n   border-top: 1px solid #BBBBBB;\r\n}\r\n\r\ndiv#SegmentViewErrorPanel\r\n{\r\n   width: 100%;\r\n   height: 72px;\r\n   overflow: auto;\r\n   border-top: 1px solid #BBBBBB;\r\n   background-color: #F2F5A9;\r\n}\r\n\r\ndiv.errorPannelHeader\r\n{\r\n   padding: 2px;\r\n   background-color: #EEEFEA;\r\n   border-bottom: 1px solid #BBBBBB;\r\n}\r\n\r\ndiv#SegmentViewErrorItems div\r\n{\r\n   padding-left: 5px;\r\n   padding-top: 2px;\r\n   white-space: nowrap;\r\n   color: #000000;\r\n   cursor: text;\r\n}\r\n\r\ndiv#SegmentViewErrorItems div.clickable\r\n{\r\n   cursor: pointer;\r\n}\r\n\r\ndiv#SegmentViewErrorItems div.clickable.hover\r\n{\r\n   color: #215FA3;\r\n}\r\n\r\ndiv#SegmentViewErrorItems div.errorItem,\r\ndiv#SegmentViewErrorItems div.warningItem\r\n{\r\n   padding: 3px 0 0 22px;\r\n   background-repeat: no-repeat;\r\n   background-position: 4px 2px;\r\n}\r\n\r\ndiv#SegmentViewErrorItems div.errorItem\r\n{\r\n   background-image: url(/images/icon_error.gif);\r\n}\r\n\r\ndiv#SegmentViewErrorItems div.warningItem\r\n{\r\n   background-image: url(/images/icon_warning.gif);\r\n}\r\n\r\n\r\n/* Styles for Table View */\r\n\r\ntable.parsedTableView tr td.header\r\n{\r\n   background-color: #DDDDDD;\r\n}\r\n\r\ntable.parsedTableView tr td\r\n{\r\n   white-space: nowrap;\r\n   background-color: #FFFFFF;\r\n   \r\n   /* Give the cells a somewhat \"3D\" look. */\r\n   border-top: solid #B0B0B0 1px;\r\n   border-left: solid #B0B0B0 1px;\r\n   border-bottom: solid #606060 1px;\r\n   border-right: solid #606060 1px;\r\n}\r\n\r\ntable.parsedTableView tr td.empty\r\n{\r\n   background: inherit;\r\n   border: none;\r\n}\r\n\r\ndiv#reparseWarning\r\n{\r\n   padding-top: 4px;\r\n   color: #666666;\r\n}\r\n\r\nspan.tableCountOfRow\r\n{\r\n   color: #666666;\r\n}\r\n\r\n\r\n/* Styles Log Resubmit Page */\r\n\r\ntextarea#messageEditor\r\n{\r\n   overflow: auto;\r\n   margin-top: 10px;\r\n   margin-bottom: 10px;\r\n   font-size: 11px;\r\n   font-family: \"Arial Monospaced\", monospace;\r\n   resize: none;\r\n}\r\n\r\ndiv#resubmitTopControls\r\n{\r\n   background-color: #E4E5E0;\r\n   border-bottom: 1px solid #757671;\r\n   vertical-align: center;\r\n   color: #686A67;\r\n   font-weight: bold;\r\n}\r\n\r\ndiv#resubmitTopControls div\r\n{\r\n   padding: 7px;\r\n}\r\n\r\ndiv#resubmitEditControls\r\n{\r\n   padding-top: 10px;\r\n}\r\n\r\ndiv#resubmitComplete\r\n{\r\n   width:100%;\r\n   height:30px;\r\n}\r\n\r\n/* Nested divs allow us to align to the bottom of the dialog, even in IE7 */\r\ndiv#resubmitComplete div\r\n{\r\n   width: 100%;\r\n   position: absolute;\r\n   bottom: 12px;\r\n}\r\n\r\ndiv#resubmitPreview\r\n{\r\n   overflow: auto;\r\n   background-color:#eeefea;\r\n   border: 1px solid #BBBBBB;\r\n   margin-bottom: 10px;\r\n}\r\n\r\niframe#resubmitFrame, iframe#popoutErrorFrame\r\n{\r\n   position: absolute;\r\n   top: 0px;\r\n   left: 0px;\r\n   z-index: 1;\r\n   border: 0;\r\n   opacity: 0.8;\r\n   filter: alpha(opacity=80);\r\n}\r\n\r\ndiv#resubmitDialog\r\n{\r\n   position: absolute;\r\n   top: 36px;\r\n   left: 36px;\r\n   z-index: 2;\r\n   background-color: #FFFFFF;\r\n   border: solid #606060 5px;\r\n   font-size: 11px;\r\n   overflow: visible; /* If logPreviewSelectDropdown goes outside of the dialog, it should be displayed. */ \r\n}\r\n\r\ndiv.resubmit_toolbar_heading\r\n{\r\n   float: left; \r\n   color: #3D8204; \r\n   font-weight: bold;\r\n}\r\n\r\ndiv.resubmit_toolbar_heading a\r\n{\r\n   color: #3D8204; \r\n   text-decoration: none;\r\n}\r\n\r\ndiv.preview_mode_text\r\n{\r\n   color: #949494;\r\n   padding: 8px 5px 0 0;\r\n   font-weight: bold;\r\n}\r\n\r\n/*** BEGIN STEPS (no longer used) ***\r\n\r\n// This is the table row that contains the procedural steps\r\ntr.steps {\r\n\tbackground-color: #f2f2f2;\r\n}\r\n\r\n// This is the table cell that contains the procedural steps\r\ntd.steps {\r\n\tpadding: 7px 9px 1px 9px;\r\n\tborder: 1px solid #ddd;\r\n}\r\n\r\ndiv.step_left {\r\n\tfloat: left; \r\n\theight: 36px; \r\n\twidth: 10px; \r\n\tbackground-image: url(/images/bg_step_left.gif); \r\n\tbackground-position: top left;\r\n}\r\n\r\ndiv.step_right {\r\n\tfloat: left; \r\n\theight: 36px; \r\n\twidth: 12px; \r\n\tbackground-image: url(/images/bg_step_right.gif); \r\n\tbackground-position: top right;\r\n}\r\n\r\ndiv.step_arrow {\r\n\tfloat: left; \r\n\theight: 36px; \r\n\twidth: 26px; \r\n\tbackground-image: url(/images/bg_step_arrow.gif); \r\n\tbackground-position: top center;\r\n}\r\n\r\ndiv.current_step {\r\n/*\tcolor: #3D8204;*/\r\n\tcolor: #000;\r\n\tfont-weight: bold;\r\n\tfloat: left; \r\n\tpadding: 7px 0px 0px 0px; \r\n\theight: 29px;\r\n\tbackground-image: url(/images/bg_step_pointer.gif); \r\n\tbackground-repeat: repeat-x; \r\n\tbackground-position: top center;\r\n}\r\n\r\ndiv.enabled_step {\r\n\tcolor: #9b9b9b;\r\n\tfont-weight: bold;\r\n\tfloat: left; \r\n\tpadding: 7px 0px 0px 0px; \r\n\theight: 29px; \r\n\tbackground-image: url(/images/bg_step.gif); \r\n\tbackground-repeat: repeat-x; \r\n\tbackground-position: top center;\r\n}\r\n\r\ndiv.enabled_step a:link,\r\ndiv.enabled_step a:visited {\r\n\tcolor: #9b9b9b;\r\n}\r\n\r\ndiv.enabled_step a:hover,\r\ndiv.enabled_step a:active {\r\n\tcolor: #215FA3;\r\n}\r\n\r\ndiv.disabled_step {\r\n\tcolor: #c3c3c3;\r\n\tfont-weight: bold;\r\n\tfloat: left; \r\n\tpadding: 7px 0px 0px 0px; \r\n\theight: 29px;\r\n\tbackground-image: url(/images/bg_step.gif); \r\n\tbackground-repeat: repeat-x; \r\n\tbackground-position: top center;\r\n}\r\n\r\ndiv.step_buttons {\r\n\tfloat: right;\r\n}\r\n\r\n/* This is the table cell that contains the message textarea */\r\ntd.steps_body {\r\n\tpadding: 0; \r\n\tborder: 1px solid #ddd;\r\n}\r\n\r\n/*** END STEPS ***/\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ------------------------------  LOGS.CS -----------------------------------*/\r\n\r\n/*\r\ntable.log_errors\r\n{\r\n   width: 422px;\r\n}\r\n*/\r\n\r\n/*\r\ntable.log_summary\r\n{\r\n   width: 150px;\r\n}\r\n*/\r\n\r\n/*\r\ntd.log_success\r\n{\r\n   width: 150px;\r\n}\r\n*/\r\n\r\ntd.log_description\r\n{\r\n   padding-top: 0px;\r\n   padding-bottom: 0px;\r\n   padding-left: 5px;\r\n   padding-right: 0px;\r\n   text-align: left;\r\n}\r\n\r\ntd.log_number\r\n{\r\n   padding: 0px;\r\n   text-align: right;\r\n}\r\n\r\ntd.log_export\r\n{\r\n   width: 16px;\r\n   padding-top: 0px;\r\n   padding-bottom: 0px;\r\n   padding-left: 5px;\r\n   padding-right: 0px;\r\n}\r\n\r\ntd.log_trash\r\n{\r\n   width: 16px;\r\n   padding-top: 0px;\r\n   padding-bottom: 0px;\r\n   padding-left: 5px;\r\n   padding-right: 5px;\r\n}\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ------------------------------  LOG_USAGE_STATISTICS.CS -----------------------------------*/\r\n\r\n\r\ntable.log_statistics\r\n{\r\n   margin-top: 7px;\r\n   margin-bottom: 7px;\r\n}\r\n\r\ntable.log_statistics tr\r\n{\r\n   line-height: 18px;\r\n}\r\n\r\ntable.log_statistics td\r\n{\r\n   font-size: 11px;\r\n}\r\n\r\ntable.log_statistics td.right\r\n{\r\n   text-align   : right;\r\n   padding-right: 6px;\r\n}\r\n\r\ntable.configuration tr.sub_header\r\n{\r\n   background: #c7cbbd;\r\n}\r\n\r\ntable.configuration tr.sub_header td\r\n{\r\n   border: 1px #adb1a5 solid;\r\n}\r\n\r\ntable.configuration tr.sub_header td\r\n{\r\n   text-align: center;\r\n   text-transform: uppercase;\r\n   font-size: 10px;\r\n}\r\n\r\ntable.configuration tr.footer\r\n{\r\n   border: 1px #adb1a5 solid;\r\n}\r\n\r\n\r\n/******************************************************************************/\r\n/* ----------------------  MULTI_SELECT_CHOOSER.JS----------------------------*/\r\n\r\ndiv.MSCunselected\r\n{\r\ncolor: #000000;\r\n}\r\n\r\ndiv.MSCselected\r\n{\r\nbackground-color: #71ae39;\r\n}\r\n\r\ndiv.custom_multi_select\r\n{\r\n    border: 1px solid #BBBBBB;\r\n    padding: 5px;\r\n    overflow: auto;\r\n    cursor: default;\r\n}\r\n\r\ndiv.custom_multi_select_edit\r\n{\r\n    border: 1px solid #BBBBBB;\r\n    background: #FFFFFF;\r\n    padding: 5px;\r\n    overflow: auto;\r\n    cursor: default;\r\n}\r\n\r\nspan.search_match\r\n{\r\n   background-color: #eeff00;\r\n   \r\n}\r\n\r\ndiv.filter_field input\r\n{\r\n   border-width: 0px;\r\n   color: #343434;\r\n   position: relative;\r\n   left: 2px;\r\n   top: 1px;\r\n   width: 100px;\r\n   font-size: 11px;\r\n}\r\n\r\ntable.filter_field_container\r\n{\r\n   float: left;\r\n}\r\n\r\ndiv.filter_field\r\n{\r\n   border: 1px solid #BBBBBB;\r\n   background-color: #FFFFFF;\r\n   height: 20px;\r\n   padding-right: 2px;\r\n}\r\n\r\ndiv.filter_field img\r\n{\r\n   position: relative;\r\n   top: 3px;\r\n}\r\n\r\ndiv.filter_field img[name=\"imgClearFilterIcon\"]\r\n{\r\n   visibility: hidden;\r\n   cursor: pointer;\r\n}\r\n\r\ndiv.filter_field img[name=\"imgMagnifyingGlass\"]\r\n{\r\n   left: 3px;\r\n}\r\n\r\n/******************************************************************************/\r\n/* ------------------------------  ROUTING.CS --------------------------------*/\r\n\r\ntr.header2\r\n{\r\n   background-color: #71ae39;\r\n   text-align: center;\r\n   text-transform: none;\r\n}\r\n\r\ntd.header2\r\n{\r\n   font-weight: bold;\r\n   font-size: 10px;\r\n   letter-spacing: 0.10em;\r\n   padding: 7px;\r\n   color: #1b3704;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* --------------------------  ROUTING_STATUS.CS -----------------------------*/\r\n\r\ntable.routing_statistics\r\n{\r\n   width: 500px;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* -----------------------  ROUTING_STATUS_ENTRY.CS --------------------------*/\r\n\r\ntd.status_title\r\n{\r\n   font-weight: bold;\r\n   text-align: center;\r\n}\r\n\r\ntextarea.status_message\r\n{\r\n   width: 650px;\r\n   height: 100px;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* --------------------------  VIEW_LOG_ENTRY.CS -----------------------------*/\r\n\r\ntd.error_message\r\n{\r\n   background-color: #88bbff;\r\n   text-align: left;\r\n}\r\n\r\ntextarea.error_message\r\n{\r\n   background-color: #B5C3D2;\r\n   width: 650px;\r\n   height: 200px;\r\n}\r\n\r\ntextarea.trace_message\r\n{\r\n   background-color: #EDF0F4;\r\n   width: 650px;\r\n   height: 200px;\r\n}\r\n\r\n/******************************************************************************/\r\n/* --------------------------  STARTUP.CS -----------------------------*/\r\n\r\n#startup_status_panel\r\n{\r\n   height: 300px;\r\n   width: 720px;\r\n   overflow: auto;\r\n   border-width: 1px;\r\n   text-align: left;\r\n   border: 1px solid #757671;\r\n   background-color:  #eeefea;\r\n   white-space: nowrap;\r\n   word-wrap: break-word;\r\n}\r\n\r\n/******************************************************************************/\r\n/* ---------------------  PLUGIN_EXECUTABLE_OUTPUT.CS ------------------------*/\r\n\r\n#plugin_executable_output_panel\r\n{\r\n   font-family: monospace;\r\n   overflow: auto;\r\n   border-width: 1px;\r\n   text-align: left;\r\n   border: 1px solid #757671;\r\n   background-color:  #eeefea;\r\n   white-space: nowrap;\r\n   word-wrap: break-word;\r\n}\r\n\r\n/******************************************************************************/\r\n/* ---------------------------- Modal Windows --------------------------------*/\r\ndiv.modalPopupWindow {\r\n      position: absolute;\r\n      background-color: #f9fdcb;\r\n      border-top: 2px solid #d5a95d;\r\n      border-left: 2px solid #d5a95d;\r\n      border-bottom: 2px solid #936d27;\r\n      border-right: 2px solid #936d27;\r\n      padding: 12px;\r\n      text-align: left;\r\n      z-index: 1;\r\n   }\r\n   \r\ndiv.modalPopupWindow h3 {\r\n   color: #c46a00;\r\n   font-size: 11px;\r\n   font-weight: bold;\r\n   text-transform: uppercase;\r\n   margin-top: 0px;\r\n   margin-bottom: 2px;\r\n   }\r\n   \r\ntd.modalIcon\r\n   {\r\n      padding-top: 8px;\r\n      vertical-align: top;\r\n   }\r\n   \r\n.modalText\r\n   {\r\n      font-size: 11px;\r\n      font-weight: bold;\r\n      color: #78560f;\r\n      text-align: left;\r\n      line-height: 16px;\r\n      margin-bottom: -10px;\r\n   }\r\n\r\n/*\r\n   .modalLink\r\n   {\r\n      font-size: 9pt;\r\n      font-family: Arial;\r\n      color: #0000FF;\r\n      text-align: left;\r\n   }\r\n*/\r\n\r\n\r\n/******************************************************************************/\r\n/* -----------------------------  VIEW_LOG.CS --------------------------------*/\r\n\r\ntr.resubmitted\r\n{\r\n   background-color: #999999;\r\n   color: #ffffff;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n/******************************************************************************/\r\n/* ----------------------------  MISCELLANEOUS -------------------------------*/\r\n\r\n/* This seems to be used anywhere a channel name column is found in a table */\r\ntd.channel_name\r\n{\r\n   font-weight: bold;\r\n   text-align: left;\r\n}\r\n\r\n/* Style for Error Count on Dashboard and Channel Info */\r\n.error\r\n{\r\n   color: #FF0000;      /* RED colour */\r\n   font-weight: bold;\r\n}\r\n\r\ntd.routing_status_title\r\n{\r\n   background-color: #9BACBE;\r\n   font-weight: bold;\r\n   text-align: center;\r\n}\r\n\r\ntextarea.message\r\n{\r\n   width: 650px;\r\n   height: 200px;\r\n}\r\n\r\ntr.sub_header\r\n{\r\n   background-color: #b0b0b0;\r\n   font-weight: bold;\r\n}\r\n\r\ntd.sub_header\r\n{\r\n   background-color: #b0b0b0;\r\n   font-weight: bold;\r\n}\r\n\r\ndiv.fileinput {\r\n   position: relative;\r\n}\r\n\r\ndiv.fakefile {\r\n   position: absolute;\r\n   top: 0px;\r\n   left: 0px;\r\n   z-index: 2;\r\n}\r\n\r\ninput.file_hidden {\r\n   /* used to specify \"width: 400px\" here  but \r\n      now the width of these text inputs are\r\n      set in the TSL (\"size=63\") so that we can specify\r\n      them in characters (not pixels or percentages).\r\n      This is so even when the text size is changed on\r\n      a webpage (e.g., in Firefox), this text input\r\n      element continues to cover the file input element.\r\n   */\r\n   padding-top: 2px;\r\n   padding-bottom: 2px;\r\n}\r\n\r\n\r\n/****** For mini-login.cs ******/\r\n\r\ndiv#login-popup td#login-message {\r\n   font-size: small;\r\n   font-weight: bold;\r\n}\r\n\r\n\