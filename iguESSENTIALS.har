          "content": {
            "size": 105079,
            "mimeType": "text/html",
            "compression": 88757,
            "text": "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.01//EN\"\n\"http://www.w3.org/TR/html4/strict.dtd\">\n\r\n<html>  \r\n<head>\r\n\r\n   <title>Iguana &gt; Logs</title>\r\n   <!-- IE 8 and later: enforce using the latest engine -->\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\" />\n\r\n   <script type=\"text/javascript\"><!--\r\n   UniqueInstanceId = '931D8711E361D15E2E43CB851D72A4F5';\r\n   --></script>\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"/iguana.css?ver_hash=571F6291\" />\n\n\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"log.css?ver_hash=571F6291\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"jquery-ui-1-8-16/css/ui-lightness/jquery-ui-1.8.16.custom.css\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"jquery.treeview.css?ver_hash=571F6291\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"/js/treeview/treeview.css?ver_hash=571F6291\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"/js/mapper/node_treeview.css?ver_hash=571F6291\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"/js/mapper/node_types.css?ver_hash=571F6291\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"/js/help_popup/help_popup.css?ver_hash=571F6291\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"syntax_highlight.css?ver_hash=571F6291\" />\r\n   <!-- Do not add JavaScript files here; add them to jsz/makefile instead. -->\r\n   <script type=\"text/javascript\" src=\"/js/jquery142/jquery-1.4.2.min.js\"></script>\n <script type=\"text/javascript\" src=\"/js/jquery-ui-1-8-16/js/jquery-ui-1.8.16.custom.min.js\"></script> \n<script type=\"text/javascript\" src=\"/browser.js\"></script>\n\n\r\n<script type=\"text/javascript\">\r\n<!--\r\n$(document).ready(function() {\r\n   MiniLogin.init('admin',\r\n                  'password');\r\n});\r\n\r\n\n\n//\n// General Stuff\n//\n\n// Paths to icons that may need to be switched using javascript\nvar MsgFailureAckIconSrc = 'images/msg-failure-ack.gif?ver_hash=571F6291';\nvar MsgFailureIconSrc    = 'images/msg-failure.gif?ver_hash=571F6291';\n\nvar ResubmitIconGreySrc  = 'images/log-browser-resubmit-grey.gif?ver_hash=571F6291';\n\nvar ResubmitIconSrc      = 'images/log-browser-resubmit.gif?ver_hash=571F6291' ;\n\n\nvar LOGCScurrentUserCanAdmin = true;\nvar LOGCStypeFilter = '';\nvar LOGCSstandardHl7LibraryVmdPath = 'C:\\\\Program Files\\\\iNTERFACEWARE\\\\Iguana\\\\Libraries\\\\HL7_2.7.vmd';\nvar LOGCShelpIconLocation = '/images/help_icon.gif?ver_hash=571F6291';\nvar LOGCScalendarIconLocation = '/images/calendar.gif?ver_hash=571F6291';\nvar LOGCSallEntriesOption = '';\nvar LOGCSserviceEntriesOption = ' Iguana';\n\nvar LOGCSiguanaUsagePercentage = 61;\nvar LOGCSotherUsagePercentage  = 4;\n\n\n   function canEditChannel(ChannelName) { return true; }\n\n\n//\n// View Switching\n//\n\nfunction LOGCSdropdownButtonImgSrc(Mode, Pressed)\n{\n   if (Mode == 'Text')\n   {\n      return Pressed ? 'images/log_views/dropdown-text-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-text.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'Hex')\n   {\n      return Pressed ? 'images/log_views/dropdown-hex-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-hex.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'SegmentMessage')\n   {\n      return Pressed ? 'images/log_views/dropdown-segment-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-segment.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'SegmentGrammar')\n   {\n      return Pressed ? 'images/log_views/dropdown-grammar-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-grammar.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'Table')\n   {\n      return Pressed ? 'images/log_views/dropdown-table-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-table.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'TableText')\n   {\n      return Pressed ? 'images/log_views/dropdown-tableText-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-tableText.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'SQL')\n   {\n      return Pressed ? 'images/log_views/dropdown-sql-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-sql.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'PluginOutput')\n   {\n      return Pressed ? 'images/log_views/dropdown-plugin-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-plugin.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'MapperOutput')\n   {\n      return Pressed ? 'images/log_views/dropdown-translator-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-translator.gif?ver_hash=571F6291';\n   }\n}\n\nfunction LOGCSdropdownOptionImgSrc(Option, Pressed, Disabled)\n{\n   if (Option.hasClass('Text'))\n   {\n      return Disabled ? 'images/log_views/square-text-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-text-on.gif?ver_hash=571F6291' : 'images/log_views/square-text.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('Hex'))\n   {\n      return Disabled ? 'images/log_views/square-hex-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-hex-on.gif?ver_hash=571F6291' : 'images/log_views/square-hex.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('SegmentMessage'))\n   {\n      return Disabled ? 'images/log_views/square-segment-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-segment-on.gif?ver_hash=571F6291' : 'images/log_views/square-segment.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('SegmentGrammar'))\n   {\n      return Disabled ? 'images/log_views/square-grammar-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-grammar-on.gif?ver_hash=571F6291' : 'images/log_views/square-grammar.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('Table'))\n   {\n      return Disabled ? 'images/log_views/square-table-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-table-on.gif?ver_hash=571F6291' : 'images/log_views/square-table.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('TableText'))\n   {\n      return Disabled ? 'images/log_views/square-tableText-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-tableText-on.gif?ver_hash=571F6291' : 'images/log_views/square-tableText.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('SQL'))\n   {\n      return Disabled ? 'images/log_views/square-sql-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-sql-on.gif?ver_hash=571F6291' : 'images/log_views/square-sql.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('PluginOutput'))\n   {\n      return Disabled ? 'images/log_views/square-plugin-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-plugin-on.gif?ver_hash=571F6291' : 'images/log_views/square-plugin.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('MapperOutput'))\n   {\n      return Disabled ? 'images/log_views/square-translator-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-translator-on.gif?ver_hash=571F6291' : 'images/log_views/square-translator.gif?ver_hash=571F6291');\n   }\n}\n\nfunction LOGCSshowMarkButton()\n{\n   ButtonElement = document.getElementById('entryMarked');\n   ImageElement = document.getElementById('entryMarkedImg');\n   \n   if (ButtonElement)\n   {\n      ButtonElement.style.display = (CurrentEntry.Type == 'Error' ? '' : 'none');\n   }\n   \n   if (ImageElement)\n   {\n      if (CurrentEntry.Acknowledged)\n      {\n         if (CurrentEntry.Deleted)\n         { \n            ImageElement.src = 'images/log-browser-ack-yes-grey.gif?ver_hash=571F6291';\n         }\n         else\n         {\n            ImageElement.src = 'images/log-browser-ack-yes.gif?ver_hash=571F6291';\n         }\n      }\n      else\n      {\n         if (CurrentEntry.Deleted)\n         { \n            ImageElement.src = 'images/log-browser-ack-no-grey.gif?ver_hash=571F6291';\n         }\n         else\n         {\n            ImageElement.src = 'images/log-browser-ack-no.gif?ver_hash=571F6291';\n         }\n      }\n   }\n\n}\n\n\n\n\n\n\nfunction LOGCSgetAvailableResubmitDialogHeight(IncludeEditDiv, IncludePreviewDiv)\n{\n   var AvailableHeight = $('#resubmitDialog').innerHeight() - 10\n                         - $('#resubmitTopControls').outerHeight()\n                         - $('#resubmitEditControls').outerHeight()\n                         - $('#resubmitPreviewControls').outerHeight()\n                         - $('#resubmitComplete').outerHeight();\n   \n   var AvailableHeightDivisor = 0;\n   if (IncludeEditDiv)\n   {\n      AvailableHeightDivisor++;\n      AvailableHeight -= 22; // resubmitEdit's top and bottom margin and border widths\n   }\n   if (IncludePreviewDiv)\n   {\n      AvailableHeightDivisor++;\n      AvailableHeight -= 12; // resubmitPreview's top and bottom margin and border widths\n   }\n   // Make sure we don't divide by 0.\n   AvailableHeightDivisor = (AvailableHeightDivisor ? AvailableHeightDivisor : 1);\n   \n   return Math.floor(AvailableHeight/AvailableHeightDivisor);\n}\n\nfunction LOGCSresizeResubmitDialog()\n{\n   var Page = document.documentElement;\n   var Frame = document.getElementById('resubmitFrame');\n   var ResubmitDialog = document.getElementById('resubmitDialog');\n   \n   Frame.style.display = 'none';\n   Frame.style.height = Math.max(Page.scrollHeight, WINgetWindowHeight()) + 'px';\n   Frame.style.width  = Page.scrollWidth  + 'px';\n   Frame.style.display = '';\n   \n   if( Frame.contentWindow )  // IE6 doesn't use iframe background colors.\n   {\n      Frame.contentWindow.document.body.style.background = 'gray';\n   }\n   \n   show('resubmitDialog');\n   \n   ResubmitDialog.style.height = (WINgetWindowHeight()\n                                 - (2*36)\n                                 - (2*5 + 10)) + 'px';\n   ResubmitDialog.style.width  = (WINgetWindowWidth()\n                                 - (2*36)\n                                 - (2*5))  + 'px';\n   \n   var ResubmitEdit = $('#messageEditor');\n   var ResubmitPreview = $('#resubmitPreview');\n   \n   var AvailableHeight = LOGCSgetAvailableResubmitDialogHeight(visible('resubmitEdit'), visible('resubmitPreview'));\n   \n   var AvailableWidth  = $(ResubmitDialog).innerWidth();\n   \n   // 6 or 2 == element's padding and border width for left and right\n   ResubmitEdit.css(   'height', AvailableHeight + 'px');\n   ResubmitEdit.css(   'width',  (AvailableWidth - (2*16 + 6)) + 'px');\n   ResubmitPreview.css('height', AvailableHeight + 'px');\n   ResubmitPreview.css('width',  (AvailableWidth - (2*16 + 2)) + 'px');\n   \n   resizeInnerViewContents();\n}\n\nfunction LOGCSinitParsersBySource()\n{\n   return {\n             \n             undefined: ['pop me'] \n          };\n}\n\nfunction LOGCSinitIsToPluginBySource()\n{\n   return {\n             \n                'Channel Manager' : 0,\n             \n                'CL - FW Outbound' : 0,\n             \n                'CLT - FW Outbound' : 0,\n             \n                'DEN - FW Outbound' : 0,\n             \n                'DFW - FW Outbound' : 0,\n             \n                'DONOTSTART ErrChnl Restore Msg' : 0,\n             \n                'DONOTSTART: Error Channel' : 0,\n             \n                'DTW - FW Outbound' : 0,\n             \n                'FailOver' : 0,\n             \n                'IAH - FW Outbound' : 0,\n             \n                'Iguana Monitor' : 0,\n             \n                'MD - FW Outbound' : 0,\n             \n                'MessageBroker' : 0,\n             \n                'OH - FW Outbound' : 0,\n             \n                'OKC - FW Outbound' : 0,\n             \n                'Paxit: CLT - FW Outbound' : 0,\n             \n                'Paxit: CLV - FW Outbound' : 0,\n             \n                'Paxit: CLV to Clev' : 0,\n             \n                'Paxit: DTW - FW Outbound' : 0,\n             \n                'Paxit: IAH - FW Outbound' : 0,\n             \n                'Paxit: OH - FW Outbound' : 0,\n             \n                'Paxit: OKC - FW Outbound' : 0,\n             \n                'Paxit: To DTW' : 0,\n             \n                'Paxit: To IAH' : 0,\n             \n                'Paxit: To OH' : 0,\n             \n                'Paxit: To OKC' : 0,\n             \n                'Paxit: To VA' : 0,\n             \n                'Paxit: VA - FW Outbound' : 0,\n             \n                'Paxit: YBR - FW Outbound' : 0,\n             \n                'Paxit: YBR to MD' : 0,\n             \n                'Procare - FW Outbound' : 0,\n             \n                'Procare Medsure' : 0,\n             \n                'Prod-MyRemediEoe' : 0,\n             \n                'Ric - FW Outbound' : 0,\n             \n                'To CL' : 0,\n             \n                'To CLT' : 0,\n             \n                'To DEN' : 0,\n             \n                'To DFW' : 0,\n             \n                'To DTW' : 0,\n             \n                'To IAH' : 0,\n             \n                'To MD' : 0,\n             \n                'To NCPDP Interface' : 0,\n             \n                'To OH' : 0,\n             \n                'To OKC' : 0,\n             \n                'To Ric' : 0,\n             \n             undefined : undefined\n          };\n}\n\nfunction LOGCSinitIsToMapperBySource()\n{\n   return {\n             \n                'Channel Manager' : 0,\n             \n                'CL - FW Outbound' : 1,\n             \n                'CLT - FW Outbound' : 1,\n             \n                'DEN - FW Outbound' : 1,\n             \n                'DFW - FW Outbound' : 1,\n             \n                'DONOTSTART ErrChnl Restore Msg' : 0,\n             \n                'DONOTSTART: Error Channel' : 1,\n             \n                'DTW - FW Outbound' : 1,\n             \n                'FailOver' : 0,\n             \n                'IAH - FW Outbound' : 1,\n             \n                'Iguana Monitor' : 0,\n             \n                'MD - FW Outbound' : 1,\n             \n                'MessageBroker' : 0,\n             \n                'OH - FW Outbound' : 1,\n             \n                'OKC - FW Outbound' : 1,\n             \n                'Paxit: CLT - FW Outbound' : 1,\n             \n                'Paxit: CLV - FW Outbound' : 1,\n             \n                'Paxit: CLV to Clev' : 1,\n             \n                'Paxit: DTW - FW Outbound' : 1,\n             \n                'Paxit: IAH - FW Outbound' : 1,\n             \n                'Paxit: OH - FW Outbound' : 1,\n             \n                'Paxit: OKC - FW Outbound' : 1,\n             \n                'Paxit: To DTW' : 1,\n             \n                'Paxit: To IAH' : 1,\n             \n                'Paxit: To OH' : 1,\n             \n                'Paxit: To OKC' : 1,\n             \n                'Paxit: To VA' : 1,\n             \n                'Paxit: VA - FW Outbound' : 1,\n             \n                'Paxit: YBR - FW Outbound' : 1,\n             \n                'Paxit: YBR to MD' : 1,\n             \n                'Procare - FW Outbound' : 1,\n             \n                'Procare Medsure' : 1,\n             \n                'Prod-MyRemediEoe' : 0,\n             \n                'Ric - FW Outbound' : 1,\n             \n                'To CL' : 0,\n             \n                'To CLT' : 0,\n             \n                'To DEN' : 0,\n             \n                'To DFW' : 0,\n             \n                'To DTW' : 0,\n             \n                'To IAH' : 0,\n             \n                'To MD' : 0,\n             \n                'To NCPDP Interface' : 1,\n             \n                'To OH' : 0,\n             \n                'To OKC' : 0,\n             \n                'To Ric' : 0,\n             \n             undefined : undefined\n          };\n}\n\n\n//\n// Iteration\n//\n\n\n\nvar Iterator = function()\n{\n   var CurrentIndex = 0;\n   function findCurrentIndex()\n   {\n      if( CurrentIndex >= LogEntries.length )\n      {\n         CurrentIndex = Math.floor(LogEntries.length / 2);\n      }\n\n      if( LogEntries[CurrentIndex].MessageId == CurrentEntry.MessageId )\n      {\n         return true;\n      }\n\n      var CurrentDate = new Date(CurrentEntry.Date);\n      var IndexDate   = new Date(LogEntries[CurrentIndex].Date);\n\n      var Delta = +1;  // Search backward in time.\n\n      if( IndexDate < CurrentDate || !(IndexDate > CurrentDate) &&\n          1*LogEntries[CurrentIndex].Position < 1*CurrentEntry.Position )\n      {\n         Delta = -1;  // Search forward in time.\n      }\n\n      var Index = CurrentIndex + Delta;\n      while( Index >= 0 && Index < LogEntries.length )\n      {\n         if( LogEntries[Index].MessageId == CurrentEntry.MessageId )\n         {\n            CurrentIndex = Index;\n            return true;\n         }\n\n         Index += Delta;\n      }\n\n      return false;\n   }\n\n   function showTooltip(Tip)\n   {\n      return function() {\n         TOOLtooltipLink(Tip, undefined, this, { Left: -8 });\n\n         this.onmouseout = function() {\n            TOOLtooltipClose();\n         }\n      }\n   }\n\n   function apply(List, Action)\n   {\n      for(var Index in List)\n      {\n         Action(List[Index]);\n      }\n   }\n\n   var Next = {\n      Action: moveNext,\n      Tip:    'Display next matching entry.',\n      NormalImage:   'images/msg-next.gif?ver_hash=571F6291',\n      HoverImage:    'images/msg-next-hover.gif?ver_hash=571F6291',\n      PressedImage:  'images/msg-next-active.gif?ver_hash=571F6291',\n      DisabledImage: 'images/msg-next-disabled.gif?ver_hash=571F6291'\n   };\n\n   var Prev = {\n      Action: movePrev,\n      Tip:    'Display previous matching entry.',\n      NormalImage:   'images/msg-prev.gif?ver_hash=571F6291',\n      HoverImage:    'images/msg-prev-hover.gif?ver_hash=571F6291',\n      PressedImage:  'images/msg-prev-active.gif?ver_hash=571F6291',\n      DisabledImage: 'images/msg-prev-disabled.gif?ver_hash=571F6291'\n   };\n\n   function enableButton(Button, Details)\n   {\n      Button.src     = Details.NormalImage;\n      Button.onclick = Details.Action;\n\n      Button.onmouseover = function() {\n         this.src = Details.HoverImage;\n         TOOLtooltipLink(Details.Tip, undefined, this, { Left: -12 });\n      };\n      Button.onmouseout = function() {\n         this.src = Details.NormalImage;\n         TOOLtooltipClose();\n      };\n      Button.onmousedown = function() {\n         this.src = Details.PressedImage;\n      };\n      Button.onmouseup = function() {\n         this.src = Details.HoverImage;\n      };\n   }\n\n   function disableButton(Button, Details)\n   {\n      Button.src     = Details.DisabledImage;\n      Button.onclick = null;\n\n      Button.onmouseover = function() {\n         TOOLtooltipLink(Details.Tip, undefined, this, { Left: -12 });\n      };\n      Button.onmouseout = function() {\n         TOOLtooltipClose();\n      };\n      Button.onmousedown = null;\n      Button.onmouseup   = null;\n   }\n\n   var NextButtons;\n   var EnabledNext;\n   function enableNext()\n   {\n      if( !EnabledNext )\n      {\n         EnabledNext = true;\n         enableButton(document.getElementById('entryNext'), Next);\n      }\n   }\n\n   var PrevButtons;\n   var EnabledPrev;\n   function enablePrev()\n   {\n      if( !EnabledPrev )\n      {\n         EnabledPrev = true;\n         enableButton(document.getElementById('entryPrev'), Prev);\n      }\n   }\n\n   function disableNext()\n   {\n      if( EnabledNext )\n      {\n         EnabledNext = false;\n         disableButton(document.getElementById('entryNext'), Next);\n      }\n   }\n\n   function disablePrev()\n   {\n      if( EnabledPrev )\n      {\n         EnabledPrev = false;\n         disableButton(document.getElementById('entryPrev'), Prev);\n      }\n   }\n\n   function moveNext()\n   {\n      var MoveOk = true;\n      if( !findCurrentIndex() )\n      {\n         disableNext();\n         disablePrev();\n         MoveOk = false;\n      }\n      else\n      {\n         if( CurrentIndex > 0 )\n         {\n            showEntry( LogEntries[--CurrentIndex], 'next' );\n            enablePrev();\n         }\n\n         if( CurrentIndex <= 0 && Finished['forward'] )\n         {\n            disableNext();\n            MoveOk = false;\n         }\n         else if( CurrentIndex < 5 )\n         {\n            showMore('forward');\n         }\n      }\n      return MoveOk;\n   }\n\n   function movePrev()\n   {\n      var MoveOk = true;\n      if( !findCurrentIndex() )\n      {\n         disableNext();\n         disablePrev();\n         MoveOk = false;\n      }\n      else\n      {\n         if( CurrentIndex < LogEntries.length - 1 )\n         {\n            showEntry( LogEntries[++CurrentIndex], 'previous' );\n            enableNext();\n         }\n\n         if( CurrentIndex >= LogEntries.length - 1 && Finished['reverse'] )\n         {\n            disablePrev();\n            MoveOk = false;\n         }\n         else if( LogEntries.length - CurrentIndex <= 5 )\n         {\n            showMore('reverse');\n         }\n      }\n      return MoveOk;\n   }\n\n   var Enabled;\n   function updateButtons()\n   {\n      if( Enabled && CurrentEntry && findCurrentIndex() )\n      {\n         var EnableNext = CurrentIndex > 0                     || !Finished[\"forward\"];\n         var EnablePrev = CurrentIndex < LogEntries.length - 1 || !Finished[\"reverse\"];\n\n         if( EnableNext ) enableNext(); else disableNext();\n         if( EnablePrev ) enablePrev(); else disablePrev();\n      }\n   }\n\n   return {\n      enable: function() {\n         enableNext();\n         enablePrev();\n         Enabled = true;\n         updateButtons();\n      },\n      disable: function() {\n         disableNext();\n         disablePrev();\n         Enabled = false;\n      },\n      update: updateButtons,\n      next: moveNext,\n      prev: movePrev\n   };\n}();\n\n\n\n\n//\n// Side-bar Goodies\n//\n\nvar LOGCSinitialDequeueSourceNames = '';\nvar LOGCSinitialIncludeSourceLogs = '' == 'true';\nvar LOGCSinitialJumpToQueueEnd = '' == 'true';\n\nvar LOGCSchannelSources  = new Array();\n\n   LOGCSchannelSources['Channel Manager'] = [\n   'bogus'];\n   LOGCSchannelSources['Channel Manager'].pop();\n\n   LOGCSchannelSources['CL - FW Outbound'] = [\n   'CL - FW Outbound','bogus'];\n   LOGCSchannelSources['CL - FW Outbound'].pop();\n\n   LOGCSchannelSources['CLT - FW Outbound'] = [\n   'CLT - FW Outbound','bogus'];\n   LOGCSchannelSources['CLT - FW Outbound'].pop();\n\n   LOGCSchannelSources['DEN - FW Outbound'] = [\n   'DEN - FW Outbound','bogus'];\n   LOGCSchannelSources['DEN - FW Outbound'].pop();\n\n   LOGCSchannelSources['DFW - FW Outbound'] = [\n   'DFW - FW Outbound','bogus'];\n   LOGCSchannelSources['DFW - FW Outbound'].pop();\n\n   LOGCSchannelSources['DONOTSTART ErrChnl Restore Msg'] = [\n   'DONOTSTART ErrChnl Restore Msg','bogus'];\n   LOGCSchannelSources['DONOTSTART ErrChnl Restore Msg'].pop();\n\n   LOGCSchannelSources['DONOTSTART: Error Channel'] = [\n   'DONOTSTART: Error Channel','bogus'];\n   LOGCSchannelSources['DONOTSTART: Error Channel'].pop();\n\n   LOGCSchannelSources['DTW - FW Outbound'] = [\n   'DTW - FW Outbound','bogus'];\n   LOGCSchannelSources['DTW - FW Outbound'].pop();\n\n   LOGCSchannelSources['FailOver'] = [\n   'FailOver','bogus'];\n   LOGCSchannelSources['FailOver'].pop();\n\n   LOGCSchannelSources['IAH - FW Outbound'] = [\n   'IAH - FW Outbound','bogus'];\n   LOGCSchannelSources['IAH - FW Outbound'].pop();\n\n   LOGCSchannelSources['Iguana Monitor'] = [\n   'bogus'];\n   LOGCSchannelSources['Iguana Monitor'].pop();\n\n   LOGCSchannelSources['MD - FW Outbound'] = [\n   'MD - FW Outbound','bogus'];\n   LOGCSchannelSources['MD - FW Outbound'].pop();\n\n   LOGCSchannelSources['MessageBroker'] = [\n   'bogus'];\n   LOGCSchannelSources['MessageBroker'].pop();\n\n   LOGCSchannelSources['OH - FW Outbound'] = [\n   'OH - FW Outbound','bogus'];\n   LOGCSchannelSources['OH - FW Outbound'].pop();\n\n   LOGCSchannelSources['OKC - FW Outbound'] = [\n   'OKC - FW Outbound','bogus'];\n   LOGCSchannelSources['OKC - FW Outbound'].pop();\n\n   LOGCSchannelSources['Paxit: CLT - FW Outbound'] = [\n   'Paxit: CLT - FW Outbound','bogus'];\n   LOGCSchannelSources['Paxit: CLT - FW Outbound'].pop();\n\n   LOGCSchannelSources['Paxit: CLV - FW Outbound'] = [\n   'Paxit: CLV - FW Outbound','bogus'];\n   LOGCSchannelSources['Paxit: CLV - FW Outbound'].pop();\n\n   LOGCSchannelSources['Paxit: CLV to Clev'] = [\n   'Paxit: CLV to Clev','bogus'];\n   LOGCSchannelSources['Paxit: CLV to Clev'].pop();\n\n   LOGCSchannelSources['Paxit: DTW - FW Outbound'] = [\n   'Paxit: DTW - FW Outbound','bogus'];\n   LOGCSchannelSources['Paxit: DTW - FW Outbound'].pop();\n\n   LOGCSchannelSources['Paxit: IAH - FW Outbound'] = [\n   'Paxit: IAH - FW Outbound','bogus'];\n   LOGCSchannelSources['Paxit: IAH - FW Outbound'].pop();\n\n   LOGCSchannelSources['Paxit: OH - FW Outbound'] = [\n   'Paxit: OH - FW Outbound','bogus'];\n   LOGCSchannelSources['Paxit: OH - FW Outbound'].pop();\n\n   LOGCSchannelSources['Paxit: OKC - FW Outbound'] = [\n   'Paxit: OKC - FW Outbound','bogus'];\n   LOGCSchannelSources['Paxit: OKC - FW Outbound'].pop();\n\n   LOGCSchannelSources['Paxit: To DTW'] = [\n   'Paxit: To DTW','bogus'];\n   LOGCSchannelSources['Paxit: To DTW'].pop();\n\n   LOGCSchannelSources['Paxit: To IAH'] = [\n   'Paxit: To IAH','bogus'];\n   LOGCSchannelSources['Paxit: To IAH'].pop();\n\n   LOGCSchannelSources['Paxit: To OH'] = [\n   'Paxit: To OH','bogus'];\n   LOGCSchannelSources['Paxit: To OH'].pop();\n\n   LOGCSchannelSources['Paxit: To OKC'] = [\n   'Paxit: To OKC','bogus'];\n   LOGCSchannelSources['Paxit: To OKC'].pop();\n\n   LOGCSchannelSources['Paxit: To VA'] = [\n   'Paxit: To VA','bogus'];\n   LOGCSchannelSources['Paxit: To VA'].pop();\n\n   LOGCSchannelSources['Paxit: VA - FW Outbound'] = [\n   'Paxit: VA - FW Outbound','bogus'];\n   LOGCSchannelSources['Paxit: VA - FW Outbound'].pop();\n\n   LOGCSchannelSources['Paxit: YBR - FW Outbound'] = [\n   'Paxit: YBR - FW Outbound','bogus'];\n   LOGCSchannelSources['Paxit: YBR - FW Outbound'].pop();\n\n   LOGCSchannelSources['Paxit: YBR to MD'] = [\n   'Paxit: YBR to MD','bogus'];\n   LOGCSchannelSources['Paxit: YBR to MD'].pop();\n\n   LOGCSchannelSources['Procare - FW Outbound'] = [\n   'Procare - FW Outbound','bogus'];\n   LOGCSchannelSources['Procare - FW Outbound'].pop();\n\n   LOGCSchannelSources['Procare Medsure'] = [\n   'Procare Medsure','bogus'];\n   LOGCSchannelSources['Procare Medsure'].pop();\n\n   LOGCSchannelSources['Prod-MyRemediEoe'] = [\n   'bogus'];\n   LOGCSchannelSources['Prod-MyRemediEoe'].pop();\n\n   LOGCSchannelSources['Ric - FW Outbound'] = [\n   'Ric - FW Outbound','bogus'];\n   LOGCSchannelSources['Ric - FW Outbound'].pop();\n\n   LOGCSchannelSources['To CL'] = [\n   'Prod-MyRemediEoe','bogus'];\n   LOGCSchannelSources['To CL'].pop();\n\n   LOGCSchannelSources['To CLT'] = [\n   'Prod-MyRemediEoe','bogus'];\n   LOGCSchannelSources['To CLT'].pop();\n\n   LOGCSchannelSources['To DEN'] = [\n   'Prod-MyRemediEoe','bogus'];\n   LOGCSchannelSources['To DEN'].pop();\n\n   LOGCSchannelSources['To DFW'] = [\n   'Prod-MyRemediEoe','bogus'];\n   LOGCSchannelSources['To DFW'].pop();\n\n   LOGCSchannelSources['To DTW'] = [\n   'Prod-MyRemediEoe','bogus'];\n   LOGCSchannelSources['To DTW'].pop();\n\n   LOGCSchannelSources['To IAH'] = [\n   'Prod-MyRemediEoe','bogus'];\n   LOGCSchannelSources['To IAH'].pop();\n\n   LOGCSchannelSources['To MD'] = [\n   'Prod-MyRemediEoe','bogus'];\n   LOGCSchannelSources['To MD'].pop();\n\n   LOGCSchannelSources['To NCPDP Interface'] = [\n   'Prod-MyRemediEoe','bogus'];\n   LOGCSchannelSources['To NCPDP Interface'].pop();\n\n   LOGCSchannelSources['To OH'] = [\n   'Prod-MyRemediEoe','bogus'];\n   LOGCSchannelSources['To OH'].pop();\n\n   LOGCSchannelSources['To OKC'] = [\n   'Prod-MyRemediEoe','bogus'];\n   LOGCSchannelSources['To OKC'].pop();\n\n   LOGCSchannelSources['To Ric'] = [\n   'Prod-MyRemediEoe','bogus'];\n   LOGCSchannelSources['To Ric'].pop();\n\n\nvar LOGCSchannelInfo = new Array();\n\n   LOGCSchannelInfo['Channel Manager'] = \n   { \n      SourceType: 'From HTTPS',\n      DestType: 'To Channel',\n      HasFilter: false,\n      FilterAfterLogging: false,\n      CountOfViewableDequeue: 0,\n      CountOfDequeue: 0\n   }\n\n   LOGCSchannelInfo['CL - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['CLT - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['DEN - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['DFW - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['DONOTSTART ErrChnl Restore Msg'] = \n   { \n      SourceType: 'From File',\n      DestType: 'LLP Client',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['DONOTSTART: Error Channel'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['DTW - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['FailOver'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To File',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['IAH - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Iguana Monitor'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Channel',\n      HasFilter: false,\n      FilterAfterLogging: false,\n      CountOfViewableDequeue: 0,\n      CountOfDequeue: 0\n   }\n\n   LOGCSchannelInfo['MD - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['MessageBroker'] = \n   { \n      SourceType: 'From HTTPS',\n      DestType: 'To Channel',\n      HasFilter: false,\n      FilterAfterLogging: false,\n      CountOfViewableDequeue: 0,\n      CountOfDequeue: 0\n   }\n\n   LOGCSchannelInfo['OH - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['OKC - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: CLT - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: CLV - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: CLV to Clev'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: DTW - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: IAH - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: OH - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: OKC - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: To DTW'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: To IAH'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: To OH'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: To OKC'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: To VA'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: VA - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: YBR - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: YBR to MD'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Procare - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Procare Medsure'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Prod-MyRemediEoe'] = \n   { \n      SourceType: 'From Database',\n      DestType: 'To Channel',\n      HasFilter: false,\n      FilterAfterLogging: false,\n      CountOfViewableDequeue: 0,\n      CountOfDequeue: 0\n   }\n\n   LOGCSchannelInfo['Ric - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To CL'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To CLT'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To DEN'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To DFW'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To DTW'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To IAH'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To MD'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To NCPDP Interface'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'To Translator',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To OH'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To OKC'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To Ric'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n\n//\n// Row pop-out stuff.\n//\n\nvar LOGCSisChildWindow        = false;\nvar LOGCSlogBrowserGuid       = '431D9796E3B518C8A3ADA6A8AFB022DD'; // valid iff LOGCSisChildWindow == false\nvar LOGCSremoteValidationKey  = 'E110304CC5F54A768E4E1D927BCAE143';\n\nvar LOGCSrowPopoutButtonImage      = 'images/pop-out.gif?ver_hash=571F6291';\nvar LOGCSrowPopoutButtonImageHover = 'images/pop-out-hover.gif?ver_hash=571F6291';\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\r\n\r\nfunction onWindowResize()\r\n{\r\n   resize(VisibleArea);\r\n   DescriptionAreaControl.resizeFrames();\r\n   if (visible('resubmitDialog'))\r\n   {\r\n      LOGCSresizeResubmitDialog();\r\n   }\r\n}\r\n\r\nvar CurrentTableArea = 'parsedTableArea';\r\nvar LogArea, LogTable;\r\nvar ResizeTimeoutId = null;\r\nfunction onLoad()\r\n{\r\n   initLogBrowser();\r\n\r\n   setSelectType(); \r\n\r\n   LogTable = document.getElementById('logTable');\r\n   LogArea  = document.getElementById('logArea');\r\n   resize(LogArea);\r\n   LogArea.onscroll = onScrollLogArea;\r\n   \r\n   window.onresize = function()\r\n   {\r\n      // Some browsers (like Firefox) don't always call the onresize event at the right time.\r\n      // So we will make sure to run the adjustments when the user's mouse stops moving.\r\n      clearTimeout(ResizeTimeoutId);\r\n      ResizeTimeoutId = setTimeout('onWindowResize();', 150);\r\n   }\r\n\r\n   var OnScrollTimeout;\r\n   window.onscroll = function() {\r\n      clearTimeout(OnScrollTimeout);\r\n      OnScrollTimeout = setTimeout(window.onresize, 150);\r\n   }\r\n\r\n   if (navigator.userAgent != null && navigator.userAgent.indexOf('Firefox') !=-1)\r\n   {\r\n      document.onkeypress = onKeyDown;\r\n   }\r\n   else\r\n   {\r\n      document.onkeydown  = onKeyDown;\r\n   }\r\n   \r\n   onSourceChange();\r\n   LOGCSinitialIncludeSourceLogs = false;\r\n   LOGCSinitialDequeueSourceNames = '';\r\n\r\n   // Keeps \"Today\" and \"Yesterday\" labels up to date.  Only call this once\r\n   // before any entries are added; it will periodically call itself.\r\n   //\r\n   updateDates();\r\n\r\n   checkLogUsageBar();\r\n\r\n   setupTimeRangeField('After' , '');\r\n   setupTimeRangeField('Before', '');\r\n   $('.ui-datepicker').draggable();\r\n   var ShowTimeRange = !(document.getElementById('AfterInput' ).value == '' &&\r\n                         document.getElementById('BeforeInput').value == '')\r\n   document.getElementById('ShowTimeRange_local').checked = ShowTimeRange;\r\n   document.getElementById('TimeRangeTable').style.display = (ShowTimeRange ? '' : 'none');\r\n\r\n   // Prep the fancy clear-buttons.\r\n   //\r\n   var ClearProps = {\r\n      'Filter' : { 'EmptyValue' : ''},\r\n      'AfterDateTime_local' : { 'EmptyValue' : InputTimeFormatText, 'OnClickClear' : ClearDateRange['After'] },\r\n      'BeforeDateTime_local' : { 'EmptyValue' : InputTimeFormatText, 'OnClickClear' : ClearDateRange['Before'] }\r\n   }\r\n   for(var FieldName in ClearProps)\r\n   {\r\n      initClearButton(FieldName, ClearProps[FieldName]);\r\n   }\r\n\r\n   \r\n      //\r\n      // This is a normal search of the log, with no particular entry to focus on.\r\n      //\r\n      setFinished('forward', true);\r\n      showMore('reverse');\r\n      \r\n   \r\n   requestDequeueInfo();\r\n   LOGdoHeartBeat();\r\n\r\n   $(\"#alert-dialog\").dialog(\r\n\t\t{\r\n\t\t\tbgiframe: true,\r\n\t\t\tautoOpen: false,\r\n         \t\twidth:350,\r\n\t\t\tmodal: true,\r\n\t\t\tbuttons:{\r\n\t\t\t\t'Close': function() {\r\n\t\t\t\t\t$(this).dialog('close');\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\r\n   var linkDialogOptions = {\r\n\t\t\tbgiframe: true,\r\n\t\t\tautoOpen: false,\r\n\t\t\theight: 200,\r\n\t\t\twidth:500,\r\n\t\t\tmodal: true,\r\n\t\t\tbuttons: {\t\t\t\t\r\n\t\t\t\t'Close': function() {\r\n\t\t\t\t\t$(this).dialog('close');\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t};\r\n\r\n   $(\"#bookmark-dialog\").dialog(linkDialogOptions);\r\n   $(\"#show-link-dialog\").dialog(linkDialogOptions);\r\n   \r\n   LogArea.focus();\r\n\r\n   LOGstartFtsUpdatePoll();\r\n}\r\n\r\nwindow.onbeforeunload = function(){\r\n   TOOLtooltipClose();\r\n}\r\n   \r\n//-->\r\n</script>\r\n\r\n</head>\r\n\r\n<body class=\"tableft\" onLoad=\"onLoad()\">\r\n\r\n\r\n<div id=\"header\" style=\"position:absolute;top:-30px;\">\n\n<script type=\"text/javascript\" src=\"/skinningwindow.js?ver_hash=571F6291\"></script>\n<script type=\"text/javascript\" src=\"/js/ajax/ajax.js?ver_hash=571F6291\"></script>\n  \n<div id=\"logo\"><img src=\"/images/iguana4_logo.gif?ver_hash=571F6291\"/></div>\n\n<div id=\"version\"><a href=\"/version_info.html\">5.6.20</a>\n\n</div>\n\n<div id=\"tabs\">\n   \n      <div id=\"tabs_left\">\n         <ul>\n            \n            \n            \n               \n                  <li><a id=Dashboard href=\"../dashboard.html\"><span>Dashboard</span></a></li>\n               \n            \n            \n               \n                  <li><a id=Logs href=\"../logs.html\" class=\"current\"><span>Logs</span></a></li>\n               \n            \n         </ul>\n      </div>       \n\n      <div id=\"tabs_right\">\n         <ul>\n            \n               \n                  <li><a id=Settings href=\"../advanced.html\"><span>Settings</span></a></li>\n               \n            \n            <!--\n               \n                  <li><a id=About href=\"../about.html\"><span>About</span></a></li>\n               \n            -->\n         </ul>\n      </div>\n      \n</div>\n\n<div id=\"login\">\n\tLogged in as <b>admin</b>. (<a href=\"/login.html\">Logout</a>)\n</div>\n\n<div id=\"help_button\">\n\t<a href=\"http://www.interfaceware.com/manual/iguana.html?v=5.6.20\" target=\"_manual\"></a>\n</div>\n\n<div id=\"change_skin\">\n\n\n</div>\n\n</div>\n<script type=\"text/javascript\">\n/*\nvar AJAXCommandName = 'is_configuration_commit_pending';\n   \nAJAXpost(AJAXCommandName, \"\", \n   function(data)\n   { \n      var Response = eval(data);\n         \n      var IsCommitPending = Response.IsCommitPending;\n            \n      if(IsCommitPending)\n      {\n         document.getElementById(\"configuration_control\").innerHTML = \"<span>Configuration Control <img border=0 src=\\\"../images/icon_error.gif\\\" /></span>\";\n      }\n      else\n      {               \n         document.getElementById(\"configuration_control\").innerHTML = \"<span>Configuration Control</span>\";\n      }    \n   },\n   \n   function(data){}\n);\n*/   \n</script> \n\r\n\r\n<div id=\"main\" style=\"margin-bottom:0\">\r\n\r\n   <table id=\"iguana\">\r\n      <tr>\r\n         <td id=\"cookie_crumb\">\r\n            <table style=\"width:100%; border-collapse:collapse\"><tr>\r\n               <td style=\"padding:0; width:100%;\">\r\n                  Logs\r\n               </td>\r\n               <td align=\"right\" style=\"width:0; padding:0 0 0 12px;\">\r\n                  <span id=\"newMessageCount\" style=\"cursor:pointer; white-space:nowrap\"\r\n                     onclick=\"showLog(); LogArea.scrollTop = 0; clearNewMessageCount();\">\r\n                  </span>\r\n               </td>\r\n               <td id=\"disableRemoteWindows\" align=\"right\" style=\"width:0; padding:0 0 0 12px; display:none;\">\r\n                  <a href=\"#\" class=\"button\"\r\n                        onmouseover=\" TOOLtooltipLink('There may be windows in other sessions viewing the same log entries as this window.<br><br>These windows can be disabled by clicking this button.', null, this);\" \r\n                        onmouseout=\"TOOLtooltipClose();\" \r\n                        onmouseup=\"TOOLtooltipClose();\"\r\n                        onclick=\"javascript:LOGdisableRemoteWindows(); this.blur(); return false;\">\r\n                     <span><img src='images/icon_disable_window.gif?ver_hash=571F6291'> &nbsp;Disable Remote Windows</span>\r\n                  </a>\r\n               </td>\r\n               <td id=\"oldestAndNewestButtons\" align=\"right\" style=\"width:0; padding:3px 0 0 12px;\">\r\n                  <div style=\"white-space:nowrap;\">\r\n                     <img class=\"nav-button\" src=\"/images/log_end.gif?ver_hash=571F6291\"\r\n                          onmouseover=\"javascript:this.src='/images/log_end_hover.gif?ver_hash=571F6291'; TOOLtooltipLink('Display the oldest entry.', undefined, this, { Left: -12 });\"\r\n                          onmouseout =\"javascript:this.src='/images/log_end.gif?ver_hash=571F6291';       TOOLtooltipClose();\"\r\n                          onmousedown=\"javascript:this.src='/images/log_end_active.gif?ver_hash=571F6291';\"\r\n                          onmouseup  =\"javascript:this.src='/images/log_end_hover.gif?ver_hash=571F6291';\"\r\n                          onclick    =\"javascript:LOGdisplayOldestEntry();\" />\r\n                     <img class=\"nav-button\" src=\"/images/log_home.gif?ver_hash=571F6291\"\r\n                          onmouseover=\"javascript:this.src='/images/log_home_hover.gif?ver_hash=571F6291'; TOOLtooltipLink('Display the newest entry.', undefined, this, { Left: -12 });\"\r\n                          onmouseout =\"javascript:this.src='/images/log_home.gif?ver_hash=571F6291';       TOOLtooltipClose();\"\r\n                          onmousedown=\"javascript:this.src='/images/log_home_active.gif?ver_hash=571F6291';\"\r\n                          onmouseup  =\"javascript:this.src='/images/log_home_hover.gif?ver_hash=571F6291';\"\r\n                          onclick    =\"javascript:LOGdisplayNewestEntry();\" />\r\n                  </div>\r\n               </td>\r\n            </tr></table>\r\n         </td>\r\n      </tr>\r\n\r\n      <tr>\r\n         <td>\r\n      \r\n         \r\n            <span id=\"panicFailure\" style=\"display:none\">\r\n         \r\n            <div class=\"error_message\" style=\"margin-bottom:5px\">\r\n               <div class=\"error_heading\">\r\n                  FATAL ERROR\r\n               </div>\r\n               <div class=\"error_text\">\r\n                  <span id=\"panicFailureText\"></span>\r\n                  <br />All channels have been stopped.\r\n                  Please address this issue and restart Iguana.\r\n               </div>\r\n            </div>\r\n         </span>\r\n\r\n         \r\n            <span id=\"lowDiskSpaceMessage\" style=\"display:none\">\r\n         \r\n            <div class=\"warning_message\" style=\"margin-bottom: 5px;\">\r\n               <div class=\"warning_heading\">\r\n                  WARNING\r\n               </div>\r\n               <div class=\"warning_text\">\r\n                  The log partition is running out of space:  remain.\r\n                  \r\n                  Free some space on the partition, or adjust\r\n                  the <a href=\"/log_settings_view.html\" >maximum&nbsp;log&nbsp;age</a>. \r\n                  See <a href=\"/log_usage_statistics\" >Logs&nbsp;&gt;&nbsp;Log Usage</a> for log usage statistics.\r\n               </div>\r\n            </div>\r\n         </span>\r\n      \r\n                  <div id=\"entryView\" style=\"display:none\">\n            <table style=\"width:100%; table-layout:fixed\">\n               <tr><td style=\"padding:0px\">\n                  <table style=\"width:100%; border-collapse:collapse;\"><tr>\n                  \n                     <!-- CHANNEL ICON/NAME TABLE CELL -->\n                     <td align=\"left\" style=\"padding:0px;\">\n                        <div id=\"entryDescription\" style=\"height:36px; white-space:nowrap;\"></div>\n                     </td>\n                  \n                     <!-- BUTTONS TABLE CELL -->\n                     <td>\n                     \n                        <!-- BEGIN DIV CONTAINER FOR BUTTONS -->\n                        <div style=\"float: right; padding-top:1px;\">\n\n                        \n                           <div id=\"entryResubmit\" style=\"padding:0 10px 0 0; float:left\">\n                              <img class=\"button\" onClick=\"showResubmit()\"\n                                 \n    \n        \n    \n    onMouseOver=\"TOOLtooltipLink('Resubmit or forward this message.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n    \n\n                                 src=\"\n    \n        \n    \n    images/log-browser-resubmit.gif?ver_hash=571F6291\n\" />\n                           </div>\n                           <div id=\"entryRelated\" style=\"padding:0 3px 0px 0px; float:left\">\n                              <img class=\"button\" onClick=\"showRelated()\"\n                                 \n    \n    onMouseOver=\"TOOLtooltipLink('Show all entries related to this.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                                 src=\"images/log-browser-related.gif?ver_hash=571F6291\" />\n                           </div>\n                           <div id=\"entryToMapper\" style=\"padding:0 3px 0px 0px; float:left\">\n                              <img class=\"button\" \n    \n    onMouseOver=\"TOOLtooltipLink('Use this message in the Translator editor.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                                 src=\"images/log-browser-to-mapper.gif?ver_hash=571F6291\" />\n                           </div>\n                           <div style=\"padding:0 10px 0 0; float:left\">\n                              <img class=\"button\" onClick=\"showLink()\"\n                                 \n    \n    onMouseOver=\"TOOLtooltipLink('Show me a direct link to this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                                 src=\"images/log-browser-link.gif?ver_hash=571F6291\" />\n                           </div>\n                           <div style=\"padding:0 10px 0 0; float:left\">\n                              <img class=\"button\" onClick=\"downloadMessage()\"\n                                 \n    \n    onMouseOver=\"TOOLtooltipLink('Download this message to a file.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                                 src=\"images/log-browser-save-message.gif?ver_hash=571F6291\" />\n                           </div>\n                        \n                        \n                        \n                        \n                        <div class=\"viewSelectDropdown\" style=\"padding:0 3px 0 0px; float:left;\">\n                           <div class=\"dropdownButtonWrapper\">\n                              <img id=\"logViewSelectDropdownButton\" class=\"ViewDropdownButton\"\n                                 src=\"images/log_views/dropdown-text.gif?ver_hash=571F6291\"\n                                 \n    \n    onMouseOver=\"TOOLtooltipLink('Change the view mode for this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                                 onclick=\"javascript:toggleDropdown('logViewSelectDropdown', 'logViewSelectDropdownButton', CurrentViewMode);\">\n                              </img>\n                           </div>\n                           <div id=\"logViewSelectDropdown\" style=\"display:none; \"\n                                onclick=\"javascript:hideDropdown('logViewSelectDropdown', 'logViewSelectDropdownButton', CurrentViewMode);\">\n                              <a class=\"logViewDropdownOption Hex\" onclick=\"showHex();\" \n    \n    onMouseOver=\"TOOLtooltipLink('View hex-dump of this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>Hex-dump</span>\n                              </a>\n                              <a class=\"logViewDropdownOption Text\" onclick=\"showText();\" \n    \n    onMouseOver=\"TOOLtooltipLink('View plain-text for this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>Plain-text</span>\n                              </a>\n                              <div class=\"logViewDropdownDivider messageOption\" onclick=\"cancelBubble(event);\"></div>\n                              <a class=\"logViewDropdownOption SegmentMessage messageOption\" onclick=\"showParsed('SegmentMessage', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('View segments and composites generated by parse.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>Segment View</span>\n                              </a>\n                              <a class=\"logViewDropdownOption SegmentGrammar parseOption\" onclick=\"showParsed('SegmentGrammar', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('View segment grammar populated with parse results.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>Segment Grammar View</span>\n                              </a>\n                              <div class=\"logViewDropdownDivider parseOption\" onclick=\"cancelBubble(event);\"></div>\n                              <a class=\"logViewDropdownOption Table parseOption\" onclick=\"showParsed('Table', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('View tables generated by complete parse. (Graphical)', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>Table View (Graphical)</span>\n                              </a>\n                              <a class=\"logViewDropdownOption TableText parseOption\" onclick=\"showParsed('TableText', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('View tables generated by complete parse. (Plain-text)', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>Table View (Plain-text)</span>\n                              </a>\n                              <a class=\"logViewDropdownOption SQL parseOption\" onclick=\"showParsed('SQL', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('View SQL statements generated by complete parse.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>SQL View</span>\n                              </a>\n                           </div>\n                        </div>\n                        \n                        \n                        <div id=\"entryWrapTextControl\" style=\"padding:0 10px 0 0; float:left;\">\n                           <img id=\"wrapText\" class=\"button\"\n                              \n    \n    onMouseOver=\"TOOLtooltipLink('Toggle line-wrapping.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                              src=\"images/log-browser-wrap.gif?ver_hash=571F6291\" />\n                        </div>\n                        <div id=\"entryWrapTextControlGrey\" style=\"padding:0 10px 0 0; float:left; display:none;\">\n                           <img id=\"wrapTextGrey\" class=\"button\"\n                              \n    \n    onMouseOver=\"TOOLtooltipLink('You cannot wrap text in this view mode.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                              src=\"images/log-browser-nowrap-grey.gif?ver_hash=571F6291\" />\n                        </div>\n                        \n                        \n                           <div id=\"entryMarked\" style=\"padding:0 10px 0 0; float:left\">\n                              <img id=\"entryMarkedImg\" class=\"button\" onClick=\"markEntry()\"\n                                 \n    \n    onMouseOver=\"TOOLtooltipLink('Mark/Unmark this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                                 src=\"images/log-ack-yes?ver_hash=571F6291\" />\n                           </div>\n                        \n                        <!-- END DIV CONTAINER FOR BUTTONS -->\n                        </div>\n                     </td>\n                     \n                     \n                     <!-- DELETE BUTTON CELL -->\n                     <td align=\"right\" style=\"width:30px; padding: 0px;\">\n                        <div id=\"entryDelete\" style=\"display:none; padding:3px 10px 0 0;\">\n                           <img class=\"button\" onClick=\"deleteEntry()\"\n                              \n    \n        \n    \n    onMouseOver=\"TOOLtooltipLink('Delete this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n    \n\n                              src=\"\n    \n        \n    \n    images/log-browser-delete.gif?ver_hash=571F6291\n\" />\n                        </div>\n                        <div id=\"entryUndelete\" style=\"display:none; padding:3px 10px 0 0;\">\n                           <img class=\"button\" onClick=\"undeleteEntry()\"\n                              \n    \n        \n    \n    onMouseOver=\"TOOLtooltipLink('Undelete this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n    \n\n                              src=\"\n    \n        \n    \n    images/log-browser-undelete.gif?ver_hash=571F6291\n\" />\n                        </div>\n                     </td>\n                     \n                     <!-- NAVIGATION TABLE CELL (Next/Prev/Pop-out/Close) -->\n                     <td align=\"right\" style=\"width:161px; padding: 0px; border-left: 1px solid #d0d1d1;\">\n                        <table style=\"border-collapse:collapse; margin-top:1px;\">\n                           <tr>\n                              <td style=\"padding-right:3px; background:url('/images/log_buttons_bg_left.gif'); background-repeat:no-repeat; background-position:left;\">\n                                 <div style=\"white-space:nowrap; margin-top:0px; padding-top:1px;\">\n                                    <img class=\"nav-button\" id=\"entryPrev\" />\n                                    <img class=\"nav-button\" id=\"entryNext\" />\n                                    <!-- \n                                       <img class=\"nav-button\" id=\"entryPopout\" src=\"/images/msg-pop-out.gif?ver_hash=571F6291\"\n                                       onmouseover=\"javascript:this.src='/images/msg-pop-out-hover.gif?ver_hash=571F6291'; TOOLtooltipLink('View this entry in a new window.', undefined, this, { Left: -12 });\"\n                                       onmouseout =\"javascript:this.src='/images/msg-pop-out.gif?ver_hash=571F6291';       TOOLtooltipClose();\"\n                                       onmousedown=\"javascript:this.src='/images/msg-pop-out-active.gif?ver_hash=571F6291';\"\n                                       onmouseup  =\"javascript:this.src='/images/msg-pop-out-hover.gif?ver_hash=571F6291';\"\n                                       onclick    =\"javascript:LOGpopoutCurrentEntry();\" /> -->\n                                 </div>\n                              </td>\n                              <td style=\"padding-left:3px; background:url('/images/log_buttons_bg_right.gif'); background-repeat:no-repeat; background-position:right;\">\n                                 <div style=\"white-space:nowrap; margin:-1px;\">\n                                    <a class=\"button\" onClick=\"showLog()\"><span>Close</span></a>\n                                 </div>\n                              </td>\n                           </tr>\n                        </table>\n                     </td>\n                     \n                     \n                  </tr></table>\n               </td></tr>\n               <tr><td>\n                  <div id=\"PleaseWaitDiv\" class=\"entryViewPleaseWaitBar\" style=\"position:absolute; visibility:hidden;\">\n                     <-- filled by js-->\n                  </div>\n                  <div id=\"entryArea\" style=\"height:100%;\">\n                     <div class=\"entryViewPleaseWaitBar\">Processing...</div>\n                  </div>\n                  <div id=\"reparseWarning\" style=\"display:none;\">\n                  </div>\n               </td></tr>\n            </table>\n         </div>\n         \n\r\n\r\n         <div id=\"workingProgress\" style=\"width:100%; height:100%; display:none\">\r\n            <table style=\"width:100%; height:100%\"><tr><td align=\"center\" valign=\"center\">\r\n               <div id=\"workingProgressDiv\"></div>\r\n               <div style=\"padding-top:15px\">\r\n                  <img src=\"/images/resubmit-spinner.gif?ver_hash=571F6291\">\r\n               </div>\r\n            </td></tr></table>\r\n         </div>\r\n         <div id=\"logView\">\r\n            <div id=\"logArea\" style=\"width:100%; overflow-x:hidden; overflow-y:scroll\" onmousedown=\"javascript:this.focus();\" tabindex=1>\r\n               <div style=\"text-align:center; width:100%;height:20px; background-color:yellow; display:none;\" id=\"deleteNotify\">\r\n                     <div id=\"deleteStatus\" style=\"font-weight:bold; padding:3px 0 0 0; width:100%;\">\r\n                        <!-- set by ajax -->\r\n                     </div>\r\n               </div>\r\n               <div id=\"noResults\" style=\"position:relative; width:100%; height:100%; display:none\">\r\n\t          <div id=\"noResultsContainer\"\r\n\t\t       style=\"position: absolute; \r\n\t\t              top:50%; \r\n\t\t\t      left: 50%; \r\n\t\t\t      height: 300px;\r\n\t\t\t      margin-top: -150px; \r\n\t\t\t      width: 400px;\r\n\t\t\t      margin-left: -200px\">\r\n                  <div class=\"noResultsString\">No matching entries.</div>\r\n\t\t  <div class=\"searchTermsHelp\" id=\"no_results_search_terms_help\">\r\n\t\t        <p>Tips for text searching:</p>\r\n\t\t\t<ul>\r\n\t\t\t<li>Search for whole words, e.g., \"RADIOLOGY\" instead of \"RADIO\".</li>\r\n\t\t\t<li>Words are separated by any form of punctuation; to find \"JOHN'S\", search for \"JOHN\".</li>\r\n\t\t\t<li>If searching for substrings (e.g., \"RICK\" in \"FREDERICK\") start the search with an exclamation mark (!), e.g., \"!RICK\". This can be a significantly slower search.</li>\r\n\t\t\t<li>Regular expressions can also be used when starting the search with an exclamation mark.</li>\r\n\t\t\t</ul>\r\n\t\t  </div>\r\n\t\t  </div>\r\n               </div>\r\n               <table id=\"logTable\" style=\"width:100%; table-layout:fixed\">\r\n                  <colgroup>\r\n                     <col align=\"center\" style=\"width:13em\">\r\n                     <col>\r\n                  </colgroup>\r\n\r\n                  <tr id=\"forwardProgress\" style=\"background-color:yellow; display:none\">\r\n                     <td align=\"center\" colspan=\"2\">\r\n                        <div id=\"forwardStatus\" style=\"width:100%;\">\r\n                           Searching...\r\n                        </div>\r\n                     </td>\r\n                  </tr>\r\n\r\n                  \r\n\r\n                  <tr id=\"reverseProgress\" style=\"background-color:yellow\">\r\n                     <td align=\"center\" colspan=\"2\">\r\n                        <div id=\"reverseStatus\" style=\"width:100%;\">\r\n                           Searching...\r\n                        </div>\r\n                     </td>\r\n                  </tr>\r\n               </table>\r\n            </div>\r\n         </div>\r\n      </td></tr>\r\n   </table>\r\n   <table style=\"width:100%; margin-top: 0px; margin-bottom: 0px;\">\r\n      <tr>\r\n         <td style=\"width: 65px; padding:0px 0 0 0; cursor:pointer\"\r\n                                                onclick=\"location.href='/log_usage_statistics';\"\r\n                                                onmouseover=\" TOOLtooltipLink(getLogUsageStatistics(), null, document.getElementById('ToolTipRelocate'));\" \r\n                                                onmouseout=\"TOOLtooltipClose();\" \r\n                                                onmouseup=\"TOOLtooltipClose();\" align=right>\r\n            <a href=\"/log_usage_statistics\" class=\"subtle\">Log Usage:</a>\r\n         </td>\r\n         <td style=\"width: 100px;\" align=left><img id=\"ToolTipRelocate\" src=\"images/sort_spacer.gif\" style=\"width:0px;height:0px;position:absolute;left:185px;\">\r\n            <div id=\"ToolTippedCell\" class=\"percent_used_container\" style=\"cursor:pointer\" onclick=\"location.href='/log_usage_statistics'\"\r\n                                                onmouseover=\" TOOLtooltipLink(getLogUsageStatistics(), null, document.getElementById('ToolTipRelocate'));\" \r\n                                                onmouseout=\"TOOLtooltipClose();\" \r\n                                                onmouseup=\"TOOLtooltipClose();\">            \r\n            <img id=\"iguana_usage_bar\" class=\"percent_used\" src=\"/images/percent_bar_green.gif?ver_hash=571F6291\"/><img id=\"other_usage_bar\" class=\"percent_used\" src=\"/images/percent_used.gif?ver_hash=571F6291\"/ ></div>\r\n         </td>\r\n\t <td><div id=\"log_usage_status_panel\" class=\"subtle\"></div>\r\n         </td>\r\n      </tr>\r\n   </table>\r\n</div>\r\n\r\n<!-- START SIDE PANEL -->\r\n<div id=\"side_panel\">\r\n   <form method=\"post\" action=\"/log_browse\" name=\"FilterForm\" id=\"FilterForm\"> \r\n      <input type=\"hidden\" name=\"DebugMode\" value=\"\" >\r\n      <input type=\"hidden\" name=\"RefMsgId\"  value=\"\">\r\n      <iframe id=\"contextWarningFrame\" src=\"/empty.html\" style=\"display:none; position:absolute; width:100%; opacity:0; filter:alpha(opacity=0)\"></iframe>\r\n      <div id=\"contextWarning\" style=\"position:absolute; width:100%; display:none\">\r\n         <table style=\"width:100%; height:100%\"><tr><td align=\"center\" valign=\"center\">\r\n            <div>Context View</div>\r\n            <table style=\"opacity:100; filter:alpha(opacity=100)\"><tr><td>\r\n               <a class=\"button\" onClick=\"hideRelated()\"><span>Close</span></a>\r\n            </td></tr></table>\r\n         </td></tr></table>\r\n      </div>\r\n      <table id=\"side_table\" style=\"z-index:10\">\r\n         <tr onClick=\"showSearch()\" style=\"cursor:pointer\"><th id=\"side_header\">\r\n            <div id=\"searchBarOpen\" class=\"toggle\">[-]</div>\r\n            <div id=\"searchBarClosed\" class=\"toggle\" style=\"display:none\">[+]</div>\r\n            Search Criteria\r\n         </th></tr>\r\n         <tr><td class=\"side_body\"><div id=\"searchBar\" class=\"side_body_div\">\r\n            <div id=\"searchMismatch\" style=\"display:none\">\r\n               <img src=\"/images/icon_warning.gif?ver_hash=571F6291\" />\r\n               This query does not match the entry shown.\r\n            </div>\r\n\r\n            <h4 class=\"side_title\">Text Query</h4>\r\n            <div>\r\n               <table style=\"width:auto; border-collapse:collapse\"><tr>\r\n                  <td style=\"padding-left:0px;\">\r\n                     <table style=\"padding:0; background:white; border:1px solid #BBBBBB; border-collapse:collapse\"><tr>\r\n                        <td style=\"width:12px; padding:0 2px 0 2px\">\r\n                           <img src=\"/images/icon_search.gif?ver_hash=571F6291\" style=\"margin-top:1px\" />\r\n                        </td>\r\n                        <td style=\"padding:0\">\r\n                           <input name=\"Filter\" id=\"filterInput\" value=\"\" style=\"width:135px; border-style:none; outline:none;\" onChange=\"hideDeleteNotify();\"/>\r\n                        </td>\r\n                        <td style=\"width:12px; padding:0 2px 0 2px\">\r\n                           <img id=\"clearFilter\" src=\"images/ex14.gif?ver_hash=571F6291\" style=\"margin-top:1px; cursor:pointer; visibility:hidden\" />\r\n                        </td>\r\n                     </tr></table>\r\n                  </td>\r\n                  <td style=\"padding:0\">\r\n                     <a id=\"textQueryHelpIcon\" class=\"helpIcon\" tabindex=\"100\"\r\n                        rel=\"<p>Use the <strong>Text Query</strong> field to narrow down your search with specific text matching. You can include multiple words, exclude words, or use regular expressions to filter search results.</p>\n\n<p>For example, this text query combines Boolean and regex syntax to perform a very specific search:</p>\n\n<p style=&quot;white-space:nowrap;&quot;><strong>ADT NOT (A03 OR A11) -ZID /Sm(i|y)th(e?)/</strong></p>\n\n<p>This search will find log entries that contain <strong>ADT</strong> but will skip those containing <strong>A03</strong>, <strong>A11</strong> or <strong>ZID</strong>.  Search results will not include patient discharges (A03), cancelled patient admits (A11), or messages that include the custom segment ZID.</p>\n\n<p>In addition, this search will only find records containing the name &quot;Smith&quot; and its alternate spellings (<strong>Smith</strong>, <strong>Smyth</strong>, <strong>Smythe</strong>, or <strong>Smithe</strong>).</p>\r\n                             <a href=&quot;http://www.interfaceware.com/manual/iguana4_searching_the_logs.html?v=5.6.20&quot; target=&quot;_blank&quot;>Learn More About Searching the Logs</a>\r\n                             <br><a href=&quot;http://www.interfaceware.com/manual/using_regex_metacharacters.html?v=5.6.20&quot; target=&quot;_blank&quot;>Learn More About Regular Expressions</a></br>\"\r\n                        title=\"Text Query Syntax\" href=\"#\" onclick=\"initializeHelp(this,event);\">\r\n                        <img src=\"/images/help_icon.gif?ver_hash=571F6291\" style=\"margin-top:1px\" border=\"0\" />\r\n                     </a>\r\n                  </td>\r\n               </tr></table>\r\n               <div id=\"queryError\" style=\"display:none\">\r\n                  <img src=\"/images/icon_warning.gif?ver_hash=571F6291\" />\r\n                  <span id=\"queryErrorText\"></span>\r\n               </div>\r\n            </div>\r\n\r\n            <h4 class=\"side_title\">Channel</h4>\r\n            <select name=\"Source\" id=\"SourceInput\" style=\"width:100%\" onChange=\"onSourceChange(); hideDeleteNotify(); refreshSearch()\" class=\"hidden\">\r\n               \r\n               \r\n                  \r\n                     <option value=\"\" selected>[All Entries]</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\" Iguana\">[Service Entries]</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Channel Manager\">Channel Manager</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"CL - FW Outbound\">CL - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"CLT - FW Outbound\">CLT - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"DEN - FW Outbound\">DEN - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"DFW - FW Outbound\">DFW - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"DONOTSTART ErrChnl Restore Msg\">DONOTSTART ErrChnl Restore Msg</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"DONOTSTART: Error Channel\">DONOTSTART: Error Channel</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"DTW - FW Outbound\">DTW - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"FailOver\">FailOver</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"IAH - FW Outbound\">IAH - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Iguana Monitor\">Iguana Monitor</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"MD - FW Outbound\">MD - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"MessageBroker\">MessageBroker</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"OH - FW Outbound\">OH - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"OKC - FW Outbound\">OKC - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: CLT - FW Outbound\">Paxit: CLT - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: CLV - FW Outbound\">Paxit: CLV - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: CLV to Clev\">Paxit: CLV to Clev</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: DTW - FW Outbound\">Paxit: DTW - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: IAH - FW Outbound\">Paxit: IAH - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: OH - FW Outbound\">Paxit: OH - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: OKC - FW Outbound\">Paxit: OKC - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: To DTW\">Paxit: To DTW</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: To IAH\">Paxit: To IAH</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: To OH\">Paxit: To OH</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: To OKC\">Paxit: To OKC</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: To VA\">Paxit: To VA</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: VA - FW Outbound\">Paxit: VA - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: YBR - FW Outbound\">Paxit: YBR - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: YBR to MD\">Paxit: YBR to MD</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Procare - FW Outbound\">Procare - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Procare Medsure\">Procare Medsure</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Prod-MyRemediEoe\">Prod-MyRemediEoe</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Ric - FW Outbound\">Ric - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To CL\">To CL</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To CLT\">To CLT</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To DEN\">To DEN</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To DFW\">To DFW</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To DTW\">To DTW</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To IAH\">To IAH</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To MD\">To MD</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To NCPDP Interface\">To NCPDP Interface</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To OH\">To OH</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To OKC\">To OKC</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To Ric\">To Ric</option>\r\n                  \r\n               \r\n               \r\n            </select>\r\n\r\n            <div id=\"includeSourceLogsDiv\" style=\"display:none; padding:0 0 0 0;\">\r\n            <table style=\"width:auto; border-collapse:collapse\">\r\n               <tr><td style=\"padding:0;\">\r\n               <h4 class=\"side_title\">Source Channels</h4>\r\n               </td><td style=\"padding:0 2 0 0; height: 5px; text-align: center;\">\r\n                     <a id=\"textQueryHelpIcon\" class=\"helpIcon\" tabindex=\"100\"\r\n                        rel=\"The selected channel has a 'From Channel' component. <p>Select the source channels here to include messages from those channels. <p>'Go to Source Position' may be clicked only if one source channel is selected.\"\r\n                        title=\"Source Channels\" href=\"#\" onclick=\"initializeHelp(this,event);\">\r\n                        <img src=\"/images/help_icon.gif?ver_hash=571F6291\" style=\"margin-top:1px\" border=\"0\" />\r\n                     </a>\r\n               </td></tr>\r\n           </table>\r\n               <div id=\"DequeueSourceNameDiv\" style=\"width:100%; padding:0 0 0 0\"><!-- filled by js --></div>\r\n            </div>\r\n\r\n            <div id=\"JumpToQueueEndDiv\" style=\"display:none;\" >\r\n              <a href=\"#\" onClick=\"jumpToQueueEnd(); return false;\">Go to Source Position</a>\r\n            </div>\r\n\r\n            <table style=\"width:100%; border-collapse:collapse\">\r\n               <tr style=\"padding: 0 0 0 0;\">\r\n               <td class=\"side_title\" style=\"padding: 0 0 0 0; width: 80px;\">\r\n                  <h4 class=\"side_title\">Time Range</h4>\r\n               </td>\r\n               <td style=\"padding: 6px 0 0 0; text-align: left;\">\r\n                  <input type=\"checkbox\" name=\"ShowTimeRange_local\" id=\"ShowTimeRange_local\" class=\"no_style\" onchange=\"showTimeRange()\" onclick=\"showTimeRange()\" onkeyup=\"showTimeRange()\">\r\n               </td>\r\n\t       <td style=\"padding: 6px 0 0 0; text-align:right\">\r\n                   <a id=\"dateQueryHelpIcon\" class=\"helpIcon\" tabindex=\"100\"\r\n                        rel=\"This limits messages to the given time range. Example date/times: \r\n\t\t\t<ul>\r\n\t\t\t<li>-1 h (1 hour ago)</li>\r\n\t\t\t<li>-1 min (1 minute ago)</li>\r\n\t\t\t<li>now</li>\r\n\t\t\t<li>yesterday</li>\r\n\t\t\t<li>6/4/2005 22:30:45</li>\r\n\t\t\t</ul>\r\n\t\t\t\"\r\n                        title=\"Time Range\" href=\"#\" onclick=\"initializeHelp(this,event);\">\r\n                        <img src=\"/images/help_icon.gif?ver_hash=571F6291\" style=\"margin-top:1px\" border=\"0\" />\r\n                   </a>\r\n                </td>\r\n            </tr>\r\n            </table>\r\n            <table class=\"timeRange\" style=\"display: none;\" id=\"TimeRangeTable\">\r\n               <tr>\r\n                  <td class='timeLabel' valign=\"top\">from</td>\r\n                  <td style=\"padding: 0 0 5px 0\">\r\n                  <table class=\"timeRangeField\">\r\n\t\t     <tr>\r\n                     <td class=\"left_cell\"><input type='text' class='DateTimeField' name='AfterDateTime_local' id='AfterDateTime_local'/></td>\r\n                     <td class=\"mid_cell\"><img id=\"clearAfterDateTime_local\" src=\"images/ex14.gif?ver_hash=571F6291\" style=\"margin-top:1px; cursor:pointer; visibility:hidden\" /></td>\r\n\t\t     <td class=\"right_cell\"><img style=\"float:right\" id=\"calendarImgAfter\" src=\"images/calendar.gif?ver_hash=571F6291\"></td>\r\n                     </tr>\r\n                  </table>\r\n\t\t  <div class='DateTimePreview' style=\"display: none\" id='AfterDateTimePreview'></div>\r\n\t\t  </td>\r\n                  <td><input type='hidden' name='After' id='AfterInput' value=''/></td>\r\n               </tr>\r\n               <tr>\r\n                  <td class='timeLabel' valign=\"top\">to</td>\r\n                  <td>\r\n                  <table class=\"timeRangeField\">\r\n\t\t     <tr>\r\n                     <td class=\"left_cell\"><input type='text' class='DateTimeField' name='BeforeDateTime_local' id='BeforeDateTime_local'/></td>\r\n                     <td class=\"mid_cell\"><img id=\"clearBeforeDateTime_local\" src=\"images/ex14.gif?ver_hash=571F6291\" style=\"margin-top:1px; cursor:pointer; visibility:hidden\" /></td>\r\n\t\t     <td class=\"right_cell\"><img style=\"float:right\" id=\"calendarImgBefore\" src=\"images/calendar.gif?ver_hash=571F6291\"></td>\r\n                     </tr>\r\n                  </table>\r\n\t\t  <div class='DateTimePreview' style=\"display: none\" id='BeforeDateTimePreview'></div>\r\n\t\t  </td>\r\n                  <td style='padding:0px;'><input type='hidden' name='Before' id='BeforeInput' value=''/></td>\r\n               </tr>\r\n            </table>\r\n\r\n            <h4 class=\"side_title\">Type</h4>\r\n            <select MULTIPLE size=6 name=\"Type\" id=\"Type\" onChange=\"hideDeleteNotify();refreshSearch();\"  class=\"hidden\" style=\"width:195px;\">\r\n               \r\n               \r\n                  \r\n                     <option value=\"\" selected>All</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"messages\">Messages</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"ack_messages\">ACK Messages</option>\r\n                  \r\n               \r\n               \r\n               \r\n                  \r\n                     <option value=\"errors_marked\">Errors - Marked</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"errors_unmarked\">Errors - Unmarked</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"warnings\">Warnings</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"successes\">Successes</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"info\">Informational</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"debug\">Debug</option>\r\n                  \r\n               \r\n               \r\n            </select>\r\n\r\n            <p><select name=\"Deleted\" id=\"Deleted\" onChange=\"hideDeleteNotify(); refreshSearch();\" style=\"width:195px;\">\r\n               <option value=\"false\"  >Hide Deleted</option>\r\n               <option value=\"both\" selected >Show Deleted</option>\r\n               <option value=\"true\"  >Show Only Deleted</option>\r\n            </select></p>\r\n            \r\n            <table id=\"saveButtonView\" style=\"width:100%\">\r\n               <tr><td align=\"right\" style=\"padding:10px 0 0 0\">\r\n                  \r\n                     <a class=\"button\" style=\"float:right;\" onClick=\"saveSearchLink('search');\"><span><img src=\"../images/icon_save.gif?ver_hash=571F6291\" /> &nbsp;Bookmark Search</span></a>\r\n                  \r\n               </td></tr>\r\n            </table>\r\n            </h4>\r\n\r\n         </div></td></tr>\r\n         <tr onClick=\"hideDeleteNotify(); showExport()\" style=\"cursor:pointer\"><th class=\"side_header\">\r\n            <div id=\"exportBarOpen\" class=\"toggle\" style=\"display:none\">[-]</div>\r\n            <div id=\"exportBarClosed\" class=\"toggle\">[+]</div>\r\n            Export\r\n         </th></tr>\r\n         <tr><td class=\"side_body\"><div id=\"exportBar\" style=\"display:none\" class=\"side_body_div\">\r\n\r\n            \r\n\r\n            <h4 class=\"side_title\">Format</h4>\r\n            \r\n               <input type=\"radio\" class=\"no_style\" id=\"Export.Format\" name=\"Export.Format\" value=\"Plain\"\r\n                      checked>\r\n               <span onClick=\"this.previousSibling.previousSibling.click();\">\r\n                  One entry per line.\r\n               </span><br />\r\n            \r\n            \r\n               <input type=\"radio\" class=\"no_style\" id=\"Export.Format\" name=\"Export.Format\" value=\"Annotated\"\r\n                      >\r\n               <span onClick=\"this.previousSibling.previousSibling.click();\">\r\n                  An annotated text file.\r\n               </span><br />\r\n            \r\n            \r\n               <input type=\"radio\" class=\"no_style\" id=\"Export.Format\" name=\"Export.Format\" value=\"CSV\"\r\n                      >\r\n               <span onClick=\"this.previousSibling.previousSibling.click();\">\r\n                  A CSV file.\r\n               </span><br />\r\n            \r\n\r\n            <h4 class=\"side_title\">Options</h4>\r\n            <input type=\"hidden\"   name=\"Export.Plan\" value=\"\" />\r\n            <input type=\"checkbox\"  class=\"no_style\" name=\"Export.Related\" id=\"Export.Related\"\r\n               >\r\n            <span onClick=\"this.previousSibling.previousSibling.click();\">\r\n               Related messages.\r\n            </span>\r\n            <br />\r\n\r\n            <table id=\"exportProgressView\" style=\"width:100%; margin:10px 0 0 0; display:none\">\r\n               <tr><td id=\"exportProgressArea\" style=\"padding:0; border:1px solid #757671\">\r\n                  <img id=\"exportProgress\" class=\"progress_bar\" style=\"width:0px\"\r\n                       src=\"/images/pulsing_progress_bar.gif?ver_hash=571F6291\" />\r\n               </td></tr>\r\n            </table>\r\n            <table id=\"exportButtonView\" style=\"width:100%\">\r\n               <tr><td align=\"right\" style=\"padding:10px 0 0 0\">\r\n                     <a class=\"button\" style=\"float:right\" onClick=\"hideDeleteNotify(); exportSearch()\"><span>Export</span></a>\r\n               </td></tr>\r\n            </table>\r\n            <table style=\"width:100%\">\r\n               <tr>\r\n               <td align=\"right\" style=\"padding:10px 0 0 0\">\r\n                  <a id=\"export-to-mapper\" class=\"button\" style=\"float:right\"\r\n                     ><span>Export to Translator</span></a>\r\n            </table>\r\n            <table id=\"saveButtonViewTwo\" style=\"width:100%\">\r\n               <tr><td align=\"right\" style=\"padding:10px 0 0 0\">\r\n                  \r\n                     <a class=\"button\" style=\"float:right;\" onClick=\"saveSearchLink('export');\"><span><img src=\"../images/icon_save.gif?ver_hash=571F6291\" /> &nbsp;Bookmark Export</span></a>\r\n                  \r\n               </td></tr>\r\n            </table>\r\n         </div></td></tr>\r\n      </table>\r\n\r\n      <table id=\"side_table\" style=\"z-index:10\">\r\n         <tr><th id=\"side_header\">\r\n            Help Links\r\n         </th></tr>\r\n         <tr><td id=\"side_body\" style=\"padding-top:15px\">\r\n            <ul class=\"help_link_icon\" style=\"margin:0\">\r\n               <li>\r\n               <a href=\"http://www.interfaceware.com/manual/iguana4_viewing_logs.html?v=5.6.20\" target=\"_blank\">Viewing the Logs</a>\r\n               </li>\r\n               <li>\r\n               <a href=\"http://www.interfaceware.com/manual/iguana4_exporting_the_logs.html?v=5.6.20\" target=\"_blank\">Exporting the Logs</a>\r\n               </li>\r\n            </ul>\r\n         </td></tr>\r\n      </table>\r\n\r\n   </form>\r\n</div>\r\n<!-- END SIDE PANEL -->\r\n\r\n\n   <div id=\"helpTooltipDiv\" class=\"helpTooltip\" style=\"zoom:1\">\n      <b id=\"helpTooltipTitle\" onClick=\"$('#helpTooltipDiv').fadeOut('slow');\"></b>\n      <em id=\"helpTooltipBody\"></em>\n      <input type=\"hidden\" id=\"helpTooltipId\" value=\"0\" />\n   </div>\n\r\n\r\n<div id=\"repo-dialog\" style=\"display:none\" title=\"Reposition Channel\"></div>\r\n\r\n<div id=\"bookmark-dialog\" title=\"Bookmark This URL\" style=\"display:none;\">\r\n   <div id=\"bookmark-text\"></div>\r\n\t<fieldset>\r\n\t\t<label for=\"bookmarkLink\"><b>URL:</b></label>\r\n\t\t<input type=\"text\" name=\"bookmarkLink\" id=\"bookmarkLink\" class=\"text ui-widget-content ui-corner-all\" />\t\t\r\n\t</fieldset>\r\n</div>\r\n\r\n<div id=\"show-link-dialog\" title=\"Link To This Message\" style=\"display:none;\">\r\n   <div id=\"show-link-dialog-text\"></div>\r\n\t<fieldset>\r\n\t\t<label for=\"messageLink\"><b>URL:</b></label>\r\n\t\t<input type=\"text\" name=\"messageLink\" id=\"messageLink\" class=\"text ui-widget-content ui-corner-all\" />\t\t\r\n\t</fieldset>\r\n</div>\r\n\r\n\r\n<div id=\"alert-dialog\" title=\"Alert\" style=\"display:none;\">\r\n   <div id=\"alert-dialog-text\"></div>\r\n</div>\r\n\r\n<iframe id=\"resubmitFrame\" src=\"/empty.html\" style=\"display:none;\">\r\n</iframe>\r\n\r\n<div id=\"resubmitDialog\" style=\"display:none;\">\r\n\r\n   <div id=\"resubmitTopControls\" style=\"width:100%; float:left;\">\r\n      <div style=\"float:left;\">\r\n         Resubmit To Channel:\r\n         <select id=\"Destination\" name=\"Destination\" onchange=\"onPreviewDestinationChanged(this);\">\r\n            \n   <option value=\"\">[Choose Channel]</option>\n\r\n            \r\n               \n   <option value=\"Channel Manager\">Channel Manager</option>\n\r\n            \r\n               \n   <option value=\"CL - FW Outbound\">CL - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"CLT - FW Outbound\">CLT - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"DEN - FW Outbound\">DEN - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"DFW - FW Outbound\">DFW - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"DONOTSTART ErrChnl Restore Msg\">DONOTSTART ErrChnl Restore Msg</option>\n\r\n            \r\n               \n   <option value=\"DONOTSTART: Error Channel\">DONOTSTART: Error Channel</option>\n\r\n            \r\n               \n   <option value=\"DTW - FW Outbound\">DTW - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"FailOver\">FailOver</option>\n\r\n            \r\n               \n   <option value=\"IAH - FW Outbound\">IAH - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Iguana Monitor\">Iguana Monitor</option>\n\r\n            \r\n               \n   <option value=\"MD - FW Outbound\">MD - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"MessageBroker\">MessageBroker</option>\n\r\n            \r\n               \n   <option value=\"OH - FW Outbound\">OH - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"OKC - FW Outbound\">OKC - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: CLT - FW Outbound\">Paxit: CLT - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: CLV - FW Outbound\">Paxit: CLV - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: CLV to Clev\">Paxit: CLV to Clev</option>\n\r\n            \r\n               \n   <option value=\"Paxit: DTW - FW Outbound\">Paxit: DTW - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: IAH - FW Outbound\">Paxit: IAH - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: OH - FW Outbound\">Paxit: OH - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: OKC - FW Outbound\">Paxit: OKC - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: To DTW\">Paxit: To DTW</option>\n\r\n            \r\n               \n   <option value=\"Paxit: To IAH\">Paxit: To IAH</option>\n\r\n            \r\n               \n   <option value=\"Paxit: To OH\">Paxit: To OH</option>\n\r\n            \r\n               \n   <option value=\"Paxit: To OKC\">Paxit: To OKC</option>\n\r\n            \r\n               \n   <option value=\"Paxit: To VA\">Paxit: To VA</option>\n\r\n            \r\n               \n   <option value=\"Paxit: VA - FW Outbound\">Paxit: VA - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: YBR - FW Outbound\">Paxit: YBR - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: YBR to MD\">Paxit: YBR to MD</option>\n\r\n            \r\n               \n   <option value=\"Procare - FW Outbound\">Procare - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Procare Medsure\">Procare Medsure</option>\n\r\n            \r\n               \n   <option value=\"Prod-MyRemediEoe\">Prod-MyRemediEoe</option>\n\r\n            \r\n               \n   <option value=\"Ric - FW Outbound\">Ric - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"To CL\">To CL</option>\n\r\n            \r\n               \n   <option value=\"To CLT\">To CLT</option>\n\r\n            \r\n               \n   <option value=\"To DEN\">To DEN</option>\n\r\n            \r\n               \n   <option value=\"To DFW\">To DFW</option>\n\r\n            \r\n               \n   <option value=\"To DTW\">To DTW</option>\n\r\n            \r\n               \n   <option value=\"To IAH\">To IAH</option>\n\r\n            \r\n               \n   <option value=\"To MD\">To MD</option>\n\r\n            \r\n               \n   <option value=\"To NCPDP Interface\">To NCPDP Interface</option>\n\r\n            \r\n               \n   <option value=\"To OH\">To OH</option>\n\r\n            \r\n               \n   <option value=\