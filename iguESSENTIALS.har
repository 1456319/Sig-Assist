            "text": "a.subtle:link \r\n{ \r\n  color: #888c78;\r\n}\r\n\r\n.subtle\r\n{\r\n   color: #888c78;\r\n}\r\n\r\na.log_mes:link \r\n{ \r\n  color: #008000\r\n} \r\n\r\na.log_mes:active\r\n{\r\n\r\n}\r\n\r\na.log_mes:visited \r\n{\r\n  color: #008000\r\n}\r\n\r\na.log_mes:hover\r\n{\r\n  color: #005000\r\n}\r\n\r\n.log_mes\r\n{\r\n   color: #008000;\r\n}\r\n\r\na.log_err:link \r\n{ \r\n  color: #FF0000;\r\n} \r\n\r\na.log_err:active\r\n{\r\n  color: #FF0000;\r\n}\r\n\r\na.log_err:visited \r\n{\r\n  color: #FF0000;\r\n}\r\n\r\na.log_err:hover\r\n{\r\n   color: #C00000;\r\n}\r\n\r\n.log_err\r\n{\r\n   color: #FF0000;\r\n}\r\n\r\n.search\r\n{\r\n   background-color: #FFFF00;\r\n}\r\n\r\n.log_entry_area,.log_entry_area_deleted\r\n{\r\n   overflow:auto;\r\n   width:100%; \r\n   height:100%; \r\n   background:#eeefea\r\n}\r\n\r\n.log_entry_area_deleted\r\n{\r\n   color: #b7b7b7;\r\n}\r\n\r\n.log_type_icon\r\n{\r\n   width: 37px; \r\n   height: 32px;\r\n   background-position:center center;\r\n   background-repeat: no-repeat;\r\n}\r\n\r\ntable.preview td, table.preview_deleted td\r\n{\r\n   width:100%; \r\n   border-collapse:collapse;\r\n}\r\n\r\ntable.preview_deleted td\r\n{\r\n   color: #b7b7b7;   \r\n   text-decoration:line-through;   \r\n}\r\n\r\n/* Colours for the hex view: odd lines, even lines, segment delimiters,\r\n   control characters (other than CR), and non-ASCII characters. */\r\nspan.ho    { background-color:#eeefea }\r\nspan.he    { background-color:#e0e1dd }\r\nfont.hst   { background-color:#9be0be }\r\nfont.hctrl { background-color:#93b2dc }\r\nfont.hnasc { background-color:#ccf2a7 }\r\n\r\nspan.ho, span.he\r\n{\r\n   display: inline-block;\r\n   width: 100%;\r\n}\r\n\r\ndiv.ui-datepicker { font-size: x-small; }\r\n\r\n.warning {\r\n   text-align: left;\r\n   color: #FF0000;\r\n}\r\nimg.button {\r\n   border-style: none;\r\n   cursor: pointer;\r\n}\r\nimg.blank-button {\r\n   border-style: none;\r\n}\r\nimg.nav-button {\r\n   cursor: pointer;\r\n}\r\ndiv#noResults {\r\n   background-color: silver;\r\n}\r\n.noResultsString{\r\n   color: gray;\r\n   font-size: 20pt;\r\n   font-weight: bold;\r\n   font-variant: small-caps;\r\n   text-align: center;\r\n}\r\n.searchTermsHelp{\r\n   color: gray;\r\n   font-size: 9pt;\r\n}\r\ndiv#workingProgress {\r\n   background-color: silver;\r\n}\r\ndiv#workingProgress div {\r\n   color: gray;\r\n   font-size: 20pt;\r\n   font-weight: bold;\r\n   font-variant: small-caps;\r\n}\r\ndiv#contextWarning {\r\n   background-color: silver;\r\n   opacity: 0.8; filter:alpha(opacity=80);\r\n}\r\ndiv#contextWarning div {\r\n   color: gray;\r\n   font-size: 20pt;\r\n   font-weight: bold;\r\n   font-variant: small-caps;\r\n}\r\ndiv#searchMismatch {\r\n   background-color: #FFF383;\r\n   border: #CFA53A 1px solid;\r\n   color: #333333;\r\n   margin-top: 15px;\r\n   padding: 1px 3px 1px 5px;\r\n}\r\ndiv#searchMismatch img {\r\n   padding-top: 3px;\r\n}\r\ndiv#queryError {\r\n   background-color: #FFF383;\r\n   color: #333333;\r\n   margin: 5px 3px 3px 3px;\r\n   padding: 1px 3px 1px 5px;\r\n}\r\ndiv#queryError img {\r\n   padding-top: 3px;\r\n}\r\ntable#logTable tr.highlight {\r\n   background-color: #cbe892;\r\n}\r\ntable#logTable tr.highlightHover {\r\n   background-color: #b2cc80;\r\n}\r\ntable#logTable tr.firstHover {\r\n   background-color: #c5c6c2;\r\n}\r\ntable#logTable tr.secondHover {\r\n   background-color: #c5c6c2;\r\n}\r\ntable#logTable tr td {\r\n   vertical-align: top;\r\n}\r\ntable#logTable td.entryType {\r\n   padding: 2px;\r\n   text-align: center;\r\n   vertical-align: middle;\r\n}\r\ntable#logTable td.entryPendingMarker {\r\n   padding: 0px;\r\n   text-align: center;\r\n   vertical-align: middle;\r\n}\r\ntable#logTable td.entryDate {\r\n   font-weight: bold;\r\n   padding-bottom: 2px;\r\n   text-align: center;\r\n}\r\ntable#logTable td.entryTime {\r\n   padding-top: 2px;\r\n   text-align: center;\r\n}\r\ntable#logTable td.entrySource {\r\n   font-weight: bold;\r\n   padding: 0 0 4px 0;\r\n}\r\ntable#logTable td.entryPreview {\r\n   padding: 0;\r\n   overflow: hidden;\r\n}\r\ninput#ShowTimeRange_local {\r\n   padding: 0;\r\n}\r\ntable.timeRange {\r\n   border-collapse: collapse;\r\n   border-style: none;\r\n   padding: 0;\r\n   width: 100%;\r\n}\r\ntable.timeRange td {\r\n   padding: 0px 0px 2px 0px;\r\n}\r\ntable.timeRange td.timeLabel {\r\n   padding: 4px 2px 0px 2px;\r\n   color: gray;\r\n   float: left;\r\n   font-size: x-small;\r\n   text-align: right;\r\n   width: 5ex;\r\n}\r\ntable.timeRange input {\r\n   outline: none;\r\n   padding: 1px 2px 2px 2px;\r\n   border: 1px solid #BBBBBB;\r\n}\r\ntable.timeRange input.DateTimeField {\r\n   width: 122px;\r\n   border-style:none;\r\n   outline:none;\r\n}\r\ntable.timeRange div.DateTimePreview{\r\n   color: gray;\r\n   font-size: x-small;\r\n}\r\ntable.timeRange img {\r\n   padding: 0px 2px 0px 2px;\r\n}\r\n\r\n\r\ntable.timeRangeField {\r\n    padding:0; \r\n    border-collapse:collapse\r\n}\r\n\r\ntable.timeRangeField td.left_cell{\r\n    padding:0; \r\n    background:white; \r\n    border:1px solid #BBBBBB; \r\n    border-right: 0\r\n}\r\n\r\ntable.timeRangeField td.mid_cell{\r\n    width: 12px;\r\n    padding:0; \r\n    background:white;\r\n    border:1px solid #BBBBBB; \r\n    border-left: 0\r\n}\r\n\r\ntable.timeRangeField td.right_cell{\r\n    width: 12px; \r\n    padding: 0 0 0 2px\r\n}\r\n\r\n/*\r\n * These are for our fancy side-bar\r\n */\r\nth.side_header {\r\n   border-top: 1px solid #757671;\r\n   /* Stuff from #side_header */\r\n   background-color: #e4e5e0;\r\n   background-image: none;\r\n   padding-top: 7px;\r\n   padding-bottom: 7px;\r\n   padding-left: 15px;\r\n   padding-right: 15px;\r\n   color: #787a77;\r\n   text-align: left;\r\n   font-size: 11px;\r\n   font-weight: bold;\r\n   text-transform: none;\r\n   letter-spacing: 0em;\r\n}\r\ntable#side_table th div.toggle {\r\n   display: inline;\r\n   font-family: monospace;\r\n}\r\ntd.side_body {\r\n   padding: 0;\r\n}\r\ntd.side_body div.side_body_div {\r\n   /* From #side_body */\r\n   padding-top: 0px;\r\n   padding-bottom: 15px;\r\n   padding-left: 15px;\r\n   padding-right: 15px;\r\n   color: #343434;\r\n   text-align: left;\r\n   font-size: 10px;\r\n   font-weight: normal;\r\n   line-height: 1.5em;\r\n   border-top: 1px solid #757671;\r\n}\r\ndiv#includeSourceLogsDiv {\r\n   border-style: none;\r\n   padding: 2px 5px 0 10px;\r\n}\r\n\r\n/* Remove 'x' in IE10+ */\r\ninput#filterInput::-ms-clear {\r\n    display: none;\r\n}\r\n\r\n#bookmark-dialog input.text { margin-bottom:5px; width:95%; padding: .4em; }\r\n#bookmark-dialog fieldset { padding:0; border:0; margin-top:10px; }\r\n\r\n#show-link-dialog input.text { margin-bottom:5px; width:95%; padding: .4em; }\r\n#show-link-dialog fieldset { padding:0; border:0; margin-top:10px; }\r\n\r\ndiv#entryArea\r\n{\r\n   border: 1px solid #BBBBBB;\r\n}\r\n\r\nimg.popoutButton\r\n{\r\n   float: right;\r\n   margin-bottom: -100px;\r\n   position: relative;\r\n   top: -2px;\r\n   left: 4px;\r\n}\r\n\r\ndiv#tableViewDescriptionDiv\r\n{\r\n   white-space: nowrap;\r\n   overflow: hidden;\r\n   padding: 5px 0px 5px 8px;\r\n   border-bottom: 1px solid #BBBBBB;\r\n   background-color: #EBEBEB;\r\n}\r\n\r\ndiv#TableGrammarViewWrap\r\n{\r\n   height: 100%;\r\n   width: 100%;\r\n   background-color: #FAFAFA;\r\n}\r\n\r\ndiv#tableDisplay\r\n{\r\n   float: left;\r\n   overflow: auto;\r\n   padding: 5px 0px 5px 8px;\r\n   border-left: 1px solid #BBBBBB;\r\n}\r\n\r\nspan#tableViewNameSpan\r\n{\r\n   font-weight: bold;\r\n}\r\n\r\nimg#tableViewMessageIcon\r\n{\r\n   vertical-align: middle;\r\n   margin-top: -3px;\r\n   padding-right: 7px;\r\n}\r\n\r\ndiv#loadingMoreLinesDiv\r\n{\r\n   text-align: center;\r\n   background-color: #FFFF66;\r\n   padding: 2px;\r\n}\r\n\r\ndiv#loadingMoreLinesDiv span\r\n{\r\n   position: relative;\r\n   top: -3px;\r\n}\r\n\r\nspan.line_cropped_warning\r\n{\r\n   color: #333333;\r\n   font-family: Verdana,Arial,Helvetica,Geneva,Lucida,sans-serif;\r\n   font-style: italic;\r\n   background-color: #ddded6;\r\n   line-height: 0px;\r\n}\r\n\r\n/*\r\n * Segment view treeview styles\r\n */\r\n\r\n/* The numbers in these classes' names match the types in MAPnode.h */\r\nspan.mapNodeType0 { background-image: url(/js/treeview/images/message.gif); }\r\nspan.mapNodeType1 { background-image: url(/js/treeview/images/folder.gif); }\r\nspan.mapNodeType2 { background-image: url(/js/treeview/images/segment.gif); }\r\nspan.mapNodeType3 { background-image: url(/js/treeview/images/composite.gif); }\r\nspan.mapNodeType4 { background-image: url(/js/treeview/images/composite.gif); }\r\nspan.mapNodeType5 { background-image: url(/js/treeview/images/composite.gif); }\r\nspan.mapNodeType14 { background-image: url(/js/treeview/images/composite_repeating.gif); }\r\nspan.mapNodeType15 { background-image: url(/js/treeview/images/segment_repeating.gif); }\r\nspan.mapNodeType16 { background-image: url(/js/treeview/images/folder_repeating.gif); }\r\nspan.mapNodeType17 { background-image: url(/js/treeview/images/segment_grey.gif); }\r\nspan.mapNodeType18 { background-image: url(/js/treeview/images/folder_grey.gif); }\r\nspan.mapNodeType19 { background-image: url(/js/treeview/images/composite_red.gif); }\r\nspan.mapNodeType20 { background-image: url(/js/treeview/images/composite_red.gif); }\r\nspan.mapNodeType21 { background-image: url(/js/treeview/images/composite_red.gif); }\r\n\r\nul.ifwareTreeview  span.nodeText.mapNodeTruncatedNodes,\r\ndiv.mapNodeTruncatedNodes\r\n{\r\n   background-image: url(/js/treeview/images/ellipsis.gif);\r\n   font-family: Verdana,Arial,Helvetica,Geneva,Lucida,sans-serif;\r\n   font-style: italic;\r\n   color: #333333;\r\n   background-color: #ddded6;\r\n}\r\n\r\n/* Mandatory/required icons. */\r\nspan.mapNodeType3.mandatory { background-image: url(/js/treeview/images/composite_orange.gif); }\r\nspan.mapNodeType4.mandatory { background-image: url(/js/treeview/images/composite_orange.gif); }\r\nspan.mapNodeType5.mandatory { background-image: url(/js/treeview/images/composite_orange.gif); }\r\n\r\n\r\n/* BEGIN MAPPER PREVIEW MODE STYLES */\r\n\r\ndiv#LOGmapperIoSelect{\r\n float: left;\r\n width: 25%;\r\n height: 100%;\r\n position: relative;\r\n}\r\n\r\ndiv#LOGinnerMapperIoSelect{\r\n position: absolute;\r\n top: 20px;\r\n left: 0px;\r\n bottom: 0px;\r\n right: 0px;\r\n border-right: 1px solid #BBB;\r\n background-color: white;\r\n overflow: auto;\r\n}\r\n\r\ndiv#LOGmapperIoSelect div.LOGmapperIoHeader{\r\n padding: 3px;\r\n padding-left: 7px;\r\n border-right: 1px solid #BBB;\r\n border-bottom: 1px solid #BBB;\r\n background-color: #F9F9F9;\r\n color: #555;\r\n}\r\n\r\nspan.PRJfile.c{\r\n background-color: #DFF4FC;\r\n border-color: #c1e4fb;\r\n border-radius: 4px;\r\n -moz-border-radius: 4px;\r\n padding-right: 4px !important;\r\n}\r\n\r\n.LOGmapperIoItem.c{\r\n background-color: #DFF4FC;\r\n border-color: #c1e4fb;\r\n border-radius: 4px;\r\n -moz-border-radius: 4px;\r\n padding-right: 4px !important;\r\n}\r\n\r\n.LOGmapperIoItem.LOGmapperIoType_0 { background-image: url(/js/treeview/images/table_collection.gif); }\r\n.LOGmapperIoItem.LOGmapperIoType_1 { background-image: url(/js/treeview/images/sql.gif); }\r\n\r\ndiv#LOGmapperIoView{\r\n float: right;\r\n width: 75%;\r\n height: 100%;\r\n overflow: auto;\r\n}\r\n\r\ndiv#LOGmapperIoView ul.ifwareTreeview li.e{\r\n display: block; /* override default hiding of empty nodes */\r\n}\r\n\r\n/* END MAPPER PREVIEW MODE STYLES */\r\n"
