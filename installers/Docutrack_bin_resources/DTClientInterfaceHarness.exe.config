<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="IS.WM.Architecture.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog"/>
  </configSections>

  <applicationSettings>
    <IS.WM.Architecture.Properties.Settings>
      <setting name="LoggingConfigurationFile" serializeAs="String">
        <!-- Point to this file for the logging configuration information -->
        <value>DTClientInterfaceHarness.exe.config</value>
      </setting>
    </IS.WM.Architecture.Properties.Settings>
  </applicationSettings>


  <nlog autoReload="true" xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <targets async="true">
      <target name="logfile" xsi:type="File" archiveAboveSize="10485760" maxArchiveFiles="10" archiveEvery="None" archiveNumbering="Rolling"
              fileName="C:\Program Files (x86)\Integra\Docutrack\Logs\DocuTrack.ScriptHost\DocuTrack.ScriptHost.LOG"
              >
        <layout xsi:type="CsvLayout" customColumnDelimiter=" :: " delimiter="Custom" withHeader="false">
          <quoting>Nothing</quoting>
          <column name="time" layout="${date:format=MM\/d\/yyyy h\:mm\:ss.fff tt}"/>
          <column name="abbr" layout="${event-context:item=abbr}"/>
          <column name="thread" layout="${event-context:item=threadId}"/>
          <column name="method" layout="${event-context:item=class}.${event-context:item=method}"/>
          <column name="message" layout="${message}"/>
        </layout>
      </target>
    </targets>
    <rules>
      <!-- "levels" indicate the log levels that will be INCLUDED in the log file (not omitted) -->
      <!-- possible log levels are: Information,Assertion,Debug,Error,Audit,Database,Diagnostic,EntryPoint1,EntryPoint2,Exception,Fatal,Off,Stopwatch,Trace,Verbose,Warning-->
      <!-- defaults are: Information,Assertion,Error,Audit,Exception,Fatal,Warning-->
      <logger name="stdlogger" levels="Information,Assertion,Error,Audit,Exception,Fatal,Warning" writeTo="logfile" final="true"/>
    </rules>
  </nlog>
</configuration>