<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="IS.OMS.Client.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>

    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="IS.OMS.Client.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
      <section name="IS.OMS.Client.Properties.CustomControls" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
      <section name="IS.WM.Architecture.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>

    <section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog"/>
  </configSections>

  <userSettings>
    <IS.OMS.Client.Properties.Settings>
      <setting name="WindowLocation" serializeAs="String">
        <value>10, 10</value>
      </setting>
      <setting name="WindowSize" serializeAs="String">
        <value>1000, 600</value>
      </setting>
      <setting name="WindowState" serializeAs="String">
        <value>Normal</value>
      </setting>
      <setting name="ShowStatusBar" serializeAs="String">
        <value>False</value>
      </setting>
    </IS.OMS.Client.Properties.Settings>
  </userSettings>

  <applicationSettings>
    <IS.OMS.Client.Properties.Settings>
      <setting name="DisplayVersion" serializeAs="String">
        <value>DocuTrack 6.6</value>
      </setting>
    </IS.OMS.Client.Properties.Settings>

    <IS.WM.Architecture.Properties.Settings>
      <setting name="LoggingConfigurationFile" serializeAs="String">
        <!-- Point to this file for the logging configuration information -->
        <value>DocuTrack.exe.config</value>
      </setting>
      <setting name="ComponentVersionCode" serializeAs="String">
        <value>Client</value>
      </setting>
      <setting name="ComponentVersion" serializeAs="String">
        <value>6.6.4</value>
      </setting>
    </IS.WM.Architecture.Properties.Settings>

    <IS.OMS.Client.Properties.CustomControls>
      <setting name="HelperBoxBackColor" serializeAs="String">
        <value>242, 242, 242</value>
      </setting>
      <setting name="SubPanelHdrForeColor" serializeAs="String">
        <value>102, 102, 102</value>
      </setting>
      <setting name="SubPanelHdrBackColor" serializeAs="String">
        <value>235, 235, 235</value>
      </setting>
      <setting name="MainPanelHdrFontNormal" serializeAs="String">
        <value>Arial, 9pt</value>
      </setting>
      <setting name="SubPanelHdrFontNormal" serializeAs="String">
        <value>Arial, 8pt</value>
      </setting>
      <setting name="HelperBoxForeColor" serializeAs="String">
        <value>99, 99, 99</value>
      </setting>
      <setting name="HelperBoxFontNormal" serializeAs="String">
        <value>Arial, 8.25pt</value>
      </setting>
      <setting name="SubPanelHdrGradientColor" serializeAs="String">
        <value>235, 235, 235</value>
      </setting>
      <setting name="BorderedPanelBorderColor" serializeAs="String">
        <value>209, 209, 209</value>
      </setting>
      <setting name="AdminPanelHdrForeColor" serializeAs="String">
        <value>White</value>
      </setting>
      <setting name="AdminPanelHdrBackColor" serializeAs="String">
        <value>50, 80, 100</value>
      </setting>
      <setting name="AdminPanelHdrGradientColor" serializeAs="String">
        <value>50, 80, 100</value>
      </setting>
      <setting name="SubPanelBackColor" serializeAs="String">
        <value>250, 250, 250</value>
      </setting>
      <setting name="MainPanelBackColor" serializeAs="String">
        <value>White</value>
      </setting>
      <setting name="DialogPanelHdrBackColor" serializeAs="String">
        <value>50, 80, 100</value>
      </setting>
      <setting name="DialogPanelHdrForeColor" serializeAs="String">
        <value>White</value>
      </setting>
      <setting name="DialogPanelHdrGradientColor" serializeAs="String">
        <value>50, 80, 100</value>
      </setting>
      <setting name="InnerDialogPanelHdrBackColor" serializeAs="String">
        <value>220, 220, 220</value>
      </setting>
      <setting name="InnerDialogPanelHdrForeColor" serializeAs="String">
        <value>70, 78, 82</value>
      </setting>
      <setting name="InnerDialogPanelHdrGradientColor" serializeAs="String">
        <value>220, 220, 220</value>
      </setting>
      <setting name="MainPanelHdrForeColor" serializeAs="String">
        <value>99, 99, 99</value>
      </setting>
      <setting name="HelperBoxBorderColor" serializeAs="String">
        <value>181, 181, 181</value>
      </setting>
      <setting name="MainPanelHdrBackColor" serializeAs="String">
        <value>White</value>
      </setting>
      <setting name="MainPanelHdrTextColor" serializeAs="String">
        <value>99, 99, 99</value>
      </setting>
      <setting name="WorkspaceBackColor" serializeAs="String">
        <value>White</value>
      </setting>
      <setting name="RequiredFieldBackColor" serializeAs="String">
        <value>193, 209, 177</value>
      </setting>
      <setting name="WarningTextForeColor" serializeAs="String">
        <value>Red</value>
      </setting>
      <setting name="MainPanelHdrGradientColor" serializeAs="String">
        <value>214, 214, 214</value>
      </setting>
      <setting name="MainPanelHdrBorderColor" serializeAs="String">
        <value>214, 214, 214</value>
      </setting>
      <setting name="AdminPanelHdrFontNormal" serializeAs="String">
        <value>Arial, 9pt, style=Bold</value>
      </setting>
      <setting name="DialogPanelHdrFontNormal" serializeAs="String">
        <value>Arial, 9pt</value>
      </setting>
      <setting name="DefaultBackColor" serializeAs="String">
        <value>249, 249, 249</value>
      </setting>
      <setting name="DefaultGradientColor" serializeAs="String">
        <value>ControlText</value>
      </setting>
      <setting name="DefaultForeColor" serializeAs="String">
        <value>DimGray</value>
      </setting>
      <setting name="PanelBorderColor" serializeAs="String">
        <value>214, 214, 214</value>
      </setting>
      <setting name="ButtonStripFont" serializeAs="String">
        <value>Arial, 8.25pt</value>
      </setting>
      <setting name="ApplicationBackColor" serializeAs="String">
        <value>244, 244, 244</value>
      </setting>
      <setting name="AdminPanelHdrContextColor" serializeAs="String">
        <value>247, 131, 26</value>
      </setting>
    </IS.OMS.Client.Properties.CustomControls>

  </applicationSettings>

  <nlog autoReload="true" xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <targets async="true">
      <target name="logfile" xsi:type="File" archiveAboveSize="10485760" maxArchiveFiles="10" archiveEvery="None" archiveNumbering="Rolling"
              fileName="C:\Program Files (x86)\Integra\Docutrack\Logs\DocuTrack.Client\DocuTrack.Client.${windows-identity:domain=false}.LOG"
              >
        <layout xsi:type="CsvLayout" customColumnDelimiter=" :: " delimiter="Custom" withHeader="false">
          <quoting>Nothing</quoting>
          <column name="time" layout="${date:format=MM\/d\/yyyy h\:mm\:ss.fff tt}"/>
          <column name="abbr" layout="${event-context:item=abbr}"/>
          <column name="thread" layout="${event-context:item=threadId}"/>
          <column name="method" layout="${event-context:item=class}.${event-context:item=method}"/>
          <column name="message" layout="${message}"/>
        </layout>
      </target>
    </targets>
    <rules>
      <!-- "levels" indicate the log levels that will be INCLUDED in the log file (not omitted) -->
      <!-- possible log levels are: Information,Assertion,Debug,Error,Audit,Database,Diagnostic,EntryPoint1,EntryPoint2,Exception,Fatal,Off,Stopwatch,Trace,Verbose,Warning-->
      <!-- defaults are: Information,Assertion,Error,Audit,Exception,Fatal,Warning-->
      <logger name="stdlogger" levels="Information,Assertion,Error,Audit,Exception,Fatal,Warning" writeTo="logfile" final="true"/>
    </rules>
  </nlog>

  <system.serviceModel>
    <behaviors>
      <endpointBehaviors>
        <behavior name="objectGraphBehavior">
          <dataContractSerializer maxItemsInObjectGraph="2147483647" />
        </behavior>
        <behavior name="authenticationBehavior" />
      </endpointBehaviors>

      <serviceBehaviors>
        <behavior name="serviceBehavior">
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>

      </serviceBehaviors>


    </behaviors>

    <bindings>
      <netTcpBinding>
        <!-- 
					This is a Server oriented binding and not client like the rest. 
					We do NOT want to enable NetTCPPortSharing on the client, so this needs to 
					be false for release, but true for debugging (for mex).
					Therefore, the build system must update this.
				-->
        <binding name="portSharingConfiguration" portSharingEnabled="false" maxBufferSize="5767168" maxReceivedMessageSize="5767168" sendTimeout="00:01:10">
          <!-- This may need to be increased if the number of objects transfered are increased.
 				       The length of the XML DOM string must fit inside this number of bytes. -->
          <readerQuotas maxStringContentLength="4048576" />
          <security mode="None" />
        </binding>

        <binding name="tcpConfiguration">
          <security mode="None" />
        </binding>  

        <!-- These sizes ultimately controls how much data can be serialized across the wire in a single
			 call.  They must be equal. -->
        <binding name="netTcpLargePackets" maxBufferSize="5767168" maxReceivedMessageSize="5767168" sendTimeout="00:01:10">
          <!-- This may need to be increased if the number of objects transferred are increased.
				 The length of the XML DOM string must fit inside this number of bytes. -->
          <readerQuotas maxStringContentLength="4048576" />
          <security mode="None" />
        </binding>

        <!-- These sizes ultimately controls how much data can be serialized across the wire in a single
			 call.  They must be equal. -->
        <binding name="netTcpExtraLargePackets" maxBufferSize="2048000000" maxReceivedMessageSize="2048000000" sendTimeout="00:01:10">
          <!-- This may need to be increased if the number of objects transferred are increased.
				 The length of the XML DOM string must fit inside this number of bytes. -->
          <readerQuotas maxStringContentLength="8097152" />
          <security mode="None" />
        </binding>

        <binding name="longRunningBinding" maxBufferSize="2048000000" maxReceivedMessageSize="2048000000" sendTimeout="01:00:10">
          <!-- This may need to be increased if the number of objects transferred are increased.
				 The length of the XML DOM string must fit inside this number of bytes. -->
          <readerQuotas maxStringContentLength="8097152" />
          <security mode="None" />
        </binding>

        <!-- These bindings are used for file transfers. -->
        <binding name="fileTransferGetBinding" transferMode="Streamed" maxReceivedMessageSize="3221225472" sendTimeout="00:01:10">
          <security mode="None" />
        </binding>
        <binding name="fileTransferPutBinding" transferMode="Streamed">
          <security mode="None" />
        </binding>
      </netTcpBinding>

      <netNamedPipeBinding>
        <!-- These sizes ultimately controls how much data can be serialized across the wire in a single
				call.  They must be equal. -->
        <binding name="netNamedPipeExtraLargePackets" maxBufferSize="2048000000" maxReceivedMessageSize="2048000000">
          <!-- This may need to be increased if the number of objects transferred are increased.
								The length of the XML DOM string must fit inside this number of bytes. -->
          <readerQuotas maxStringContentLength="4048576" />
          <security mode="None" />
        </binding>
      </netNamedPipeBinding>

    </bindings>

    <services>
      <service name="IS.OMS.DirectConnect.DirectConnectClientService" behaviorConfiguration="serviceBehavior">

        <endpoint
     contract="IS.OMS.DirectConnect.IDirectConnectClientService"
     binding="netTcpBinding" name="TcpEndpointV2" bindingConfiguration="portSharingConfiguration" />

        <endpoint
     contract="IS.OMS.DirectConnect.IDirectConnectClientService"
     binding="netNamedPipeBinding" name="namedPipeEndpoint" bindingConfiguration="netNamedPipeExtraLargePackets" listenUriMode="Explicit" />

      </service>
    </services>

    <client>
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.WM.Architecture.EventNotification.EventNotificationService/" behaviorConfiguration="authenticationBehavior" binding="netTcpBinding" bindingConfiguration="tcpConfiguration" contract="EventNotificationService.IEventNotification" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.ResourceLockService/" behaviorConfiguration="authenticationBehavior" binding="netTcpBinding" bindingConfiguration="tcpConfiguration" contract="IS.OMS.ServiceProviders.ResourceLockProvider.IResourceLockService" name="TcpEndpointV2" />
      <!-- Logon Service -->
      <!-- MUST use legacy contract name to support older clients checking in for AppLife updates (5.1.7-5.3.X) -->
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.LogonService/v2/" behaviorConfiguration="authenticationBehavior" binding="netTcpBinding" bindingConfiguration="netTcpLargePackets" contract="LogonService.ILogonService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.SourceService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="netTcpExtraLargePackets" contract="IS.OMS.ServiceProviders.SourceProvider.ISourceService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.SystemAlertService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="netTcpExtraLargePackets" contract="IS.OMS.ServiceProviders.SystemAlertProvider.ISystemAlertService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.WorkflowAlertService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="netTcpExtraLargePackets" contract="IS.OMS.ServiceProviders.WorkflowAlertProvider.IWorkflowAlertService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.EnterpriseConfigurationService/" behaviorConfiguration="authenticationBehavior" binding="netTcpBinding" bindingConfiguration="tcpConfiguration" contract="IS.OMS.ServiceProviders.EnterpriseConfigurationProvider.IEnterpriseConfigurationService" name="TcpEndpointV2" />
      <!-- System Utilities Service -->
      <!-- MUST use legacy contract name to support older clients checking in for AppLife updates (5.3.x-5.4.2) -->
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.SystemUtilitiesService/v2/" behaviorConfiguration="authenticationBehavior" binding="netTcpBinding" bindingConfiguration="netTcpExtraLargePackets" contract="SystemUtilitiesService.ISystemUtilitiesService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.DocumentMetadataService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="netTcpLargePackets" contract="IS.OMS.ServiceProviders.DocumentMetadataProvider.IDocumentMetadataService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.GroupService/" behaviorConfiguration="authenticationBehavior" binding="netTcpBinding" bindingConfiguration="netTcpLargePackets" contract="IS.OMS.ServiceProviders.GroupProvider.IGroupService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.UserService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="netTcpExtraLargePackets" contract="IS.OMS.ServiceProviders.UserProvider.IUserService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.SearchFolderService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="netTcpExtraLargePackets" contract="IS.OMS.ServiceProviders.SearchFolderProvider.ISearchFolderService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.GlobalRoutingRuleService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="netTcpLargePackets" contract="IS.OMS.ServiceProviders.GlobalRoutingRuleProvider.IGlobalRoutingRuleService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.BusinessUnitService/" behaviorConfiguration="authenticationBehavior" binding="netTcpBinding" bindingConfiguration="netTcpExtraLargePackets" contract="IS.OMS.ServiceProviders.BusinessUnitProvider.IBusinessUnitService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.DocumentImportRuleService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="netTcpLargePackets" contract="IS.OMS.ServiceProviders.DocumentImportRuleProvider.IDocumentImportRuleService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.WorkflowService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="netTcpLargePackets" contract="IS.OMS.ServiceProviders.WorkflowProvider.IWorkflowService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/ServiceProviders/IS.WM.Architecture.ServiceProviders.FileTransfer.FileTransferService/get" behaviorConfiguration="authenticationBehavior" binding="netTcpBinding" bindingConfiguration="fileTransferGetBinding" contract="FileTransferService.IFileTransferService" name="fileTransferGetBinding" />
      <endpoint address="net.tcp://localhost:8007/ServiceProviders/IS.WM.Architecture.ServiceProviders.FileTransfer.FileTransferService/put" behaviorConfiguration="authenticationBehavior" binding="netTcpBinding" bindingConfiguration="fileTransferPutBinding" contract="FileTransferService.IFileTransferService" name="fileTransferPutBinding" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.DocumentService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="netTcpExtraLargePackets" contract="IS.OMS.ServiceProviders.DocumentProvider.IDocumentService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.FaxService/" behaviorConfiguration="authenticationBehavior" binding="netTcpBinding" bindingConfiguration="netTcpLargePackets" contract="IS.OMS.ServiceProviders.FaxProvider.IFaxService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.DirectConnectOutboundService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="netTcpLargePackets" contract="IS.OMS.ServiceProviders.DirectConnectOutboundProvider.IDirectConnectOutboundService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.FormPublishingService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="netTcpLargePackets" contract="IS.OMS.ServiceProviders.FormPublishingProvider.IFormPublishingService" name="TcpEndpointV2" />
      <endpoint address="net.tcp://localhost:8007/DocuTrack/ServiceProviders/IS.OMS.ServiceProviders.LongRunningOperationService/" behaviorConfiguration="objectGraphBehavior" binding="netTcpBinding" bindingConfiguration="longRunningBinding" contract="IS.OMS.ServiceProviders.LongRunningOperationProvider.ILongRunningOperationService" name="TcpEndpointV2" />
    </client>
  </system.serviceModel>

</configuration>