    <styleSet name="Dialog.SMS.SendMessage" basedOn="Dialog">
      <styles>
        <style role="Base">
          <states>
            <state name="Normal" fontSize="10" themedElementAlpha="Transparent" />
            <state name="Pressed" backColor="Transparent" borderAlpha="Transparent" backColorDisabled="Transparent" backGradientStyle="None" backHatchStyle="None" />
            <state name="Active" backColor="Transparent" borderColor="Transparent" borderAlpha="Transparent" backGradientStyle="None" backHatchStyle="None" />
            <state name="ReadOnly" borderColor="194, 193, 192" borderAlpha="Opaque" />
            <state name="Checked" backColor="Transparent" borderColor="Transparent" borderAlpha="Transparent" backColorDisabled="Transparent" fontBold="True" backGradientStyle="None" backHatchStyle="None">
              <resources>
                <name>TransparentPixel</name>
              </resources>
            </state>
            <state name="Unchecked" backColor="Transparent" borderColor="Transparent" borderAlpha="Transparent" backColorDisabled="Transparent" backGradientStyle="None" backHatchStyle="None">
              <resources>
                <name>TransparentPixel</name>
              </resources>
            </state>
          </states>
        </style>
        <style role="NullText">
          <states>
            <state name="Normal" borderAlpha="Transparent" backColorDisabled="Transparent">
