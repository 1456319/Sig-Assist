            <state name="HotTracked" backColor="Transparent" borderColor="Transparent" borderAlpha="Transparent" backColorDisabled="Transparent" backGradientStyle="None" backHatchStyle="None" />
            <state name="Pressed" backColor="Transparent" borderColor="Transparent" borderAlpha="Transparent" backColorDisabled="Transparent" backGradientStyle="None" backHatchStyle="None" />
          </states>
        </style>
        <style role="UltraCheckEditor">
          <states>
            <state name="Normal" backColor="Transparent" foreColor="60, 60, 60" backColorDisabled="Transparent" backGradientStyle="None" backHatchStyle="None">
              <imageBackgroundDisabled></imageBackgroundDisabled>
              <resources>
                <name>TransparentPixel</name>
