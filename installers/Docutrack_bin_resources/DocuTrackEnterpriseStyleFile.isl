        <style role="UltraButton">
          <states>
            <state name="Normal" backColor="Transparent" foreColor="60, 60, 60" borderColor="Transparent" borderAlpha="Transparent" backColorDisabled="Transparent" backGradientStyle="None" backHatchStyle="None">
              <resources>
                <name>TransparentPixel</name>
              </resources>
