  <styleSets defaultStyleSet="Default">
    <styleSet name="Default" buttonStyle="FlatBorderless" viewStyle="Standard" useOsThemes="False" useFlatMode="True">
      <componentStyles>
        <componentStyle name="UltraButton" resolutionOrder="ControlThenApplication">
          <properties>
            <property name="UseHotTracking" colorCategory="{Default}">True</property>
          </properties>
        </componentStyle>
        <componentStyle name="UltraCalendarCombo" resolutionOrder="ControlThenApplication" />
        <componentStyle name="UltraCheckEditor" resolutionOrder="ControlThenApplication" useOsThemes="False" />
        <componentStyle name="UltraCombo" resolutionOrder="ControlThenApplication" useOsThemes="False" />
        <componentStyle name="UltraComboEditor" resolutionOrder="ControlThenApplication" />
        <componentStyle name="UltraDockManager">
          <properties>
            <property name="DragIndicatorStyle" colorCategory="{Default}">VisualStudio2008Vista</property>
            <property name="GroupPaneTabStyle" colorCategory="{Default}">Flat</property>
            <property name="UnpinnedTabStyle" colorCategory="{Default}">Flat</property>
          </properties>
        </componentStyle>
        <componentStyle name="UltraExpandableGroupBox">
          <properties>
            <property name="BorderStyle" colorCategory="{Default}">None</property>
            <property name="ExpansionIndicatorCollapsed" colorCategory="{Default}"></property>
            <property name="ExpansionIndicatorExpanded" colorCategory="{Default}"></property>
            <property name="HeaderBorderStyle" colorCategory="{Default}">None</property>
            <property name="ViewStyle" colorCategory="{Default}">Office2007</property>
          </properties>
        </componentStyle>
        <componentStyle name="UltraExplorerBar" useFlatMode="True" />
        <componentStyle name="UltraGrid">
          <properties>
            <property name="GroupByBoxButtonConnectorStyle" colorCategory="{Default}">None</property>
            <property name="HeaderCheckBoxAlignment" colorCategory="{Default}">Left</property>
            <property name="WrapHeaderText" colorCategory="{Default}">False</property>
          </properties>
        </componentStyle>
        <componentStyle name="UltraGroupBox">
          <properties>
            <property name="ViewStyle" colorCategory="{Default}">Office2007</property>
          </properties>
        </componentStyle>
        <componentStyle name="UltraLabel" resolutionOrder="ControlThenApplication">
          <properties>
            <property name="BorderStyleInner" colorCategory="{Default}">None</property>
          </properties>
        </componentStyle>
        <componentStyle name="UltraMonthViewMulti" useFlatMode="True" />
        <componentStyle name="UltraMonthViewSingle" useFlatMode="True" />
        <componentStyle name="UltraNumericEditor" resolutionOrder="ControlThenApplication" />
        <componentStyle name="UltraPrintPreviewControl" useOsThemes="False" useFlatMode="True" />
        <componentStyle name="UltraTabControl" useOsThemes="True" useFlatMode="False">
          <properties>
            <property name="Style" colorCategory="{Default}">Flat</property>
            <property name="UseHotTracking" colorCategory="{Default}">True</property>
          </properties>
        </componentStyle>
        <componentStyle name="UltraTabStripControl" buttonStyle="FlatBorderless" useOsThemes="False" useFlatMode="True">
          <properties>
            <property name="Style" colorCategory="{Default}">Flat</property>
            <property name="UseHotTracking" colorCategory="{Default}">True</property>
          </properties>
        </componentStyle>
        <componentStyle name="UltraTextEditor" resolutionOrder="ControlThenApplication" />
        <componentStyle name="UltraTree" headerStyle="Standard" resolutionOrder="ControlThenApplication">
          <properties>
            <property name="DrawsFocusRect" colorCategory="{Default}">True</property>
          </properties>
        </componentStyle>
      </componentStyles>
      <styles>
        <style role="ActivityIndicator_MarqueeFill">
          <states>
            <state name="Normal" backColor="142, 172, 190" backGradientStyle="None" backHatchStyle="None" />
          </states>
        </style>
        <style role="Base">
          <states>
            <state name="Normal" borderColor="150, 150, 150" fontName="Tahoma" foreColorDisabled="165, 165, 165" fontSize="8" textTrimming="EllipsisCharacter" />
            <state name="Selected" backColor="111, 133, 147" foreColor="White" fontName="Tahoma" fontSize="8" backGradientStyle="None" backHatchStyle="None" />
            <state name="HotTracked" fontName="Tahoma" fontSize="8" />
          </states>
        </style>
        <style role="Button">
