          "content": {
            "size": 460,
            "mimeType": "text/css",
            "text": "#mini-browser {\r\n   max-width: 700px;\r\n   font-size: 9px;\r\n}\r\n\r\n#mini-browser #mb-divider {\r\n   border-top: 1px solid #b1b1b1;\r\n   margin: 3px -5px 3px -5px;\r\n}\r\n\r\n#mini-browser div.mb-entry {\r\n   overflow: hidden;\r\n   padding: 2px;\r\n   white-space: nowrap;\r\n   cursor: pointer;\r\n}\r\n\r\n#mini-browser div.mb-entry:hover {\r\n   background: #aaccff;\r\n}\r\n\r\n/* This is for highlighting matches in messages. */\r\n#mini-browser span.search {\r\n   background: yellow;\r\n}\r\n"
          },
