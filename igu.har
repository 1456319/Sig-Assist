            "mimeType": "text/css",
            "text": ".ANNblock {\r\n background-color:#f3f3f3;\r\n color: #666666;\r\n /*\r\n -moz-box-shadow: 5px 5px 5px #ccc;\r\n -webkit-box-shadow: 5px 5px 5px #ccc;\r\n box-shadow: 5px 5px 5px #ccc;\r\n border-radius: 5px 5px;\r\n border-radius: 5px 5px;\r\n -moz-border-radius: 5px 5px;\r\n -webkit-border-radius: 5px 5px;\r\n */\r\n -moz-box-shadow: 0 2px 2px 0px #888888;\r\n -webkit-box-shadow: 0 2px 2px 0px #888888;\r\n box-shadow: 0 2px 2px 0px #888888;\r\n -moz-border-radius: 4px 4px;\r\n -webkit-border-radius: 4px 4px;\r\n \r\n border: 1px solid #cccccc;\r\n padding-top: 0px;\r\n padding-bottom: 0px;\r\n padding-left: 0.5em;\r\n padding-right: 0.5em;\r\n clear : left;\r\n white-space: pre;\r\n}\r\n\r\n.ANNblock pre.ANNhighlight{\r\n background-color: #dcebf5;\r\n}\r\n\r\n.ANNloopBlock{\r\n position: absolute;\r\n margin-top: -1px;\r\n margin-left: 20px;\r\n padding-left: 0.5em;\r\n padding-right: 0.5em;\r\n border: 1px solid #cccccc;\r\n background-color: inherit;\r\n \r\n -moz-border-radius: 4px 4px;\r\n -webkit-border-radius: 4px 4px;\r\n}\r\n\r\nrect.ANNblock{\r\n fill: #f3f3f3;\r\n stroke: #cccccc; \r\n}\r\n\r\ndiv.annav{\r\n color: #8D8D8D;\r\n top: -15px;\r\n left: 10px;\r\n height: 13px;\r\n padding: 0px 3px 1px 3px;\r\n position: absolute;\r\n background: transparent url('/js/mapper/images/toolbar/bg_button_span.gif') no-repeat -5px -1px;\r\n border-top: 1px solid #cccccc;\r\n border-left: 1px solid #cccccc;\r\n border-right: 1px solid #cccccc;\r\n -moz-border-radius: 3px 3px 0px 0px;\r\n -webkit-border-radius: 3px 3px 0px 0px;\r\n}\r\n\r\ndiv.annav.hover{\r\n color: #444444;\r\n}\r\n\r\ndiv.annav iframe{\r\n left: 0px;\r\n z-index: 1;\r\n}\r\n\r\ndiv.ANNloopBlock div.annav{\r\n position: static;\r\n display: inline-block;\r\n padding-top: 0px;\r\n margin-right: 5px;\r\n border-top: none;\r\n border-bottom: 1px solid #cccccc;\r\n -moz-border-radius: 0px 0px 3px 3px;\r\n -webkit-border-radius: 0px 0px 3px 3px;\r\n}\r\n\r\ndiv.ANNloopBlock div.annav iframe{\r\n left: 6px;\r\n}\r\n\r\nspan.pv{\r\n background-image: none;\r\n background-repeat: no-repeat;\r\n background-position: top left;\r\n cursor: pointer;\r\n}\r\nspan.pv.waiting{\r\n background-image: url(/js/mapper/images/spinner.gif);\r\n opacity: 0.5;             /* Standard style for transparency */\r\n -moz-opacity: 0.5;        /* Transparency for older Mozillas */\r\n filter: alpha(opacity=5); /* For IE */\r\n}\r\nspan.lt{\r\n color: #A22; /* same as lua string */\r\n}\r\nspan.el{ /* elipsis */\r\n color: #666; \r\n}\r\nspan.st{\r\n color: #A22; /* same as lua string */\r\n}\r\nspan.nm{\r\n color: #3A3; /* same as lua number */\r\n}\r\nspan.lc{\r\n color: #B97; /* lua comment */\r\n}\r\nspan.kw{\r\n color: blue; /* same as lua keyword */\r\n}\r\n\r\na.fc{\r\n color: #A000A0;\r\n}\r\na.fc, a.fr{\r\n text-decoration: none;\r\n}\r\na.fc:hover, a.fr:hover{\r\n color: #C45AEC;\r\n}\r\na.fc div, a.fr div{\r\n display: none;\r\n}\r\na.fc img, a.fr img{\r\n position: absolute;\r\n display: none;\r\n}\r\nspan.ufc{ /* untraced function calls */\r\n cursor: help;\r\n}\r\n\r\nspan.sp{\r\n color: green;\r\n}\r\n\r\ndiv.ANNpopup{\r\n position: relative;\r\n background-color: #F5F3E5 !important;\r\n}\r\n\r\n/* Override jQuery UI dialog font size */\r\ndiv.ANNouterPopup, div.ANNouterDockPopup{\r\n font-size: 12px;\r\n}\r\n\r\ndiv.ANNouterPopup .ui-dialog-title{\r\n position: relative;\r\n z-index: 1; /* so it appears in front of the highlight_title div (see below) */\r\n}\r\n\r\ndiv.ANNouterPopup div.highlight_title{\r\n position: absolute;\r\n top: 0px;\r\n bottom: 0px;\r\n left: 0px;\r\n right: 0px;\r\n background-color: #A0CFEC;\r\n -moz-border-radius: 6px;\r\n -webkit-border-radius: 6px;\r\n}\r\n\r\na.ntv{\r\n background-repeat: no-repeat;\r\n background-position: center left;\r\n padding-left: 20px;\r\n padding-top: 1px;\r\n padding-bottom: 1px;\r\n color: black;\r\n cursor: pointer;\r\n text-decoration: none;\r\n}\r\n\r\ndiv.ntv{\r\n background-repeat: no-repeat;\r\n background-position: center left;\r\n padding-left: 20px;\r\n padding-top: 1px;\r\n padding-bottom: 1px;\r\n}\r\n\r\ndiv.ntv.waiting{\r\n background-image: url(/js/mapper/images/spinner.gif);\r\n}\r\n\r\ndiv.ntv.error{\r\n background-image: url('/js/mapper/images/icon_error.gif');\r\n background-position: 2px;\r\n color:#433F38\r\n}\r\n\r\ndiv.ntv.help{\r\n background-image: url('/js/mapper/images/icon_help.gif');\r\n}\r\n\r\ndiv.ntv.error_stack{\r\n background-image: url('/js/mapper/images/error_call_stack.png');\r\n}\r\n\r\na.ntv:hover{\r\n color: blue;\r\n}\r\n\r\na.ntv.waiting{\r\n background-image: url(/js/mapper/images/spinner.gif);\r\n}\r\n\r\na.el, a.el:visited{\r\n color: red;\r\n}\r\n\r\nspan.ok{\r\n color: green !important;\r\n}\r\n\r\npre.ANNhighline{\r\n background-color: #B5EAAA;\r\n}\r\n\r\n/* String popup/dock display */\r\ndiv.view_options{\r\n position: absolute;\r\n left: 0px;\r\n top: 3px;\r\n bottom: 0px;\r\n font-family: Verdana, Geneva, sans-serif;\r\n font-size: 11px;\r\n}\r\n\r\ndiv.view_options div.view_options_title{\r\n color: #888888;\r\n padding: .5em 0 .5em 7px;\r\n}\r\n\r\ndiv.view_options a{\r\n text-decoration: none;\r\n color: black;\r\n display: block;\r\n padding: 0 0 2px 23px;\r\n}\r\n\r\ndiv.view_options a.selected{\r\n background: transparent url(/js/mapper/images/checkmark.gif) no-repeat 8px 2px;\r\n}\r\n\r\ndiv.view_options a.waiting{\r\n background: transparent url(/js/mapper/images/spinner.gif) no-repeat 5px 0px;\r\n}\r\n\r\ndiv.view_options a:hover{\r\n text-decoration: none;\r\n color: #215FA3;\r\n}\r\n\r\ndiv.string_slider{\r\n position: absolute;\r\n left: 110px;\r\n right: 0px;\r\n top: 3px;\r\n bottom: 0px;\r\n z-index: 1;\r\n}\r\n\r\ndiv.content{\r\n position: absolute;\r\n left: 0px;\r\n right: 0px;\r\n top: 0px;\r\n bottom: 0px;\r\n padding: 7px;\r\n overflow: auto;\r\n white-space: pre;\r\n font-family: Monospace,Verdana,Arial,Helvetica,Geneva,Lucida,sans-serif;\r\n}\r\n\r\ndiv.intellisenseHelpData\r\n{\r\n   white-space: normal;\r\n   font-family: \"Trebuchet MS\",Tahoma,Verdana,Arial,sans-serif; \r\n   font-size: 12px; \r\n   margin: 5px; \r\n   color: #333;\r\n}\r\n\r\ndiv.intellisenseHelpData a\r\n{\r\n   color: #215FA3;\r\n}\r\n\r\ndiv.intellisenseHelpData h1\r\n{\r\n   color: #1f79ba; \r\n   font-weight: normal; \r\n   font-size: 20px; \r\n   margin-top: 5px;\r\n}\r\n\r\ndiv.intellisenseHelpData h2\r\n{\r\n   color: #76b73d;\r\n   font-size: 10pt;\r\n   margin: 15px 0px 10px 0px;\r\n}\r\n\r\ndiv.intellisenseHelpData h3\r\n{\r\n   font-size: 9pt;\r\n   margin: 20px 0px 5px 0px;\r\n}\r\n\r\ndiv.intellisenseHelpData div.codeExample {\r\n    border: solid #ccc 1px;\r\n    -moz-border-radius: 5px;\r\n    -webkit-border-radius: 5px;\r\n    border-radius: 5px;\r\n    background-color: #FCFCFC;\r\n    padding: 0px 10px;\r\n\tcolor: #666;\r\n\tdisplay: table; /* shrink wrap the border on codeExample divs */\r\n}\r\n\r\n/* Add spacing between adjacent code example blocks. */\r\ndiv.intellisenseHelpData div.codeExample+div.codeExample {\r\n\tmargin-top: 10px;\r\n}\r\n\r\ntable.Basic {\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n    font-size: 11px;\r\n    empty-cells: show;\r\n    border: solid #ccc 1px;\r\n    -moz-border-radius: 5px;\r\n    -webkit-border-radius: 5px;\r\n    border-radius: 5px;      \r\n}\r\n\r\ntable.Basic td, table.Basic th {\r\n    border-left: 1px solid #ccc;\r\n    border-top: 1px solid #ccc;\r\n    padding: 8px 12px;\r\n    text-align: left;    \r\n}\r\n\r\ntable.Basic th {\r\n    background-color: #CFCFCF;\r\n    background-image: -webkit-gradient(linear, left top, left bottom, from(#E5E5E5), to(#CFCFCF));\r\n    background-image: -webkit-linear-gradient(top, #E5E5E5, #CFCFCF);\r\n    background-image:    -moz-linear-gradient(top, #E5E5E5, #CFCFCF);\r\n    background-image:     -ms-linear-gradient(top, #E5E5E5, #CFCFCF);\r\n    background-image:      -o-linear-gradient(top, #E5E5E5, #CFCFCF);\r\n    background-image:         linear-gradient(top, #E5E5E5, #CFCFCF);\r\n    -webkit-box-shadow: 0 1px 0 rgba(255,255,255,.8) inset; \r\n    -moz-box-shadow:0 1px 0 rgba(255,255,255,.8) inset;  \r\n    box-shadow: 0 1px 0 rgba(255,255,255,.8) inset;        \r\n    border-top: none;\r\n    color: #6C6C6C;\r\n    font-size: 10px;\r\n    text-shadow: 0 1px #DDDDDD;\r\n    font-weight: bold;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.05em;\r\n}\r\n\r\ntable.Basic td:first-child, table.Basic th:first-child {\r\n    border-left: none;\r\n}\r\n\r\ntable.Basic th:first-child {\r\n    -moz-border-radius: 5px 0 0 0;\r\n    -webkit-border-radius: 5px 0 0 0;\r\n    border-radius: 5px 0 0 0;\r\n}\r\n\r\ntable.Basic th:last-child {\r\n    -moz-border-radius: 0 5px 0 0;\r\n    -webkit-border-radius: 0 5px 0 0;\r\n    border-radius: 0 5px 0 0;\r\n}\r\n\r\ntable.Basic th:only-child{\r\n    -moz-border-radius: 5px 5px 0 0;\r\n    -webkit-border-radius: 5px 5px 0 0;\r\n    border-radius: 5px 5px 0 0;\r\n}\r\n\r\ntable.Basic tr:last-child td:first-child {\r\n    -moz-border-radius: 0 0 0 5px;\r\n    -webkit-border-radius: 0 0 0 5px;\r\n    border-radius: 0 0 0 5px;\r\n}\r\n\r\ntable.Basic tr:last-child td:last-child {\r\n    -moz-border-radius: 0 0 5px 0;\r\n    -webkit-border-radius: 0 0 5px 0;\r\n    border-radius: 0 0 5px 0;\r\n}\r\n\r\ntable.Basic tr {\r\n\tbackground: #F2F2F2;\r\n}\r\n\r\ntable.Basic tr:nth-child(2n) {\r\n    background: none repeat scroll 0 0 #FCFCFC;\r\n}\r\n\r\ndiv.intellisenseHelpData code {\r\n\tfont-size: 10pt;\r\n}\r\n\r\ndiv.string_slider div.content{\r\n left: 15px;\r\n}\r\n\r\ndiv.string_slider a.slide_arrow{\r\n position: absolute;\r\n width: 14px;\r\n background: transparent url(/js/mapper/images/arrow-contractable.gif) no-repeat center center;\r\n left: 0px;\r\n top: 5px;\r\n bottom: 5px;\r\n border-right: 1px solid #BBBBBB;\r\n border-left: 1px solid #DDDDDD;\r\n}\r\n\r\ndiv.string_slider.expanded a.slide_arrow{\r\n border-left: none;\r\n background-image: url(/js/mapper/images/arrow-expandable.gif);\r\n}\r\n\r\ndiv.content span.line_cropped_warning {\r\n color: #333;\r\n font-family: Verdana,Arial,Helvetica,Geneva,Lucida,sans-serif;\r\n font-style: italic;\r\n background-color: #DDDED6;\r\n line-height: 0px;\r\n}\r\n\r\ndiv.content div.chunk.empty {\r\n background: transparent url(/js/mapper/images/spinner.gif) repeat-y top left;\r\n}\r\n\r\ndiv.content div.chunk.error {\r\n color: #8E2525;\r\n background-color: #F6CECE;\r\n}\r\n\r\n/* slightly different colors required for dialogs and tabs */\r\ndiv.ANNpopup div.string_slider{\r\n background-color: #F5F3E5;\r\n}\r\ndiv.ANNpopup div.string_slider a.slide_arrow:hover{\r\n background-color: #E9E7D9;\r\n}\r\ndiv.dock_content div.string_slider{\r\n background-color: white;\r\n}\r\ndiv.dock_content div.string_slider a.slide_arrow:hover{\r\n background-color: #EEEEEE;\r\n}\r\n\r\n/* Hex view styles */\r\ndiv.content span.ho    { background-color:#eeefea }\r\ndiv.content span.he    { background-color:#e0e1dd }\r\ndiv.content font.hst   { background-color:#9be0be }\r\ndiv.content font.hctrl { background-color:#93b2dc }\r\ndiv.content font.hnasc { background-color:#ccf2a7 }\r\ndiv.content span.ho, span.he {\r\n display: inline-block;\r\n width: 100%;\r\n}\r\n\r\n/* Error Stack Trace styles */\r\na.ANNest_link, a.ANNest_link:visited{\r\n padding-left: 8px;\r\n text-decoration: none;\r\n color: #15317E;\r\n}\r\n\r\na.ANNest_link:hover{\r\n color: #6698FF;\r\n}\r\n\r\ntable.ANNest{\r\n color: #666;\r\n font: inherit;\r\n border-spacing: 0px;\r\n padding-top: 2px;\r\n}\r\n\r\ntable.ANNest{\r\n width: 100%;\r\n}\r\n\r\ntable.ANNest tr td{\r\n padding-left: 10px;\r\n}\r\n\r\ntable.ANNest tr:nth-child(even){\r\n background-color: #E3E3E3;\r\n}\r\n\r\ntable.ANNest tr:nth-child(odd){\r\n background-color: #EEEEEE;\r\n}\r\n\r\ndiv.ANNest_none{\r\n white-space: normal;\r\n padding-left: 5px;\r\n padding-top: 10px;\r\n}\r\n\r\n.topRightHoverMenu {\r\n    position: relative;\r\n    top: -15px;\r\n    left: -18px;\r\n}\r\n\r\n/* Raise emptyNodeDropdown by 6px to in popups to align it with the bottom\r\n   of the title bar. */\r\n.ANNpopup div.emptyNodeDropdown{\r\n   top: 0px;\r\n}\r\n\r\n"
