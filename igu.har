 = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: To IAH'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: To OH'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: To OKC'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: To VA'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: VA - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: YBR - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Paxit: YBR to MD'] = \n   { \n      SourceType: 'From Translator',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Procare - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Procare Medsure'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['Prod-MyRemediEoe'] = \n   { \n      SourceType: 'From Database',\n      DestType: 'To Channel',\n      HasFilter: false,\n      FilterAfterLogging: false,\n      CountOfViewableDequeue: 0,\n      CountOfDequeue: 0\n   }\n\n   LOGCSchannelInfo['Ric - FW Outbound'] = \n   { \n      SourceType: 'LLP Listener',\n      DestType: 'To Translator',\n      HasFilter: false,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To CL'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To CLT'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To DEN'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To DFW'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To DTW'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To IAH'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To MD'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To NCPDP Interface'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'To Translator',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To OH'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To OKC'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n   LOGCSchannelInfo['To Ric'] = \n   { \n      SourceType: 'From Channel',\n      DestType: 'LLP Client',\n      HasFilter: true,\n      FilterAfterLogging: true,\n      CountOfViewableDequeue: 1,\n      CountOfDequeue: 1\n   }\n\n\n//\n// Row pop-out stuff.\n//\n\nvar LOGCSisChildWindow        = false;\nvar LOGCSlogBrowserGuid       = '7EB6599297D231AEDD0D420284FE1A99'; // valid iff LOGCSisChildWindow == false\nvar LOGCSremoteValidationKey  = 'DBC8A83ECB9BC3A73307A3AB200740BC';\n\nvar LOGCSrowPopoutButtonImage      = 'images/pop-out.gif?ver_hash=571F6291';\nvar LOGCSrowPopoutButtonImageHover = 'images/pop-out-hover.gif?ver_hash=571F6291';\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\r\n\r\nfunction onWindowResize()\r\n{\r\n   resize(VisibleArea);\r\n   DescriptionAreaControl.resizeFrames();\r\n   if (visible('resubmitDialog'))\r\n   {\r\n      LOGCSresizeResubmitDialog();\r\n   }\r\n}\r\n\r\nvar CurrentTableArea = 'parsedTableArea';\r\nvar LogArea, LogTable;\r\nvar ResizeTimeoutId = null;\r\nfunction onLoad()\r\n{\r\n   initLogBrowser();\r\n\r\n   setSelectType(); \r\n\r\n   LogTable = document.getElementById('logTable');\r\n   LogArea  = document.getElementById('logArea');\r\n   resize(LogArea);\r\n   LogArea.onscroll = onScrollLogArea;\r\n   \r\n   window.onresize = function()\r\n   {\r\n      // Some browsers (like Firefox) don't always call the onresize event at the right time.\r\n      // So we will make sure to run the adjustments when the user's mouse stops moving.\r\n      clearTimeout(ResizeTimeoutId);\r\n      ResizeTimeoutId = setTimeout('onWindowResize();', 150);\r\n   }\r\n\r\n   var OnScrollTimeout;\r\n   window.onscroll = function() {\r\n      clearTimeout(OnScrollTimeout);\r\n      OnScrollTimeout = setTimeout(window.onresize, 150);\r\n   }\r\n\r\n   if (navigator.userAgent != null && navigator.userAgent.indexOf('Firefox') !=-1)\r\n   {\r\n      document.onkeypress = onKeyDown;\r\n   }\r\n   else\r\n   {\r\n      document.onkeydown  = onKeyDown;\r\n   }\r\n   \r\n   onSourceChange();\r\n   LOGCSinitialIncludeSourceLogs = false;\r\n   LOGCSinitialDequeueSourceNames = '';\r\n\r\n   // Keeps \"Today\" and \"Yesterday\" labels up to date.  Only call this once\r\n   // before any entries are added; it will periodically call itself.\r\n   //\r\n   updateDates();\r\n\r\n   checkLogUsageBar();\r\n\r\n   setupTimeRangeField('After' , '');\r\n   setupTimeRangeField('Before', '');\r\n   $('.ui-datepicker').draggable();\r\n   var ShowTimeRange = !(document.getElementById('AfterInput' ).value == '' &&\r\n                         document.getElementById('BeforeInput').value == '')\r\n   document.getElementById('ShowTimeRange_local').checked = ShowTimeRange;\r\n   document.getElementById('TimeRangeTable').style.display = (ShowTimeRange ? '' : 'none');\r\n\r\n   // Prep the fancy clear-buttons.\r\n   //\r\n   var ClearProps = {\r\n      'Filter' : { 'EmptyValue' : ''},\r\n      'AfterDateTime_local' : { 'EmptyValue' : InputTimeFormatText, 'OnClickClear' : ClearDateRange['After'] },\r\n      'BeforeDateTime_local' : { 'EmptyValue' : InputTimeFormatText, 'OnClickClear' : ClearDateRange['Before'] }\r\n   }\r\n   for(var FieldName in ClearProps)\r\n   {\r\n      initClearButton(FieldName, ClearProps[FieldName]);\r\n   }\r\n\r\n   \r\n      //\r\n      // This is a normal search of the log, with no particular entry to focus on.\r\n      //\r\n      setFinished('forward', true);\r\n      showMore('reverse');\r\n      \r\n   \r\n   requestDequeueInfo();\r\n   LOGdoHeartBeat();\r\n\r\n   $(\"#alert-dialog\").dialog(\r\n\t\t{\r\n\t\t\tbgiframe: true,\r\n\t\t\tautoOpen: false,\r\n         \t\twidth:350,\r\n\t\t\tmodal: true,\r\n\t\t\tbuttons:{\r\n\t\t\t\t'Close': function() {\r\n\t\t\t\t\t$(this).dialog('close');\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\r\n   var linkDialogOptions = {\r\n\t\t\tbgiframe: true,\r\n\t\t\tautoOpen: false,\r\n\t\t\theight: 200,\r\n\t\t\twidth:500,\r\n\t\t\tmodal: true,\r\n\t\t\tbuttons: {\t\t\t\t\r\n\t\t\t\t'Close': function() {\r\n\t\t\t\t\t$(this).dialog('close');\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t};\r\n\r\n   $(\"#bookmark-dialog\").dialog(linkDialogOptions);\r\n   $(\"#show-link-dialog\").dialog(linkDialogOptions);\r\n   \r\n   LogArea.focus();\r\n\r\n   LOGstartFtsUpdatePoll();\r\n}\r\n\r\nwindow.onbeforeunload = function(){\r\n   TOOLtooltipClose();\r\n}\r\n   \r\n//-->\r\n</script>\r\n\r\n</head>\r\n\r\n<body class=\"tableft\" onLoad=\"onLoad()\">\r\n\r\n\r\n<div id=\"header\" style=\"position:absolute;top:-30px;\">\n\n<script type=\"text/javascript\" src=\"/skinningwindow.js?ver_hash=571F6291\"></script>\n<script type=\"text/javascript\" src=\"/js/ajax/ajax.js?ver_hash=571F6291\"></script>\n  \n<div id=\"logo\"><img src=\"/images/iguana4_logo.gif?ver_hash=571F6291\"/></div>\n\n<div id=\"version\"><a href=\"/version_info.html\">5.6.20</a>\n\n</div>\n\n<div id=\"tabs\">\n   \n      <div id=\"tabs_left\">\n         <ul>\n            \n            \n            \n               \n                  <li><a id=Dashboard href=\"../dashboard.html\"><span>Dashboard</span></a></li>\n               \n            \n            \n               \n                  <li><a id=Logs href=\"../logs.html\" class=\"current\"><span>Logs</span></a></li>\n               \n            \n         </ul>\n      </div>       \n\n      <div id=\"tabs_right\">\n         <ul>\n            \n               \n                  <li><a id=Settings href=\"../advanced.html\"><span>Settings</span></a></li>\n               \n            \n            <!--\n               \n                  <li><a id=About href=\"../about.html\"><span>About</span></a></li>\n               \n            -->\n         </ul>\n      </div>\n      \n</div>\n\n<div id=\"login\">\n\tLogged in as <b>admin</b>. (<a href=\"/login.html\">Logout</a>)\n</div>\n\n<div id=\"help_button\">\n\t<a href=\"http://www.interfaceware.com/manual/iguana.html?v=5.6.20\" target=\"_manual\"></a>\n</div>\n\n<div id=\"change_skin\">\n\n\n</div>\n\n</div>\n<script type=\"text/javascript\">\n/*\nvar AJAXCommandName = 'is_configuration_commit_pending';\n   \nAJAXpost(AJAXCommandName, \"\", \n   function(data)\n   { \n      var Response = eval(data);\n         \n      var IsCommitPending = Response.IsCommitPending;\n            \n      if(IsCommitPending)\n      {\n         document.getElementById(\"configuration_control\").innerHTML = \"<span>Configuration Control <img border=0 src=\\\"../images/icon_error.gif\\\" /></span>\";\n      }\n      else\n      {               \n         document.getElementById(\"configuration_control\").innerHTML = \"<span>Configuration Control</span>\";\n      }    \n   },\n   \n   function(data){}\n);\n*/   \n</script> \n\r\n\r\n<div id=\"main\" style=\"margin-bottom:0\">\r\n\r\n   <table id=\"iguana\">\r\n      <tr>\r\n         <td id=\"cookie_crumb\">\r\n            <table style=\"width:100%; border-collapse:collapse\"><tr>\r\n               <td style=\"padding:0; width:100%;\">\r\n                  Logs\r\n               </td>\r\n               <td align=\"right\" style=\"width:0; padding:0 0 0 12px;\">\r\n                  <span id=\"newMessageCount\" style=\"cursor:pointer; white-space:nowrap\"\r\n                     onclick=\"showLog(); LogArea.scrollTop = 0; clearNewMessageCount();\">\r\n                  </span>\r\n               </td>\r\n               <td id=\"disableRemoteWindows\" align=\"right\" style=\"width:0; padding:0 0 0 12px; display:none;\">\r\n                  <a href=\"#\" class=\"button\"\r\n                        onmouseover=\" TOOLtooltipLink('There may be windows in other sessions viewing the same log entries as this window.<br><br>These windows can be disabled by clicking this button.', null, this);\" \r\n                        onmouseout=\"TOOLtooltipClose();\" \r\n                        onmouseup=\"TOOLtooltipClose();\"\r\n                        onclick=\"javascript:LOGdisableRemoteWindows(); this.blur(); return false;\">\r\n                     <span><img src='images/icon_disable_window.gif?ver_hash=571F6291'> &nbsp;Disable Remote Windows</span>\r\n                  </a>\r\n               </td>\r\n               <td id=\"oldestAndNewestButtons\" align=\"right\" style=\"width:0; padding:3px 0 0 12px;\">\r\n                  <div style=\"white-space:nowrap;\">\r\n                     <img class=\"nav-button\" src=\"/images/log_end.gif?ver_hash=571F6291\"\r\n                          onmouseover=\"javascript:this.src='/images/log_end_hover.gif?ver_hash=571F6291'; TOOLtooltipLink('Display the oldest entry.', undefined, this, { Left: -12 });\"\r\n                          onmouseout =\"javascript:this.src='/images/log_end.gif?ver_hash=571F6291';       TOOLtooltipClose();\"\r\n                          onmousedown=\"javascript:this.src='/images/log_end_active.gif?ver_hash=571F6291';\"\r\n                          onmouseup  =\"javascript:this.src='/images/log_end_hover.gif?ver_hash=571F6291';\"\r\n                          onclick    =\"javascript:LOGdisplayOldestEntry();\" />\r\n                     <img class=\"nav-button\" src=\"/images/log_home.gif?ver_hash=571F6291\"\r\n                          onmouseover=\"javascript:this.src='/images/log_home_hover.gif?ver_hash=571F6291'; TOOLtooltipLink('Display the newest entry.', undefined, this, { Left: -12 });\"\r\n                          onmouseout =\"javascript:this.src='/images/log_home.gif?ver_hash=571F6291';       TOOLtooltipClose();\"\r\n                          onmousedown=\"javascript:this.src='/images/log_home_active.gif?ver_hash=571F6291';\"\r\n                          onmouseup  =\"javascript:this.src='/images/log_home_hover.gif?ver_hash=571F6291';\"\r\n                          onclick    =\"javascript:LOGdisplayNewestEntry();\" />\r\n                  </div>\r\n               </td>\r\n            </tr></table>\r\n         </td>\r\n      </tr>\r\n\r\n      <tr>\r\n         <td>\r\n      \r\n         \r\n            <span id=\"panicFailure\" style=\"display:none\">\r\n         \r\n            <div class=\"error_message\" style=\"margin-bottom:5px\">\r\n               <div class=\"error_heading\">\r\n                  FATAL ERROR\r\n               </div>\r\n               <div class=\"error_text\">\r\n                  <span id=\"panicFailureText\"></span>\r\n                  <br />All channels have been stopped.\r\n                  Please address this issue and restart Iguana.\r\n               </div>\r\n            </div>\r\n         </span>\r\n\r\n         \r\n            <span id=\"lowDiskSpaceMessage\" style=\"display:none\">\r\n         \r\n            <div class=\"warning_message\" style=\"margin-bottom: 5px;\">\r\n               <div class=\"warning_heading\">\r\n                  WARNING\r\n               </div>\r\n               <div class=\"warning_text\">\r\n                  The log partition is running out of space:  remain.\r\n                  \r\n                  Free some space on the partition, or adjust\r\n                  the <a href=\"/log_settings_view.html\" >maximum&nbsp;log&nbsp;age</a>. \r\n                  See <a href=\"/log_usage_statistics\" >Logs&nbsp;&gt;&nbsp;Log Usage</a> for log usage statistics.\r\n               </div>\r\n            </div>\r\n         </span>\r\n      \r\n                  <div id=\"entryView\" style=\"display:none\">\n            <table style=\"width:100%; table-layout:fixed\">\n               <tr><td style=\"padding:0px\">\n                  <table style=\"width:100%; border-collapse:collapse;\"><tr>\n                  \n                     <!-- CHANNEL ICON/NAME TABLE CELL -->\n                     <td align=\"left\" style=\"padding:0px;\">\n                        <div id=\"entryDescription\" style=\"height:36px; white-space:nowrap;\"></div>\n                     </td>\n                  \n                     <!-- BUTTONS TABLE CELL -->\n                     <td>\n                     \n                        <!-- BEGIN DIV CONTAINER FOR BUTTONS -->\n                        <div style=\"float: right; padding-top:1px;\">\n\n                        \n                           <div id=\"entryResubmit\" style=\"padding:0 10px 0 0; float:left\">\n                              <img class=\"button\" onClick=\"showResubmit()\"\n                                 \n    \n        \n    \n    onMouseOver=\"TOOLtooltipLink('Resubmit or forward this message.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n    \n\n                                 src=\"\n    \n        \n    \n    images/log-browser-resubmit.gif?ver_hash=571F6291\n\" />\n                           </div>\n                           <div id=\"entryRelated\" style=\"padding:0 3px 0px 0px; float:left\">\n                              <img class=\"button\" onClick=\"showRelated()\"\n                                 \n    \n    onMouseOver=\"TOOLtooltipLink('Show all entries related to this.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                                 src=\"images/log-browser-related.gif?ver_hash=571F6291\" />\n                           </div>\n                           <div id=\"entryToMapper\" style=\"padding:0 3px 0px 0px; float:left\">\n                              <img class=\"button\" \n    \n    onMouseOver=\"TOOLtooltipLink('Use this message in the Translator editor.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                                 src=\"images/log-browser-to-mapper.gif?ver_hash=571F6291\" />\n                           </div>\n                           <div style=\"padding:0 10px 0 0; float:left\">\n                              <img class=\"button\" onClick=\"showLink()\"\n                                 \n    \n    onMouseOver=\"TOOLtooltipLink('Show me a direct link to this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                                 src=\"images/log-browser-link.gif?ver_hash=571F6291\" />\n                           </div>\n                           <div style=\"padding:0 10px 0 0; float:left\">\n                              <img class=\"button\" onClick=\"downloadMessage()\"\n                                 \n    \n    onMouseOver=\"TOOLtooltipLink('Download this message to a file.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                                 src=\"images/log-browser-save-message.gif?ver_hash=571F6291\" />\n                           </div>\n                        \n                        \n                        \n                        \n                        <div class=\"viewSelectDropdown\" style=\"padding:0 3px 0 0px; float:left;\">\n                           <div class=\"dropdownButtonWrapper\">\n                              <img id=\"logViewSelectDropdownButton\" class=\"ViewDropdownButton\"\n                                 src=\"images/log_views/dropdown-text.gif?ver_hash=571F6291\"\n                                 \n    \n    onMouseOver=\"TOOLtooltipLink('Change the view mode for this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                                 onclick=\"javascript:toggleDropdown('logViewSelectDropdown', 'logViewSelectDropdownButton', CurrentViewMode);\">\n                              </img>\n                           </div>\n                           <div id=\"logViewSelectDropdown\" style=\"display:none; \"\n                                onclick=\"javascript:hideDropdown('logViewSelectDropdown', 'logViewSelectDropdownButton', CurrentViewMode);\">\n                              <a class=\"logViewDropdownOption Hex\" onclick=\"showHex();\" \n    \n    onMouseOver=\"TOOLtooltipLink('View hex-dump of this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>Hex-dump</span>\n                              </a>\n                              <a class=\"logViewDropdownOption Text\" onclick=\"showText();\" \n    \n    onMouseOver=\"TOOLtooltipLink('View plain-text for this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>Plain-text</span>\n                              </a>\n                              <div class=\"logViewDropdownDivider messageOption\" onclick=\"cancelBubble(event);\"></div>\n                              <a class=\"logViewDropdownOption SegmentMessage messageOption\" onclick=\"showParsed('SegmentMessage', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('View segments and composites generated by parse.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>Segment View</span>\n                              </a>\n                              <a class=\"logViewDropdownOption SegmentGrammar parseOption\" onclick=\"showParsed('SegmentGrammar', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('View segment grammar populated with parse results.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>Segment Grammar View</span>\n                              </a>\n                              <div class=\"logViewDropdownDivider parseOption\" onclick=\"cancelBubble(event);\"></div>\n                              <a class=\"logViewDropdownOption Table parseOption\" onclick=\"showParsed('Table', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('View tables generated by complete parse. (Graphical)', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>Table View (Graphical)</span>\n                              </a>\n                              <a class=\"logViewDropdownOption TableText parseOption\" onclick=\"showParsed('TableText', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('View tables generated by complete parse. (Plain-text)', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>Table View (Plain-text)</span>\n                              </a>\n                              <a class=\"logViewDropdownOption SQL parseOption\" onclick=\"showParsed('SQL', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('View SQL statements generated by complete parse.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\n                                 <img /><span>SQL View</span>\n                              </a>\n                           </div>\n                        </div>\n                        \n                        \n                        <div id=\"entryWrapTextControl\" style=\"padding:0 10px 0 0; float:left;\">\n                           <img id=\"wrapText\" class=\"button\"\n                              \n    \n    onMouseOver=\"TOOLtooltipLink('Toggle line-wrapping.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                              src=\"images/log-browser-wrap.gif?ver_hash=571F6291\" />\n                        </div>\n                        <div id=\"entryWrapTextControlGrey\" style=\"padding:0 10px 0 0; float:left; display:none;\">\n                           <img id=\"wrapTextGrey\" class=\"button\"\n                              \n    \n    onMouseOver=\"TOOLtooltipLink('You cannot wrap text in this view mode.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                              src=\"images/log-browser-nowrap-grey.gif?ver_hash=571F6291\" />\n                        </div>\n                        \n                        \n                           <div id=\"entryMarked\" style=\"padding:0 10px 0 0; float:left\">\n                              <img id=\"entryMarkedImg\" class=\"button\" onClick=\"markEntry()\"\n                                 \n    \n    onMouseOver=\"TOOLtooltipLink('Mark/Unmark this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n                                 src=\"images/log-ack-yes?ver_hash=571F6291\" />\n                           </div>\n                        \n                        <!-- END DIV CONTAINER FOR BUTTONS -->\n                        </div>\n                     </td>\n                     \n                     \n                     <!-- DELETE BUTTON CELL -->\n                     <td align=\"right\" style=\"width:30px; padding: 0px;\">\n                        <div id=\"entryDelete\" style=\"display:none; padding:3px 10px 0 0;\">\n                           <img class=\"button\" onClick=\"deleteEntry()\"\n                              \n    \n        \n    \n    onMouseOver=\"TOOLtooltipLink('Delete this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n    \n\n                              src=\"\n    \n        \n    \n    images/log-browser-delete.gif?ver_hash=571F6291\n\" />\n                        </div>\n                        <div id=\"entryUndelete\" style=\"display:none; padding:3px 10px 0 0;\">\n                           <img class=\"button\" onClick=\"undeleteEntry()\"\n                              \n    \n        \n    \n    onMouseOver=\"TOOLtooltipLink('Undelete this entry.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\n    \n\n                              src=\"\n    \n        \n    \n    images/log-browser-undelete.gif?ver_hash=571F6291\n\" />\n                        </div>\n                     </td>\n                     \n                     <!-- NAVIGATION TABLE CELL (Next/Prev/Pop-out/Close) -->\n                     <td align=\"right\" style=\"width:161px; padding: 0px; border-left: 1px solid #d0d1d1;\">\n                        <table style=\"border-collapse:collapse; margin-top:1px;\">\n                           <tr>\n                              <td style=\"padding-right:3px; background:url('/images/log_buttons_bg_left.gif'); background-repeat:no-repeat; background-position:left;\">\n                                 <div style=\"white-space:nowrap; margin-top:0px; padding-top:1px;\">\n                                    <img class=\"nav-button\" id=\"entryPrev\" />\n                                    <img class=\"nav-button\" id=\"entryNext\" />\n                                    <!-- \n                                       <img class=\"nav-button\" id=\"entryPopout\" src=\"/images/msg-pop-out.gif?ver_hash=571F6291\"\n                                       onmouseover=\"javascript:this.src='/images/msg-pop-out-hover.gif?ver_hash=571F6291'; TOOLtooltipLink('View this entry in a new window.', undefined, this, { Left: -12 });\"\n                                       onmouseout =\"javascript:this.src='/images/msg-pop-out.gif?ver_hash=571F6291';       TOOLtooltipClose();\"\n                                       onmousedown=\"javascript:this.src='/images/msg-pop-out-active.gif?ver_hash=571F6291';\"\n                                       onmouseup  =\"javascript:this.src='/images/msg-pop-out-hover.gif?ver_hash=571F6291';\"\n                                       onclick    =\"javascript:LOGpopoutCurrentEntry();\" /> -->\n                                 </div>\n                              </td>\n                              <td style=\"padding-left:3px; background:url('/images/log_buttons_bg_right.gif'); background-repeat:no-repeat; background-position:right;\">\n                                 <div style=\"white-space:nowrap; margin:-1px;\">\n                                    <a class=\"button\" onClick=\"showLog()\"><span>Close</span></a>\n                                 </div>\n                              </td>\n                           </tr>\n                        </table>\n                     </td>\n                     \n                     \n                  </tr></table>\n               </td></tr>\n               <tr><td>\n                  <div id=\"PleaseWaitDiv\" class=\"entryViewPleaseWaitBar\" style=\"position:absolute; visibility:hidden;\">\n                     <-- filled by js-->\n                  </div>\n                  <div id=\"entryArea\" style=\"height:100%;\">\n                     <div class=\"entryViewPleaseWaitBar\">Processing...</div>\n                  </div>\n                  <div id=\"reparseWarning\" style=\"display:none;\">\n                  </div>\n               </td></tr>\n            </table>\n         </div>\n         \n\r\n\r\n         <div id=\"workingProgress\" style=\"width:100%; height:100%; display:none\">\r\n            <table style=\"width:100%; height:100%\"><tr><td align=\"center\" valign=\"center\">\r\n               <div id=\"workingProgressDiv\"></div>\r\n               <div style=\"padding-top:15px\">\r\n                  <img src=\"/images/resubmit-spinner.gif?ver_hash=571F6291\">\r\n               </div>\r\n            </td></tr></table>\r\n         </div>\r\n         <div id=\"logView\">\r\n            <div id=\"logArea\" style=\"width:100%; overflow-x:hidden; overflow-y:scroll\" onmousedown=\"javascript:this.focus();\" tabindex=1>\r\n               <div style=\"text-align:center; width:100%;height:20px; background-color:yellow; display:none;\" id=\"deleteNotify\">\r\n                     <div id=\"deleteStatus\" style=\"font-weight:bold; padding:3px 0 0 0; width:100%;\">\r\n                        <!-- set by ajax -->\r\n                     </div>\r\n               </div>\r\n               <div id=\"noResults\" style=\"position:relative; width:100%; height:100%; display:none\">\r\n\t          <div id=\"noResultsContainer\"\r\n\t\t       style=\"position: absolute; \r\n\t\t              top:50%; \r\n\t\t\t      left: 50%; \r\n\t\t\t      height: 300px;\r\n\t\t\t      margin-top: -150px; \r\n\t\t\t      width: 400px;\r\n\t\t\t      margin-left: -200px\">\r\n                  <div class=\"noResultsString\">No matching entries.</div>\r\n\t\t  <div class=\"searchTermsHelp\" id=\"no_results_search_terms_help\">\r\n\t\t        <p>Tips for text searching:</p>\r\n\t\t\t<ul>\r\n\t\t\t<li>Search for whole words, e.g., \"RADIOLOGY\" instead of \"RADIO\".</li>\r\n\t\t\t<li>Words are separated by any form of punctuation; to find \"JOHN'S\", search for \"JOHN\".</li>\r\n\t\t\t<li>If searching for substrings (e.g., \"RICK\" in \"FREDERICK\") start the search with an exclamation mark (!), e.g., \"!RICK\". This can be a significantly slower search.</li>\r\n\t\t\t<li>Regular expressions can also be used when starting the search with an exclamation mark.</li>\r\n\t\t\t</ul>\r\n\t\t  </div>\r\n\t\t  </div>\r\n               </div>\r\n               <table id=\"logTable\" style=\"width:100%; table-layout:fixed\">\r\n                  <colgroup>\r\n                     <col align=\"center\" style=\"width:13em\">\r\n                     <col>\r\n                  </colgroup>\r\n\r\n                  <tr id=\"forwardProgress\" style=\"background-color:yellow; display:none\">\r\n                     <td align=\"center\" colspan=\"2\">\r\n                        <div id=\"forwardStatus\" style=\"width:100%;\">\r\n                           Searching...\r\n                        </div>\r\n                     </td>\r\n                  </tr>\r\n\r\n                  \r\n\r\n                  <tr id=\"reverseProgress\" style=\"background-color:yellow\">\r\n                     <td align=\"center\" colspan=\"2\">\r\n                        <div id=\"reverseStatus\" style=\"width:100%;\">\r\n                           Searching...\r\n                        </div>\r\n                     </td>\r\n                  </tr>\r\n               </table>\r\n            </div>\r\n         </div>\r\n      </td></tr>\r\n   </table>\r\n   <table style=\"width:100%; margin-top: 0px; margin-bottom: 0px;\">\r\n      <tr>\r\n         <td style=\"width: 65px; padding:0px 0 0 0; cursor:pointer\"\r\n                                                onclick=\"location.href='/log_usage_statistics';\"\r\n                                                onmouseover=\" TOOLtooltipLink(getLogUsageStatistics(), null, document.getElementById('ToolTipRelocate'));\" \r\n                                                onmouseout=\"TOOLtooltipClose();\" \r\n                                                onmouseup=\"TOOLtooltipClose();\" align=right>\r\n            <a href=\"/log_usage_statistics\" class=\"subtle\">Log Usage:</a>\r\n         </td>\r\n         <td style=\"width: 100px;\" align=left><img id=\"ToolTipRelocate\" src=\"images/sort_spacer.gif\" style=\"width:0px;height:0px;position:absolute;left:185px;\">\r\n            <div id=\"ToolTippedCell\" class=\"percent_used_container\" style=\"cursor:pointer\" onclick=\"location.href='/log_usage_statistics'\"\r\n                                                onmouseover=\" TOOLtooltipLink(getLogUsageStatistics(), null, document.getElementById('ToolTipRelocate'));\" \r\n                                                onmouseout=\"TOOLtooltipClose();\" \r\n                                                onmouseup=\"TOOLtooltipClose();\">            \r\n            <img id=\"iguana_usage_bar\" class=\"percent_used\" src=\"/images/percent_bar_green.gif?ver_hash=571F6291\"/><img id=\"other_usage_bar\" class=\"percent_used\" src=\"/images/percent_used.gif?ver_hash=571F6291\"/ ></div>\r\n         </td>\r\n\t <td><div id=\"log_usage_status_panel\" class=\"subtle\"></div>\r\n         </td>\r\n      </tr>\r\n   </table>\r\n</div>\r\n\r\n<!-- START SIDE PANEL -->\r\n<div id=\"side_panel\">\r\n   <form method=\"post\" action=\"/log_browse\" name=\"FilterForm\" id=\"FilterForm\"> \r\n      <input type=\"hidden\" name=\"DebugMode\" value=\"\" >\r\n      <input type=\"hidden\" name=\"RefMsgId\"  value=\"\">\r\n      <iframe id=\"contextWarningFrame\" src=\"/empty.html\" style=\"display:none; position:absolute; width:100%; opacity:0; filter:alpha(opacity=0)\"></iframe>\r\n      <div id=\"contextWarning\" style=\"position:absolute; width:100%; display:none\">\r\n         <table style=\"width:100%; height:100%\"><tr><td align=\"center\" valign=\"center\">\r\n            <div>Context View</div>\r\n            <table style=\"opacity:100; filter:alpha(opacity=100)\"><tr><td>\r\n               <a class=\"button\" onClick=\"hideRelated()\"><span>Close</span></a>\r\n            </td></tr></table>\r\n         </td></tr></table>\r\n      </div>\r\n      <table id=\"side_table\" style=\"z-index:10\">\r\n         <tr onClick=\"showSearch()\" style=\"cursor:pointer\"><th id=\"side_header\">\r\n            <div id=\"searchBarOpen\" class=\"toggle\">[-]</div>\r\n            <div id=\"searchBarClosed\" class=\"toggle\" style=\"display:none\">[+]</div>\r\n            Search Criteria\r\n         </th></tr>\r\n         <tr><td class=\"side_body\"><div id=\"searchBar\" class=\"side_body_div\">\r\n            <div id=\"searchMismatch\" style=\"display:none\">\r\n               <img src=\"/images/icon_warning.gif?ver_hash=571F6291\" />\r\n               This query does not match the entry shown.\r\n            </div>\r\n\r\n            <h4 class=\"side_title\">Text Query</h4>\r\n            <div>\r\n               <table style=\"width:auto; border-collapse:collapse\"><tr>\r\n                  <td style=\"padding-left:0px;\">\r\n                     <table style=\"padding:0; background:white; border:1px solid #BBBBBB; border-collapse:collapse\"><tr>\r\n                        <td style=\"width:12px; padding:0 2px 0 2px\">\r\n                           <img src=\"/images/icon_search.gif?ver_hash=571F6291\" style=\"margin-top:1px\" />\r\n                        </td>\r\n                        <td style=\"padding:0\">\r\n                           <input name=\"Filter\" id=\"filterInput\" value=\"\" style=\"width:135px; border-style:none; outline:none;\" onChange=\"hideDeleteNotify();\"/>\r\n                        </td>\r\n                        <td style=\"width:12px; padding:0 2px 0 2px\">\r\n                           <img id=\"clearFilter\" src=\"images/ex14.gif?ver_hash=571F6291\" style=\"margin-top:1px; cursor:pointer; visibility:hidden\" />\r\n                        </td>\r\n                     </tr></table>\r\n                  </td>\r\n                  <td style=\"padding:0\">\r\n                     <a id=\"textQueryHelpIcon\" class=\"helpIcon\" tabindex=\"100\"\r\n                        rel=\"<p>Use the <strong>Text Query</strong> field to narrow down your search with specific text matching. You can include multiple words, exclude words, or use regular expressions to filter search results.</p>\n\n<p>For example, this text query combines Boolean and regex syntax to perform a very specific search:</p>\n\n<p style=&quot;white-space:nowrap;&quot;><strong>ADT NOT (A03 OR A11) -ZID /Sm(i|y)th(e?)/</strong></p>\n\n<p>This search will find log entries that contain <strong>ADT</strong> but will skip those containing <strong>A03</strong>, <strong>A11</strong> or <strong>ZID</strong>.  Search results will not include patient discharges (A03), cancelled patient admits (A11), or messages that include the custom segment ZID.</p>\n\n<p>In addition, this search will only find records containing the name &quot;Smith&quot; and its alternate spellings (<strong>Smith</strong>, <strong>Smyth</strong>, <strong>Smythe</strong>, or <strong>Smithe</strong>).</p>\r\n                             <a href=&quot;http://www.interfaceware.com/manual/iguana4_searching_the_logs.html?v=5.6.20&quot; target=&quot;_blank&quot;>Learn More About Searching the Logs</a>\r\n                             <br><a href=&quot;http://www.interfaceware.com/manual/using_regex_metacharacters.html?v=5.6.20&quot; target=&quot;_blank&quot;>Learn More About Regular Expressions</a></br>\"\r\n                        title=\"Text Query Syntax\" href=\"#\" onclick=\"initializeHelp(this,event);\">\r\n                        <img src=\"/images/help_icon.gif?ver_hash=571F6291\" style=\"margin-top:1px\" border=\"0\" />\r\n                     </a>\r\n                  </td>\r\n               </tr></table>\r\n               <div id=\"queryError\" style=\"display:none\">\r\n                  <img src=\"/images/icon_warning.gif?ver_hash=571F6291\" />\r\n                  <span id=\"queryErrorText\"></span>\r\n               </div>\r\n            </div>\r\n\r\n            <h4 class=\"side_title\">Channel</h4>\r\n            <select name=\"Source\" id=\"SourceInput\" style=\"width:100%\" onChange=\"onSourceChange(); hideDeleteNotify(); refreshSearch()\" class=\"hidden\">\r\n               \r\n               \r\n                  \r\n                     <option value=\"\" selected>[All Entries]</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\" Iguana\">[Service Entries]</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Channel Manager\">Channel Manager</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"CL - FW Outbound\">CL - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"CLT - FW Outbound\">CLT - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"DEN - FW Outbound\">DEN - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"DFW - FW Outbound\">DFW - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"DONOTSTART ErrChnl Restore Msg\">DONOTSTART ErrChnl Restore Msg</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"DONOTSTART: Error Channel\">DONOTSTART: Error Channel</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"DTW - FW Outbound\">DTW - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"FailOver\">FailOver</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"IAH - FW Outbound\">IAH - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Iguana Monitor\">Iguana Monitor</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"MD - FW Outbound\">MD - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"MessageBroker\">MessageBroker</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"OH - FW Outbound\">OH - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"OKC - FW Outbound\">OKC - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: CLT - FW Outbound\">Paxit: CLT - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: CLV - FW Outbound\">Paxit: CLV - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: CLV to Clev\">Paxit: CLV to Clev</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: DTW - FW Outbound\">Paxit: DTW - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: IAH - FW Outbound\">Paxit: IAH - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: OH - FW Outbound\">Paxit: OH - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: OKC - FW Outbound\">Paxit: OKC - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: To DTW\">Paxit: To DTW</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: To IAH\">Paxit: To IAH</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: To OH\">Paxit: To OH</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: To OKC\">Paxit: To OKC</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: To VA\">Paxit: To VA</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: VA - FW Outbound\">Paxit: VA - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: YBR - FW Outbound\">Paxit: YBR - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Paxit: YBR to MD\">Paxit: YBR to MD</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Procare - FW Outbound\">Procare - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Procare Medsure\">Procare Medsure</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Prod-MyRemediEoe\">Prod-MyRemediEoe</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"Ric - FW Outbound\">Ric - FW Outbound</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To CL\">To CL</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To CLT\">To CLT</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To DEN\">To DEN</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To DFW\">To DFW</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To DTW\">To DTW</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To IAH\">To IAH</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To MD\">To MD</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To NCPDP Interface\">To NCPDP Interface</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To OH\">To OH</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To OKC\">To OKC</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                  \r\n                     <option value=\"To Ric\">To Ric</option>\r\n                  \r\n               \r\n               \r\n            </select>\r\n\r\n            <div id=\"includeSourceLogsDiv\" style=\"display:none; padding:0 0 0 0;\">\r\n            <table style=\"width:auto; border-collapse:collapse\">\r\n               <tr><td style=\"padding:0;\">\r\n               <h4 class=\"side_title\">Source Channels</h4>\r\n               </td><td style=\"padding:0 2 0 0; height: 5px; text-align: center;\">\r\n                     <a id=\"textQueryHelpIcon\" class=\"helpIcon\" tabindex=\"100\"\r\n                        rel=\"The selected channel has a 'From Channel' component. <p>Select the source channels here to include messages from those channels. <p>'Go to Source Position' may be clicked only if one source channel is selected.\"\r\n                        title=\"Source Channels\" href=\"#\" onclick=\"initializeHelp(this,event);\">\r\n                        <img src=\"/images/help_icon.gif?ver_hash=571F6291\" style=\"margin-top:1px\" border=\"0\" />\r\n                     </a>\r\n               </td></tr>\r\n           </table>\r\n               <div id=\"DequeueSourceNameDiv\" style=\"width:100%; padding:0 0 0 0\"><!-- filled by js --></div>\r\n            </div>\r\n\r\n            <div id=\"JumpToQueueEndDiv\" style=\"display:none;\" >\r\n              <a href=\"#\" onClick=\"jumpToQueueEnd(); return false;\">Go to Source Position</a>\r\n            </div>\r\n\r\n            <table style=\"width:100%; border-collapse:collapse\">\r\n               <tr style=\"padding: 0 0 0 0;\">\r\n               <td class=\"side_title\" style=\"padding: 0 0 0 0; width: 80px;\">\r\n                  <h4 class=\"side_title\">Time Range</h4>\r\n               </td>\r\n               <td style=\"padding: 6px 0 0 0; text-align: left;\">\r\n                  <input type=\"checkbox\" name=\"ShowTimeRange_local\" id=\"ShowTimeRange_local\" class=\"no_style\" onchange=\"showTimeRange()\" onclick=\"showTimeRange()\" onkeyup=\"showTimeRange()\">\r\n               </td>\r\n\t       <td style=\"padding: 6px 0 0 0; text-align:right\">\r\n                   <a id=\"dateQueryHelpIcon\" class=\"helpIcon\" tabindex=\"100\"\r\n                        rel=\"This limits messages to the given time range. Example date/times: \r\n\t\t\t<ul>\r\n\t\t\t<li>-1 h (1 hour ago)</li>\r\n\t\t\t<li>-1 min (1 minute ago)</li>\r\n\t\t\t<li>now</li>\r\n\t\t\t<li>yesterday</li>\r\n\t\t\t<li>6/4/2005 22:30:45</li>\r\n\t\t\t</ul>\r\n\t\t\t\"\r\n                        title=\"Time Range\" href=\"#\" onclick=\"initializeHelp(this,event);\">\r\n                        <img src=\"/images/help_icon.gif?ver_hash=571F6291\" style=\"margin-top:1px\" border=\"0\" />\r\n                   </a>\r\n                </td>\r\n            </tr>\r\n            </table>\r\n            <table class=\"timeRange\" style=\"display: none;\" id=\"TimeRangeTable\">\r\n               <tr>\r\n                  <td class='timeLabel' valign=\"top\">from</td>\r\n                  <td style=\"padding: 0 0 5px 0\">\r\n                  <table class=\"timeRangeField\">\r\n\t\t     <tr>\r\n                     <td class=\"left_cell\"><input type='text' class='DateTimeField' name='AfterDateTime_local' id='AfterDateTime_local'/></td>\r\n                     <td class=\"mid_cell\"><img id=\"clearAfterDateTime_local\" src=\"images/ex14.gif?ver_hash=571F6291\" style=\"margin-top:1px; cursor:pointer; visibility:hidden\" /></td>\r\n\t\t     <td class=\"right_cell\"><img style=\"float:right\" id=\"calendarImgAfter\" src=\"images/calendar.gif?ver_hash=571F6291\"></td>\r\n                     </tr>\r\n                  </table>\r\n\t\t  <div class='DateTimePreview' style=\"display: none\" id='AfterDateTimePreview'></div>\r\n\t\t  </td>\r\n                  <td><input type='hidden' name='After' id='AfterInput' value=''/></td>\r\n               </tr>\r\n               <tr>\r\n                  <td class='timeLabel' valign=\"top\">to</td>\r\n                  <td>\r\n                  <table class=\"timeRangeField\">\r\n\t\t     <tr>\r\n                     <td class=\"left_cell\"><input type='text' class='DateTimeField' name='BeforeDateTime_local' id='BeforeDateTime_local'/></td>\r\n                     <td class=\"mid_cell\"><img id=\"clearBeforeDateTime_local\" src=\"images/ex14.gif?ver_hash=571F6291\" style=\"margin-top:1px; cursor:pointer; visibility:hidden\" /></td>\r\n\t\t     <td class=\"right_cell\"><img style=\"float:right\" id=\"calendarImgBefore\" src=\"images/calendar.gif?ver_hash=571F6291\"></td>\r\n                     </tr>\r\n                  </table>\r\n\t\t  <div class='DateTimePreview' style=\"display: none\" id='BeforeDateTimePreview'></div>\r\n\t\t  </td>\r\n                  <td style='padding:0px;'><input type='hidden' name='Before' id='BeforeInput' value=''/></td>\r\n               </tr>\r\n            </table>\r\n\r\n            <h4 class=\"side_title\">Type</h4>\r\n            <select MULTIPLE size=6 name=\"Type\" id=\"Type\" onChange=\"hideDeleteNotify();refreshSearch();\"  class=\"hidden\" style=\"width:195px;\">\r\n               \r\n               \r\n                  \r\n                     <option value=\"\" selected>All</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"messages\">Messages</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"ack_messages\">ACK Messages</option>\r\n                  \r\n               \r\n               \r\n               \r\n                  \r\n                     <option value=\"errors_marked\">Errors - Marked</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"errors_unmarked\">Errors - Unmarked</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"warnings\">Warnings</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"successes\">Successes</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"info\">Informational</option>\r\n                  \r\n               \r\n               \r\n                  \r\n                     <option value=\"debug\">Debug</option>\r\n                  \r\n               \r\n               \r\n            </select>\r\n\r\n            <p><select name=\"Deleted\" id=\"Deleted\" onChange=\"hideDeleteNotify(); refreshSearch();\" style=\"width:195px;\">\r\n               <option value=\"false\"  >Hide Deleted</option>\r\n               <option value=\"both\" selected >Show Deleted</option>\r\n               <option value=\"true\"  >Show Only Deleted</option>\r\n            </select></p>\r\n            \r\n            <table id=\"saveButtonView\" style=\"width:100%\">\r\n               <tr><td align=\"right\" style=\"padding:10px 0 0 0\">\r\n                  \r\n                     <a class=\"button\" style=\"float:right;\" onClick=\"saveSearchLink('search');\"><span><img src=\"../images/icon_save.gif?ver_hash=571F6291\" /> &nbsp;Bookmark Search</span></a>\r\n                  \r\n               </td></tr>\r\n            </table>\r\n            </h4>\r\n\r\n         </div></td></tr>\r\n         <tr onClick=\"hideDeleteNotify(); showExport()\" style=\"cursor:pointer\"><th class=\"side_header\">\r\n            <div id=\"exportBarOpen\" class=\"toggle\" style=\"display:none\">[-]</div>\r\n            <div id=\"exportBarClosed\" class=\"toggle\">[+]</div>\r\n            Export\r\n         </th></tr>\r\n         <tr><td class=\"side_body\"><div id=\"exportBar\" style=\"display:none\" class=\"side_body_div\">\r\n\r\n            \r\n\r\n            <h4 class=\"side_title\">Format</h4>\r\n            \r\n               <input type=\"radio\" class=\"no_style\" id=\"Export.Format\" name=\"Export.Format\" value=\"Plain\"\r\n                      checked>\r\n               <span onClick=\"this.previousSibling.previousSibling.click();\">\r\n                  One entry per line.\r\n               </span><br />\r\n            \r\n            \r\n               <input type=\"radio\" class=\"no_style\" id=\"Export.Format\" name=\"Export.Format\" value=\"Annotated\"\r\n                      >\r\n               <span onClick=\"this.previousSibling.previousSibling.click();\">\r\n                  An annotated text file.\r\n               </span><br />\r\n            \r\n            \r\n               <input type=\"radio\" class=\"no_style\" id=\"Export.Format\" name=\"Export.Format\" value=\"CSV\"\r\n                      >\r\n               <span onClick=\"this.previousSibling.previousSibling.click();\">\r\n                  A CSV file.\r\n               </span><br />\r\n            \r\n\r\n            <h4 class=\"side_title\">Options</h4>\r\n            <input type=\"hidden\"   name=\"Export.Plan\" value=\"\" />\r\n            <input type=\"checkbox\"  class=\"no_style\" name=\"Export.Related\" id=\"Export.Related\"\r\n               >\r\n            <span onClick=\"this.previousSibling.previousSibling.click();\">\r\n               Related messages.\r\n            </span>\r\n            <br />\r\n\r\n            <table id=\"exportProgressView\" style=\"width:100%; margin:10px 0 0 0; display:none\">\r\n               <tr><td id=\"exportProgressArea\" style=\"padding:0; border:1px solid #757671\">\r\n                  <img id=\"exportProgress\" class=\"progress_bar\" style=\"width:0px\"\r\n                       src=\"/images/pulsing_progress_bar.gif?ver_hash=571F6291\" />\r\n               </td></tr>\r\n            </table>\r\n            <table id=\"exportButtonView\" style=\"width:100%\">\r\n               <tr><td align=\"right\" style=\"padding:10px 0 0 0\">\r\n                     <a class=\"button\" style=\"float:right\" onClick=\"hideDeleteNotify(); exportSearch()\"><span>Export</span></a>\r\n               </td></tr>\r\n            </table>\r\n            <table style=\"width:100%\">\r\n               <tr>\r\n               <td align=\"right\" style=\"padding:10px 0 0 0\">\r\n                  <a id=\"export-to-mapper\" class=\"button\" style=\"float:right\"\r\n                     ><span>Export to Translator</span></a>\r\n            </table>\r\n            <table id=\"saveButtonViewTwo\" style=\"width:100%\">\r\n               <tr><td align=\"right\" style=\"padding:10px 0 0 0\">\r\n                  \r\n                     <a class=\"button\" style=\"float:right;\" onClick=\"saveSearchLink('export');\"><span><img src=\"../images/icon_save.gif?ver_hash=571F6291\" /> &nbsp;Bookmark Export</span></a>\r\n                  \r\n               </td></tr>\r\n            </table>\r\n         </div></td></tr>\r\n      </table>\r\n\r\n      <table id=\"side_table\" style=\"z-index:10\">\r\n         <tr><th id=\"side_header\">\r\n            Help Links\r\n         </th></tr>\r\n         <tr><td id=\"side_body\" style=\"padding-top:15px\">\r\n            <ul class=\"help_link_icon\" style=\"margin:0\">\r\n               <li>\r\n               <a href=\"http://www.interfaceware.com/manual/iguana4_viewing_logs.html?v=5.6.20\" target=\"_blank\">Viewing the Logs</a>\r\n               </li>\r\n               <li>\r\n               <a href=\"http://www.interfaceware.com/manual/iguana4_exporting_the_logs.html?v=5.6.20\" target=\"_blank\">Exporting the Logs</a>\r\n               </li>\r\n            </ul>\r\n         </td></tr>\r\n      </table>\r\n\r\n   </form>\r\n</div>\r\n<!-- END SIDE PANEL -->\r\n\r\n\n   <div id=\"helpTooltipDiv\" class=\"helpTooltip\" style=\"zoom:1\">\n      <b id=\"helpTooltipTitle\" onClick=\"$('#helpTooltipDiv').fadeOut('slow');\"></b>\n      <em id=\"helpTooltipBody\"></em>\n      <input type=\"hidden\" id=\"helpTooltipId\" value=\"0\" />\n   </div>\n\r\n\r\n<div id=\"repo-dialog\" style=\"display:none\" title=\"Reposition Channel\"></div>\r\n\r\n<div id=\"bookmark-dialog\" title=\"Bookmark This URL\" style=\"display:none;\">\r\n   <div id=\"bookmark-text\"></div>\r\n\t<fieldset>\r\n\t\t<label for=\"bookmarkLink\"><b>URL:</b></label>\r\n\t\t<input type=\"text\" name=\"bookmarkLink\" id=\"bookmarkLink\" class=\"text ui-widget-content ui-corner-all\" />\t\t\r\n\t</fieldset>\r\n</div>\r\n\r\n<div id=\"show-link-dialog\" title=\"Link To This Message\" style=\"display:none;\">\r\n   <div id=\"show-link-dialog-text\"></div>\r\n\t<fieldset>\r\n\t\t<label for=\"messageLink\"><b>URL:</b></label>\r\n\t\t<input type=\"text\" name=\"messageLink\" id=\"messageLink\" class=\"text ui-widget-content ui-corner-all\" />\t\t\r\n\t</fieldset>\r\n</div>\r\n\r\n\r\n<div id=\"alert-dialog\" title=\"Alert\" style=\"display:none;\">\r\n   <div id=\"alert-dialog-text\"></div>\r\n</div>\r\n\r\n<iframe id=\"resubmitFrame\" src=\"/empty.html\" style=\"display:none;\">\r\n</iframe>\r\n\r\n<div id=\"resubmitDialog\" style=\"display:none;\">\r\n\r\n   <div id=\"resubmitTopControls\" style=\"width:100%; float:left;\">\r\n      <div style=\"float:left;\">\r\n         Resubmit To Channel:\r\n         <select id=\"Destination\" name=\"Destination\" onchange=\"onPreviewDestinationChanged(this);\">\r\n            \n   <option value=\"\">[Choose Channel]</option>\n\r\n            \r\n               \n   <option value=\"Channel Manager\">Channel Manager</option>\n\r\n            \r\n               \n   <option value=\"CL - FW Outbound\">CL - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"CLT - FW Outbound\">CLT - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"DEN - FW Outbound\">DEN - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"DFW - FW Outbound\">DFW - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"DONOTSTART ErrChnl Restore Msg\">DONOTSTART ErrChnl Restore Msg</option>\n\r\n            \r\n               \n   <option value=\"DONOTSTART: Error Channel\">DONOTSTART: Error Channel</option>\n\r\n            \r\n               \n   <option value=\"DTW - FW Outbound\">DTW - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"FailOver\">FailOver</option>\n\r\n            \r\n               \n   <option value=\"IAH - FW Outbound\">IAH - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Iguana Monitor\">Iguana Monitor</option>\n\r\n            \r\n               \n   <option value=\"MD - FW Outbound\">MD - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"MessageBroker\">MessageBroker</option>\n\r\n            \r\n               \n   <option value=\"OH - FW Outbound\">OH - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"OKC - FW Outbound\">OKC - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: CLT - FW Outbound\">Paxit: CLT - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: CLV - FW Outbound\">Paxit: CLV - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: CLV to Clev\">Paxit: CLV to Clev</option>\n\r\n            \r\n               \n   <option value=\"Paxit: DTW - FW Outbound\">Paxit: DTW - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: IAH - FW Outbound\">Paxit: IAH - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: OH - FW Outbound\">Paxit: OH - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: OKC - FW Outbound\">Paxit: OKC - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: To DTW\">Paxit: To DTW</option>\n\r\n            \r\n               \n   <option value=\"Paxit: To IAH\">Paxit: To IAH</option>\n\r\n            \r\n               \n   <option value=\"Paxit: To OH\">Paxit: To OH</option>\n\r\n            \r\n               \n   <option value=\"Paxit: To OKC\">Paxit: To OKC</option>\n\r\n            \r\n               \n   <option value=\"Paxit: To VA\">Paxit: To VA</option>\n\r\n            \r\n               \n   <option value=\"Paxit: VA - FW Outbound\">Paxit: VA - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: YBR - FW Outbound\">Paxit: YBR - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Paxit: YBR to MD\">Paxit: YBR to MD</option>\n\r\n            \r\n               \n   <option value=\"Procare - FW Outbound\">Procare - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"Procare Medsure\">Procare Medsure</option>\n\r\n            \r\n               \n   <option value=\"Prod-MyRemediEoe\">Prod-MyRemediEoe</option>\n\r\n            \r\n               \n   <option value=\"Ric - FW Outbound\">Ric - FW Outbound</option>\n\r\n            \r\n               \n   <option value=\"To CL\">To CL</option>\n\r\n            \r\n               \n   <option value=\"To CLT\">To CLT</option>\n\r\n            \r\n               \n   <option value=\"To DEN\">To DEN</option>\n\r\n            \r\n               \n   <option value=\"To DFW\">To DFW</option>\n\r\n            \r\n               \n   <option value=\"To DTW\">To DTW</option>\n\r\n            \r\n               \n   <option value=\"To IAH\">To IAH</option>\n\r\n            \r\n               \n   <option value=\"To MD\">To MD</option>\n\r\n            \r\n               \n   <option value=\"To NCPDP Interface\">To NCPDP Interface</option>\n\r\n            \r\n               \n   <option value=\"To OH\">To OH</option>\n\r\n            \r\n               \n   <option value=\"To OKC\">To OKC</option>\n\r\n            \r\n               \n   <option value=\"To Ric\">To Ric</option>\n\r\n            \r\n         </select>\r\n      </div>\r\n      <div style=\"padding-top: 10px; float: left;\" id=\"resubmit_dest_help_note\"></div>\r\n      <div style=\"float:right;\" class=\"resubmit_toolbar_heading\">\r\n         <a href=\"#\" onClick=\"javascript:hideResubmit(); return false;\">\r\n            <img src=\"images/close_button.gif?ver_hash=571F6291\" style=\"border:none;\"/>\r\n         </a>\r\n      </div>\r\n   </div>\r\n   \r\n   <div id=\"resubmitEditControls\" class=\"resubmit_toolbar_heading\" style=\"width:100%; float:left; padding-left:16px;\">\r\n      <a id=\"toggleResubmitEditLink\" href=\"#\" onclick=\"javascript:toggleResubmitEdit(); return false;\">[+] Edit</a>\r\n   </div>\r\n\r\n   <div id=\"resubmitEdit\" style=\"width:100%; float:left; padding-left:16px;\">\r\n      <textarea id=\"messageEditor\" wrap=\"off\"\r\n         onkeyup=\"javascript:onResubmitMessageEditorChange();\">\r\n      </textarea>\r\n   </div>\r\n   \r\n   <div id=\"resubmitPreviewControls\" style=\"width:100%; float:left; padding-bottom:2px;\">\r\n      <div style=\"float:left; padding-top:5px; padding-left:16px;\" class=\"resubmit_toolbar_heading\">\r\n         <a id=\"toggleResubmitPreviewLink\" href=\"#\" onclick=\"javascript:toggleResubmitPreview(); return false;\">[+] Preview</a>\r\n      </div>\r\n      <div id=\"resubmitPreviewProgress\" style=\"float:left; padding-left:10px;\">\r\n         <img src=\"images/spinner.gif?ver_hash=571F6291\"/>\r\n      </div>\r\n      <div id=\"previewWrapTextControl\" style=\"padding:0 16px 0 0; float:right;\">\r\n         <img id=\"previewWrapText\" class=\"button\"\r\n            \n    \n    onMouseOver=\"TOOLtooltipLink('Toggle line-wrapping.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\r\n            src=\"images/log-browser-nowrap.gif?ver_hash=571F6291\" />\r\n      </div>\r\n      <div id=\"previewWrapTextControlGrey\" style=\"padding:0 16px 0 0; float:right; display:none;\">\r\n         <img id=\"previewWrapTextGrey\" class=\"button\"\r\n            \n    \n    onMouseOver=\"TOOLtooltipLink('You cannot wrap text in this view mode.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\r\n            src=\"images/log-browser-nowrap-grey.gif?ver_hash=571F6291\" />\r\n      </div>\r\n      <div id=\"entryPreviewViewControlContainer\" style=\"float:right; padding-right:3px;\">\r\n         <div class=\"dropdownButtonWrapper\">\r\n            <img id=\"logPreviewSelectDropdownButton\" class=\"ViewDropdownButton\"\r\n               src=\"images/log_views/dropdown-text.gif?ver_hash=571F6291\"\r\n               \n    \n    onMouseOver=\"TOOLtooltipLink('Change the preview mode for this message.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n\r\n               onclick=\"javascript:toggleDropdown('logPreviewSelectDropdown', 'logPreviewSelectDropdownButton', CurrentPreviewMode);\">\r\n            </img>\r\n         </div>\r\n         <div id=\"logPreviewSelectDropdown\" style=\"display:none; right:49px;\"\r\n            onclick=\"javascript:hideDropdown('logPreviewSelectDropdown', 'logPreviewSelectDropdownButton', CurrentPreviewMode);\">\r\n            <a class=\"logViewDropdownOption Hex\" onclick=\"showHexPreview(false);\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview hex-dump of this message.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Hex-dump</span>\r\n            </a>\r\n            <a class=\"logViewDropdownOption Text\" onclick=\"showTextPreview(false);\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview plain-text for this message.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Plain-text</span>\r\n            </a>\r\n            <div class=\"logViewDropdownDivider messageOption\" onclick=\"cancelBubble(event);\"></div>\r\n            <a class=\"logViewDropdownOption SegmentMessage messageOption\" onclick=\"showParsedPreview('SegmentMessage', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview segments and composites generated by parse.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Segment View</span>\r\n            </a>\r\n            <a class=\"logViewDropdownOption SegmentGrammar parseOption\" onclick=\"showParsedPreview('SegmentGrammar', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview segment grammar populated with parse results.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Segment Grammar View</span>\r\n            </a>\r\n            <div class=\"logViewDropdownDivider parseOption\" onclick=\"cancelBubble(event);\"></div>\r\n            <a class=\"logViewDropdownOption Table parseOption\" onclick=\"showParsedPreview('Table', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview tables generated by complete parse. (Graphical)', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Table View (Graphical)</span>\r\n            </a>\r\n            <a class=\"logViewDropdownOption TableText parseOption\" onclick=\"showParsedPreview('TableText', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview tables generated by complete parse. (Plain-text)', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Table View (Plain-text)</span>\r\n            </a>\r\n            <a class=\"logViewDropdownOption SQL parseOption\" onclick=\"showParsedPreview('SQL', 'Preserve');\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview SQL statements generated by complete parse.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>SQL View</span>\r\n            </a>\r\n            <div class=\"logViewDropdownDivider pluginOption\" onclick=\"cancelBubble(event);\"></div>\r\n            <a class=\"logViewDropdownOption PluginOutput pluginOption\" onclick=\"showPluginOutputPreview(false);\" \n    \n    onMouseOver=\"TOOLtooltipLink('View the plugin resubmission preview.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Plugin Output</span>\r\n            </a>\r\n            <div class=\"logViewDropdownDivider mapperOption\" onclick=\"cancelBubble(event);\"></div>\r\n            <a class=\"logViewDropdownOption MapperOutput mapperOption\" onclick=\"LOGshowMapperOutputPreview(false);\" \n    \n    onMouseOver=\"TOOLtooltipLink('Preview the output generated by the translator.', undefined,\n             this\n            ,\n            { Left: -15 })\"\n    onMouseOut=\"TOOLtooltipClose()\"\n    onMouseUp=\"TOOLtooltipClose()\"\n\n>\r\n               <img /><span>Translator Output</span>\r\n            </a>\r\n         </div>\r\n      </div>\r\n      <div class=\"preview_mode_text\" style=\"float:right;\">\r\n         Preview Mode:\r\n      </div>        \r\n   </div>\r\n\r\n   <div id=\"resubmitPreview\" style=\"float:left; margin-left:16px;\">\r\n      <div class=\"entryViewPleaseWaitBar\">Processing...</div>\r\n   </div>\r\n   \r\n   <div id=\"resubmitComplete\" style=\"float:left;\">\r\n      <div>\r\n         <center>\r\n            <table style=\"border-collapse:collapse\"><tr><td style=\"padding:0\">\r\n               <a class=\"button\" onClick=\"javascript:resubmit(showResubmit);\"><span>Resubmit</span></a>\r\n            </td><td>\r\n               <a class=\"button\" onClick=\"javascript:hideResubmit();\"><span>Cancel</span></a>\r\n            </td></tr></table>\r\n         </center>\r\n      </div>\r\n   </div>\r\n</div>\r\n<div id=\"export-to-mapper-error\" style=\"display:none\"> </div>\r\n<div id=\"export-to-mapper-setup\" style=\"display:none\">\r\n   <p>\r\n   Select destination:<br><select id=\"mapper-targets\"></select>\r\n   <p>\r\n   <div id=\"to-mapper-progress\">\r\n      <i>Exporting... <img src=\"/js/mapper/images/spinner.gif\"></i>\r\n   </div>\r\n   <div id=\"to-mapper-finished\" style=\"font-weight:bold\"></div>\r\n   <div id=\"to-mapper-redirect\" style=\"padding-top:5px; display:none\">\r\n      View message(s) in\r\n      <a href=\"/mapper/?Page=OpenEditor&MapperGuid=&Index=\">Translator Editor</a>\r\n   </div>\r\n</div>\r\n</body>\r\n</html>\r\n"
