          "content": {
            "size": 1575,
            "mimeType": "application/json",
            "compression": 0,
            "text": "{\"NewFile\":\"Config\",\"Code\":\"-- Date 3/31/2015\\n--\\n-- Module to allow us to read Iguana channel configuration values from disk.  \\n-- Each channel will have its own configuration file in this form \\\"ChannelName.xml\\\"\\n--\\n--added ability to specifcy file name\\n\\nrequire('node')\\n\\nconfig={}\\n\\nfunction config.File(filename)\\n   local file = filename or iguana.channelName() ..'.xml'\\n   local F = io.open('C:\\\\\\\\IguanaAppSettings\\\\\\\\' .. file, 'r')\\n   local D = nil\\n   if F then\\n      D = F:read(\\\"*all\\\")\\n      F:close()\\n   end\\n   return xml.parse{data=D}\\nend\\n\\nfunction config.toBoolean(val)\\n   return not ( val == nil or val == false or val == 0 or val == \\\"0\\\" or val:lower() == \\\"false\\\")\\nend\",\"Type\":\"lua\",\"LastEditorGuid\":\"\",\"file_info\":{\"main\":{\"label\":\"main\",\"path\":\"B6CC53C02E1E65A313AAD9C757284A2A\\\\main.lua\",\"type\":\"lua\",\"editable\":true,\"current\":false,\"status\":\"unchanged\"},\"project\":{\"status\":\"unchanged\"},\"shared\":[{\"label\":\"Config\",\"path\":\"shared/Config.lua\",\"type\":\"lua\",\"editable\":true,\"current\":true,\"sourceHash\":\"FEF35401E889C9AE9887C61FA718D898\",\"status\":\"unchanged\"},{\"label\":\"PaxitConstants\",\"path\":\"shared/PaxitConstants.lua\",\"type\":\"lua\",\"editable\":true,\"current\":false,\"status\":\"unchanged\"},{\"label\":\"llp\",\"path\":\"shared/llp.lua\",\"type\":\"lua\",\"editable\":true,\"current\":false,\"status\":\"unchanged\"},{\"label\":\"node\",\"path\":\"shared/node.lua\",\"type\":\"lua\",\"editable\":true,\"current\":false,\"status\":\"unchanged\"}],\"other\":[{\"label\":\"autonack.vmd\",\"path\":\"other/autonack.vmd\",\"type\":\"vmd\",\"editable\":false,\"current\":false,\"status\":\"unchanged\"}]}}"
          },
