            "text": "div.BTRnavPane{\r\n text-align: center;\r\n position: relative;\r\n}\r\n\r\nspan.BTRnavText{\r\n margin-right: 7px;\r\n cursor: pointer;\r\n}\r\n\r\ndiv.BTRnavPaneBlocker{\r\n position: absolute;\r\n top: -10px;\r\n bottom: -10px;\r\n left: 0px;\r\n right: 0px;\r\n text-align: center;\r\n z-index: 1;\r\n padding-top: 10px;\r\n}\r\n\r\ndiv.BTRnavPaneBlocker img{\r\n display: none;\r\n opacity: 0.8;              /* Standard style for transparency */\r\n -moz-opacity: 0.8;         /* Transparency for older Mozillas */\r\n filter: alpha(opacity=80); /* For IE */\r\n}\r\n\r\na.BTRdisabled{\r\n color: #AAAAAA;\r\n cursor: default;\r\n}\r\n\r\ndiv.BTRgoto{\r\n position: absolute;\r\n background: #DEDEDE url(/js/mapper/images/th_bg.gif) repeat-x 0% 100%;\r\n vertical-align: middle;\r\n border: 1px solid #B1B1B1;\r\n width: auto;\r\n padding: 3px;\r\n}\r\n\r\ndiv.BTRgoto input.BTRgotoInput{\r\n width: 64px;\r\n margin: 0;\r\n padding: 0;\r\n}\r\n\r\ndiv.BTRgoto img{\r\n cursor: pointer;\r\n margin-left: 8px;\r\n vertical-align: middle;\r\n}\r\n\r\ndiv.BTRdataTable{\r\n margin: 15px -15px 15px -15px;\r\n}\r\n\r\ntable.BTRdataTable{\r\n vertical-align:middle;\r\n border-collapse:collapse;\r\n font-size:14px;\r\n background-color: #ffffff;\r\n width: 100%;\r\n table-layout: fixed;\r\n}\r\n\r\ntable.BTRdataTable th{\r\n/* background-color:#dedede;*/\r\n background: #dedede url('/js/mapper/images/th_bg.gif') repeat-x left bottom;\r\n border:1px solid #bbbbbb;\r\n border-bottom: 1px solid #b1b1b1;\r\n color: #666;\r\n padding:6px;\r\n padding-left:10px;\r\n padding-right:10px;\r\n vertical-align:top;\r\n font-size: 11px;\r\n font-weight: normal;\r\n text-shadow: 0 1px 1px #F7F7F7;\r\n}\r\n\r\ntable.BTRdataTable tr{\r\n background-color: #fdfdfd;\r\n}\r\n\r\ntable.BTRdataTable td{\r\n /*background: #fdfdfd url('/js/mapper/images/tr_bg.gif') repeat-x left bottom;*/\r\n border: 1px solid #d5d5d5;\r\n padding:5px;\r\n padding-left: 10px;\r\n vertical-align:top;\r\n color: #555;\r\n font-size: 11px;\r\n}\r\n\r\ntable.BTRdataTable div{\r\n overflow-x:auto;\r\n min-height:30px;\r\n}\r\n\r\ntable.BTRdataTable td.BTRsd{\r\n text-align: center;\r\n}\r\n\r\ntable.BTRdataTable .BTRreason{\r\n width: 75%;\r\n overflow: auto;\r\n}\r\n\r\ntable.BTRdataTable a {\r\n\tcolor: #3151A2;\r\n}\r\n\r\nspan.BTRerrorMessage{\r\n color: red;\r\n white-space: pre;\r\n font-family: Monospace,Verdana,Arial,Helvetica,Geneva,Lucida,sans-serif;\r\n}\r\n"
