            "mimeType": "text/css",
            "text": "/* Lua node types - the numbers in these classes' names have to match those in the Lua headers */\r\n.nt_0_0 { background-image: url(/js/treeview/images/data_type_null.gif); }\r\n.nt_0_1 { background-image: url(/js/treeview/images/data_type_boolean.gif); }\r\n.nt_0_2 { background-image: url(/js/treeview/images/lua_userdata.gif); }\r\n.nt_0_3 { background-image: url(/js/treeview/images/data_type_integer.gif); }\r\n.nt_0_4 { background-image: url(/js/treeview/images/data_type_string.gif); }\r\n.nt_0_5 { background-image: url(/js/treeview/images/json_object.gif); }\r\n.nt_0_6 { background-image: url(/js/treeview/images/lua_function.gif); }\r\n.nt_0_7 { background-image: url(/js/treeview/images/lua_userdata.gif); }\r\n.nt_0_8 { background-image: url(/js/treeview/images/lua_userdata.gif); }\r\n/* Addition Lua nodes - should match numbers in NODLutils.h */\r\n.nt_0_100 { background-image: url(/js/treeview/images/data_type_null.gif); }\r\n.nt_0_101 { background-image: url(/js/treeview/images/lua_blank.gif); }\r\n.nt_0_102 { background-image: url(/js/treeview/images/error.gif); }\r\n.nt_0_103 { background-image: url(/js/treeview/images/warning.gif); }\r\n\r\n/* HL7 node types - the numbers in these classes' names match the types in NOHconstant.h */\r\n.nt_10_1 { background-image: url(/js/treeview/images/folder.gif); }\r\n.nt_10_2 { background-image: url(/js/treeview/images/segment.gif); }\r\n.nt_10_3 { background-image: url(/js/treeview/images/composite.gif); }\r\n.nt_10_4 { background-image: url(/js/treeview/images/message.gif); }\r\n.nt_10_5 { background-image: url(/js/treeview/images/composite.gif); }\r\n.nt_10_6 { background-image: url(/js/treeview/images/composite.gif); }\r\n.nt_10_7 { background-image: url(/js/treeview/images/composite_repeating.gif); }\r\n.nt_10_8 { background-image: url(/js/treeview/images/segment_repeating.gif); }\r\n.nt_10_9 { background-image: url(/js/treeview/images/folder_repeating.gif); }\r\n\r\n/* DB node types - the numbers in these classes' names match the types in NODBconstant.h */\r\n.nt_20_1 { background-image: url(/js/treeview/images/table.gif); }\r\n.nt_20_2 { background-image: url(/js/treeview/images/table_rows.gif); }\r\n.nt_20_3 { background-image: url(/js/treeview/images/data_type_string.gif); }\r\n.nt_20_4 { background-image: url(/js/treeview/images/data_type_integer.gif); }\r\n.nt_20_5 { background-image: url(/js/treeview/images/data_type_double.gif); }\r\n.nt_20_6 { background-image: url(/js/treeview/images/data_type_datetime.gif); }\r\n.nt_20_7 { background-image: url(/js/treeview/images/data_type_binary.gif); }\r\n\r\n/* XML node types - the numbers in these classes' names match the types in NOXconstant.h */\r\n.nt_30_1 { background-image: url(/js/treeview/images/attribute.gif); }\r\n.nt_30_2 { background-image: url(/js/treeview/images/cdata.gif); }\r\n.nt_30_3 { background-image: url(/js/treeview/images/xml_doc.gif); }\r\n.nt_30_4 { background-image: url(/js/treeview/images/tag.gif); }\r\n.nt_30_5 { background-image: url(/js/treeview/images/text.gif); }\r\n\r\n/* Table Grammar node types - the numbers in these classes' names match the types in NOTGconstant.h */\r\n.nt_40_1 { background-image: url(/js/treeview/images/table_grammar.gif); }\r\n.nt_40_2 { background-image: url(/js/treeview/images/folder.gif); }\r\n.nt_40_3 { background-image: url(/js/treeview/images/table_rows.gif); }\r\n.nt_40_4 { background-image: url(/js/treeview/images/table.gif); }\r\n.nt_40_5 { background-image: url(/js/treeview/images/table_rows.gif); }\r\n.nt_40_6 { background-image: url(/js/treeview/images/data_type_string.gif); }\r\n.nt_40_7 { background-image: url(/js/treeview/images/data_type_integer.gif); }\r\n.nt_40_8 { background-image: url(/js/treeview/images/data_type_double.gif); }\r\n.nt_40_9 { background-image: url(/js/treeview/images/data_type_datetime.gif); }\r\n\r\n/* Table protocol node types - the numbers in these classes' names match the types in NTABconstant.h */\r\n.nt_50_1 { background-image: url(/js/treeview/images/table_collection.gif); }\r\n.nt_50_4 { background-image: url(/js/treeview/images/table.gif); }\r\n.nt_50_5 { background-image: url(/js/treeview/images/table_rows.gif); }\r\n.nt_50_6 { background-image: url(/js/treeview/images/data_type_string.gif); }\r\n.nt_50_7 { background-image: url(/js/treeview/images/data_type_integer.gif); }\r\n.nt_50_8 { background-image: url(/js/treeview/images/data_type_double.gif); }\r\n.nt_50_9 { background-image: url(/js/treeview/images/data_type_datetime.gif); }\r\n\r\n/* Help protocol node types, See ANNconstant.h*/\r\n.nt_60_1 { font-weight: bold; }\r\n.nt_60_2 { font-style: italic; }\r\n"
