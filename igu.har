            "mimeType": "text/css",
            "text": "div#EDTeditor{\r\n position : absolute;\r\n top : 36px;\r\n bottom : 32px;\r\n left : 0px;\r\n right : 0px;\r\n padding : 0px;\r\n margin : 0px;\r\n border-top : 1px solid #b1b1b1;\r\n background-color: #ffffff;\r\n}\r\n\r\ndiv.CodeMirror-wrapping{\r\n position: absolute !important; /* override codemirror's default of 'relative' - #16706 */\r\n right: 100px;\r\n left: 225px;\r\n}\r\n\r\nspan.CodeMirror-selected.current_search_match{\r\n   background-color: #B5D5FF !important;\r\n   color: black !important;\r\n}\r\n\r\ndiv.EDTstatus_bar{\r\n position: absolute;\r\n bottom: 0px;\r\n left: 0px;\r\n right: 0px;\r\n padding: 5px 15px;\r\n height: 21px;\r\n white-space: nowrap;\r\n border-top: 1px solid #b1b1b1;\r\n}\r\n\r\ndiv#EDTprojectManager{\r\n width:224px;\r\n float:left;\r\n height:100%;\r\n border-right: 1px solid #c6c6c6;\r\n position: relative;\r\n background: url(\"/js/mapper/images/shadow.png\") repeat-y right top #F0F7F9;\r\n}\r\n\r\ndiv#EDTprojectManager .ui-resizable-e{\r\n border: 2px solid #BBB;\r\n border-top: none;\r\n border-bottom: none;\r\n width: 1px;\r\n right: -2px;\r\n background-color: white;\r\n}\r\n\r\n.ui-resizable-e, .ui-resizable-n{\r\n z-index: 1;\r\n}\r\n\r\ndiv#EDTthumbnailScroll{\r\n background-color:#DDDDDD;\r\n width:100px;\r\n float:right;\r\n height:100%;\r\n cursor:default;\r\n}\r\n\r\ndiv#EDTthumbnailScroll svg{\r\n background-color: white;\r\n cursor: pointer;\r\n}\r\n\r\na.EDTreloadLink, a.EDTreloadLink:visited{\r\n color: blue;\r\n}\r\n\r\ndiv.EDTiframeDialogFix{\r\n position: absolute;\r\n z-index: 999; /* just under a jQuery UI dialog */\r\n top: 0px;\r\n bottom: 0px;\r\n left: 0px;\r\n right: 0px;\r\n}\r\n\r\n.searched{\r\n background-color: #FFFFB7;\r\n}\r\n\r\ndiv.EDTloading{\r\n z-index: 1000;\r\n position: absolute;\r\n /* 'top' is defined in iguana_editor.css, since it depends on the header height */\r\n bottom: 0px;\r\n left: 0px;\r\n right: 0px;\r\n background: white url(/js/mapper/images/spinner_big_green.gif) no-repeat fixed center center;\r\n opacity: 0.7;              /* Standard style for transparency */\r\n -moz-opacity: 0.7;         /* Transparency for older Mozillas */\r\n filter: alpha(opacity=70); /* For IE */\r\n}\r\n\r\n/* #20660 - prevent clipping in Chrome when \"zoomed in\". */\r\ninput[type=\"file\"]{\r\n padding-top: 2px; /* override default of 1px */\r\n}\r\n\r\n/* #24689 - this could be the start of a new diff controller  */\r\n\r\nins {\r\n background-color: #B0E0B9;\r\n}\r\n\r\ndel {\r\n background-color: #FFC5C5;\r\n}\r\n\r\ndiv.diffboxWrap {\r\n display: inline-block;\r\n width: 49%;\r\n height: 400px;\r\n}\r\n\r\ndiv.diffbox {\r\n font-family: monospace;\r\n white-space: pre;\r\n height: 100%;\r\n width: 100%;\r\n overflow: auto;\r\n background-color: white;\r\n border: 1px solid #d4ccb0;\r\n}\r\n\r\n"
