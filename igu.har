            "mimeType": "text/css",
            "text": ".tx{\r\n padding: 0;\r\n color : #A22;\r\n}\r\n.gr{\r\n padding: 0;\r\n color : #C0C0C0;\r\n}\r\n\r\n.an, .editbox{\r\n font-size: 14px;\r\n line-height: 17px;\r\n padding: 0;\r\n font-family: monospace;\r\n color: black;\r\n cursor: default;\r\n}\r\n\r\ndiv.CodeMirror{\r\n font-size: 12px;\r\n line-height: 15px;\r\n height: 100%;\r\n}\r\n\r\ndiv.CodeMirror-scroll{\r\n height: 100%;\r\n position: relative;\r\n cursor: text;\r\n}\r\n\r\n.CodeMirror-line-numbers{\r\n text-align: right;\r\n padding-right : 2px;\r\n font-size: 14px;\r\n line-height: 17px;\r\n padding-left: 0;\r\n padding-top: 0;\r\n padding-bottom: 0;\r\n font-family: monospace;\r\n color: black;\r\n cursor: default;\r\n}\r\n\r\n.CodeMirror-iframe{\r\n width:100%; \r\n height: 100%; \r\n display: block;\r\n border-right: 1px solid #b1b1b1;\r\n}\r\n\r\ndiv.an {\r\n height: 0;\r\n}\r\n\r\ndiv.an.stale{\r\n opacity: 0.15;             /* Standard style for transparency */\r\n -moz-opacity: 0.15;        /* Transparency for older Mozillas */\r\n filter: alpha(opacity=15); /* For IE */\r\n}\r\n\r\ndiv.CodeMirror-line-numbers {\r\n  color: #999999;\r\n  border-right: 1px solid #dddddd;\r\n  background-color: #f9f9f9;\r\n  /*font-weight: bold;*/\r\n}\r\n\r\ndiv.CodeMirror-gutter {\r\n   /* Doesn't make sense to use the text cursor here since you can't edit the\r\n   line numbers. */\r\n   cursor: default;\r\n}\r\n\r\ndiv.CodeMirror-gutter-text .dirty {\r\n   color: black;\r\n   background-color: #F7FE2E;\r\n}\r\n\r\ndiv.CodeMirror-line-numbers, .editbox\r\n{\r\nmargin: 0px; \r\npadding-left: 6px;\r\n}\r\n\r\n\r\ntable.an, tr.an, td.an, tbody.an {\r\nmargin: 0;\r\npadding: 0;\r\nborder-spacing: 0;\r\nborder-collapse: collapse;\r\n}\r\n\r\n/* For the logging */\r\ntd.l{\r\ntext-align: right\r\n}\r\ntd.t{\r\ncolor : grey;\r\n}\r\ntd.b{\r\nfont-family: monospace;\r\n}\r\n\r\npre.code, .editbox {\r\n  color: #666666;\r\n}\r\n\r\n.editbox p {\r\n  margin: 0;\r\n}\r\n\r\n/* rect colors should match the colours in the CodeMirror theme css */\r\n\r\nrect.lua-comment {\r\n  fill: #BB9977;\r\n}\r\n\r\nrect.merge-conflict \r\n{\r\n    fill: #f00;\r\n    fill-opacity: 0.2;\r\n    stroke: #f00;\r\n}\r\n\r\nrect.lua-keyword {\r\n  fill: blue;\r\n}\r\n\r\nrect.lua-stdfunc {\r\n  fill: #077;\r\n}\r\n\r\nrect.lua-error {\r\n  fill: #F6CECE;\r\n  stroke: #8E2525;\r\n}\r\n\r\nrect.lua-error-line {\r\n  fill: #dcebf5;\r\n}\r\n\r\nrect.lua-scrollbar {\r\n  fill: #0E68BF;\r\n  stroke: #0E68BF; \r\n  fill-opacity: 0.2;\r\n}\r\n\r\n/* Script error styles */\r\n.error-highlight-row {\r\n  background-color: #dcebf5 !important;\r\n}\r\n\r\ndiv.error-box {\r\n  position: absolute;\r\n  z-index: 11;\r\n  background-color: #fce8e8;\r\n  border: 1px solid #efb6b6;\r\n  color: #c55a5a;\r\n  white-space: pre;\r\n  box-shadow: 0 1px 2px #888;\r\n  -moz-box-shadow: 0 1px 2px #888;\r\n  -webkit-box-shadow: 0 1px 2px #888;\r\n  border-radius: 4px;\r\n  -moz-border-radius: 4px 4px;\r\n  -webkit-border-radius: 4px 4px;\r\n}\r\n\r\ndiv.error-box textarea:target{\r\n   border: 0px;\r\n}\r\n\r\ndiv.error-box div.error-toolbar{\r\n   padding: 2px 2px 3px 0px;\r\n   font-size: 9px;\r\n   font-family: Verdana, Geneva, sans-serif;\r\n   color: #c44040;\r\n}\r\n\r\ndiv.error-box div.error-toolbar a,\r\ndiv.error-box div.error-toolbar a:visited {\r\n   color: inherit;\r\n}\r\n\r\ndiv.error-box div.error-message{\r\n   padding: 2px 2px 2px 0.5em;\r\n}\r\n\r\ndiv.error-box div.error-toolbar img{\r\n   cursor: pointer;\r\n}\r\n\r\ndiv.error-box img.error-stack,\r\ndiv.error-box img.error-expand,\r\ndiv.error-box img.error-collapse{\r\n   padding-right: 2px;\r\n}\r\n\r\ndiv.error-box div.error-buttons{\r\n   float: right;\r\n   padding-left: 7px;\r\n   padding-top: 1px;\r\n   padding-right: 1px;\r\n   height: 0px; /* minimum height */\r\n}\r\n\r\ndiv.error-box.collapsed{\r\n   cursor: pointer;\r\n}\r\n\r\ndiv.error-box.collapsed div.error-toolbar{\r\n   float: right;\r\n}\r\n\r\ndiv.error-box.collapsed div.error-message{\r\n   margin-right: 52px; /* make space for the buttons on the right */\r\n}\r\n\r\ndiv.error-box.collapsed div.error-toolbar span{\r\n   display: none;\r\n}\r\n\r\ndiv.error-box.collapsed img.error-collapse{\r\n   display: none;\r\n}\r\n\r\ndiv.error-box.expanded{\r\n   cursor: move;\r\n}\r\n\r\ndiv.error-box.expanded div.error-toolbar{\r\n   border-bottom: 1px solid #ebc1c1;\r\n   padding-left: 0.5em;\r\n   height: 14px;\r\n   \tbackground: #f7d6d6; /* for non-css3 browsers */\r\n\tbackground: -moz-linear-gradient(#fadfdf, #f4cdcd) repeat scroll 0 0 transparent;\r\n\tbackground: -webkit-gradient(linear, left top, left bottom, from(#fadfdf), to(#f4cdcd));\r\n}\r\n\r\ndiv.error-box.expanded div.error-toolbar span{\r\n   float: left;\r\n}\r\n\r\ndiv.error-box.expanded div.error-message{\r\n   cursor: text;\r\n}\r\n\r\ndiv.error-box.expanded img.error-expand{\r\n   display: none;\r\n}\r\n\r\n/* End of script error styles */\r\n\r\ndiv.anpane {\r\n background-color:#EEE; border-top:1px solid #555;\r\n border-bottom:1px solid #888; \r\n padding: 0px;\r\n clear : left;\r\n white-space: nowrap;\r\n}\r\n\r\ndiv.aninfo {\r\n /*display: inline-block;  /* stops the div from being too wide */ \r\n white-space: nowrap;\r\n position: relative;\r\n top : -10px;\r\n z-index : 1000;\r\n moz-user-select: none;    /* #15281 these crytic CSS codes should make the annotation controls unselectable - first is for Mozilla */\r\n -khtml-user-select: none; /* this one is Chrome/Safari */ \r\n user-select: none;        /* CSS3 way of achieving the same thing. */\r\n float: left;\r\n padding: 1px;\r\n}\r\n\r\nspan.inner {\r\n font: normal 9px \"Lucida Sans\", sans-serif;\r\n padding: 0px 3px;\r\n cursor: pointer;\r\n}\r\n\r\nimg.bb, img.b, img.f, img.ff{\r\n cursor : pointer;\r\n padding: 0px 3px;\r\n}\r\n\r\nspan.print{\r\n color : #0B0;\r\n}\r\n\r\nspan.tx, span.print{\r\n white-space : pre;\r\n}\r\n\r\n.toolbar{\r\n vertical-align: middle;\r\n font-size: 11px;\r\n margin-left: 10px;\r\n text-shadow: 0 1px 1px #F7F7F7;\r\n}\r\n\r\ninput.toggle_annotations{\r\n /*vertical-align: middle;*/\r\n}\r\n\r\n\r\ndiv.an_sb{\r\n float: left;\r\n /*\r\n border: 1px solid #444444;\r\n background-color: #D7D7D7;\r\n */\r\n width: 50%;\r\n height: 20px;\r\n white-space: nowrap;\r\n overflow: hidden;\r\n font-size: 11px;\r\n}\r\n\r\ndiv.an_sb.an_sb_right{\r\n position: absolute;\r\n left: 50%;\r\n}\r\n\r\ndiv.an_sb span{\r\n color: red;\r\n}\r\n\r\ndiv.an_sb span img{\r\n position: relative;\r\n top: 2px;\r\n}\r\n\r\n/* treeview */\r\nspan.tv{\r\n position: absolute;\r\n margin-top: -2px;\r\n padding-right: 2px;\r\n border: 1px dotted #00BB00;\r\n background-color: #E9FFE9;\r\n color: black;\r\n opacity: 0.9;\r\n line-height: 12px;\r\n z-index: 2000;\r\n}\r\n\r\nspan.tv.front{\r\n z-index: 2001;\r\n border-color: #215FA3;\r\n}\r\n\r\n/* treeview placeholder */\r\nspan.tv_ph{\r\n visibility: hidden;\r\n padding-left: 50px;\r\n white-space: nowrap;\r\n}\r\n\r\nspan.tv, span.tv_ph{\r\n font-size: 11px;\r\n}\r\n\r\nul.ifwareTreeview{\r\n margin-top: 0;\r\n margin-bottom: 0;\r\n}\r\n\r\nul.ifwareTreeview li.expandable span.treeIcon {\r\n height:15px !important;\r\n}\r\n\r\n.executeNowText {\r\n    text-decoration: underline ! important;\r\n    color: purple ! important;\r\n}\r\n"
          },
