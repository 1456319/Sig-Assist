          "content": {
            "size": 2171,
            "mimeType": "text/css",
            "text": "body{\r\n margin: 0px;\r\n background-color: #D0D6B8;\r\n font-family: Verdana, Geneva, sans-serif;\r\n font-size: 12px;\r\n}\r\n\r\n/* TODO put prefixes in front of these styles... !!! */\r\nspan.logo{\r\n position: absolute;\r\n top: 3px;\r\n left: 20px;\r\n width: 136px;\r\n height: 32px;\r\n display: block;\r\n}\r\n\r\nspan.crumb{\r\n position: relative;\r\n top: 13px;\r\n left: 260px;\r\n color: #ededed;\r\n font-size: 11px;\r\n}\r\n\r\nspan.crumb a{\r\n color: #ededed;\r\n}\r\n\r\nspan.version {\r\n position: relative;\r\n top: 13px;\r\n left: 260px;\r\n color: #2c5a07;\r\n font-size: 11px;\r\n}\r\n\r\nspan.version a {\r\n color: #ededed;\r\n}\r\n\r\ndiv.header {\r\n height: 35px; /* should match div.EDTloading's height */\r\n /*background-image: url('/js/mapper/images/header_bg.gif'); */\r\n background-image: url('/mapper/header_bg_utrans.gif'); \r\n background-repeat: repeat-x;\r\n min-width:1000px;\r\n}\r\n\r\ndiv.EDTloading {\r\n top: 35px; /* should match div.header's height */\r\n}\r\n\r\ndiv.content_main{\r\n -moz-border-radius: 5px;\r\n -webkit-border-radius: 5px;\r\n -moz-box-shadow: 0 1px 3px #777777;\r\n -webkit-box-shadow: 0px 1px 3px #777777;\r\n border: 1px solid #B1B1B1;\r\n padding: 15px 15px 25px 15px;\r\n background-color: #f9f9f9;\r\n margin: 10px;\r\n position: absolute;\r\n top:35px;\r\n left: 0px;\r\n right: 0px;\r\n min-width:950px;\r\n}\r\n\r\ndiv.floated_bottom{\r\n position: absolute;\r\n bottom:0px;\r\n min-height:250px;\r\n}\r\n\r\n.crumb select{\r\n margin: 0px;\r\n margin-top: -2px;\r\n padding: 0px;\r\n font-size: 10px;\r\n border: 1px solid #26629e;\r\n background-color: #F9F9F9;\r\n color: #444;\r\n}\r\n\r\n#login {\r\n   float:right;\r\n   padding-top:13px;\r\n   font-size: 10px;\r\n   font-weight: bold;\r\n   color: #244d02;\r\n   position: relative; /* needed for this to appear over .ITSpopupProtector */\r\n}\r\n\r\n#login a {\r\n   color: #244d02;\r\n}\r\n\r\n#help_button {\r\n   float:right;\r\n   padding-top:9px;\r\n   padding-left:10px;\r\n   padding-right:10px; \r\n   position: relative; /* needed for this to appear over .ITSpopupProtector */\r\n}\r\n\r\n#help_button a {\r\n   display: block;\r\n   height: 23px;\r\n   width: 56px;\r\n   background: url(\"/images/help_button.gif\") 0 0 no-repeat;\r\n}\r\n\r\ndiv.optionCreateDbTables { background-image: url(/mapper/images/project/action-create-db-tables.gif); }\r\n"
          },
