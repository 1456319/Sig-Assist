            "mimeType": "text/css",
            "text": "/* All the button styles global to the mapper are defined here */\r\n\r\n.BTNbuttons a, .BTNbuttons button, .BTNbuttons input {\r\n margin:0 7px 0 0;\r\n background-color:#efefef;\r\n border:1px solid #cccccc;\r\n border-top:1px solid #dfdfdf;\r\n border-left:1px solid #dfdfdf;\r\n font-family: Verdana, Geneva, sans-serif;\r\n font-size:10px;\r\n line-height:130%;\r\n text-decoration:none;\r\n font-weight:bold;\r\n color:#444444;\r\n cursor:pointer;\r\n padding:5px 10px 6px 7px; /* Links */\r\n -moz-border-radius: 3px;\r\n -webkit-border-radius: 3px;\r\n}\r\n\r\n.BTNbuttons BTNbutton {\r\n width:auto;\r\n overflow:visible;\r\n padding:4px 10px 3px 7px; /* IE6 */\r\n}\r\n\r\n.BTNbuttons button[type], .BTNbuttons input[type]{\r\n padding:4px 10px 5px 7px; /* Firefox */\r\n line-height:17px; /* Safari */\r\n}\r\n\r\n*:first-child+html button[type]{\r\n padding:4px 10px 3px 7px; /* IE7 */\r\n}\r\n.BTNbuttons button img, .BTNbuttons a img{\r\n margin:0 3px -3px 0 !important;\r\n padding:0;\r\n border:none;\r\n width:16px;\r\n height:16px;\r\n}\r\n\r\n/* STANDARD */\r\n\r\n.BTNbuttons a:hover, .BTNbuttons button:hover, .BTNbuttons input:hover {\r\n background-color:#dff4ff;\r\n border:1px solid #c2e1ef;\r\n color:#336699;\r\n}\r\n.BTNbuttons a:active {\r\n background-color:#6299c5;\r\n border:1px solid #6299c5;\r\n color:#fff;\r\n}\r\n\r\n/* POSITIVE */\r\n\r\n.BTNbuttons a.BTNpositive, .BTNbuttons button.BTNpositive, .BTNbuttons input.BTNpositive {\r\n color:#529214;\r\n}\r\n.BTNbuttons a.BTNpositive:hover, .BTNbuttons button.BTNpositive:hover, .BTNbuttons input.BTNpositive:hover {\r\n background-color:#E6EFC2;\r\n border:1px solid #C6D880;\r\n color:#529214;\r\n}\r\n\r\n.BTNbuttons a.BTNpositive:active {\r\n background-color:#529214;\r\n border:1px solid #529214;\r\n color:#fff;\r\n}\r\n\r\n/* NEGATIVE */\r\n\r\n.BTNbuttons a.BTNnegative, .BTNbuttons button.BTNnegative, .BTNbuttons input.BTNnegative {\r\n color:#d12f19;\r\n}\r\n.BTNbuttons a.BTNnegative:hover, .BTNbuttons button.BTNnegative:hover, .BTNbuttons input.BTNnegative:hover {\r\n background:#fbe3e4;\r\n border:1px solid #fbc2c4;\r\n color:#d12f19;\r\n}\r\n.BTNbuttons a.BTNnegative:active {\r\n background-color:#d12f19;\r\n border:1px solid #d12f19;\r\n color:#fff;\r\n}\r\n"
