            "size": 4998,
            "mimeType": "text/css",
            "text": "table.diffTable, table.filesTable, table.extension_list {\r\n\tbackground-color:#FFFFFF;\r\n\tborder-collapse:collapse;\r\n\tborder-color:#BBBBBB #BBBBBB #B1B1B1;\r\n\tborder:1px solid #BBB;\r\n\tfont-size:14px;\r\n\tvertical-align:middle;\r\n\twidth: 100%;\r\n}\r\n\r\n/* Scaling of the files table for the Save Milestone dialog. */\r\ndiv.filesTableWrapper {\r\n   max-height: 250px;\r\n   overflow-y: auto;\r\n}\r\n\r\ntable.extension_list \r\n{\r\n    width: 50%;\r\n    margin-right: auto;\r\n    margin-left: 20px;\r\n    margin-top:20px;\r\n}\r\n\r\ntable.legendTable {\r\n\tfont-size:14px;\r\n\tborder:none;\r\n\tvertical-align:middle;\r\n   margin-left: auto;\r\n   margin-right: auto;\r\n   display:inline;\r\n}\r\n\r\ntable.legendTable td {\r\n\tborder:1px solid #BBB;\r\n\tvertical-align:middle; \r\n\tpadding-left:3px;\r\n\tpadding-right:3px;\r\n}\r\n\r\ntable.diffTable th, table.filesTable th, table.extension_list th {\r\n\tbackground:url(\"th_bg.gif\") repeat-x scroll left bottom #DEDEDE;\r\n\tborder-color:#BBBBBB #BBBBBB #B1B1B1;\r\n\tborder:1px solid #BBB;\r\n\tcolor:#666666;\r\n\tfont-size:14px;\r\n\tfont-weight:bold;\r\n\tpadding:3px 3px;\r\n\ttext-shadow:0 1px 1px #F7F7F7;\r\n\tvertical-align:top;\r\n}\r\n\r\ntable.diffTable th.milestone {\r\n    text-align: left;\r\n}\r\n\r\ntable.diffTable th.lineNumber {\r\n    width:40px;\r\n    border:1px;\r\n}\r\n\r\ntable.diffTable tr#diff_header_row {\r\n\theight: 23px;\r\n}\r\n\r\ntable.diffTable td, table.extension_list td  {\r\n\tcolor:#222222;\r\n\tfont-size:12px;\r\n\tvertical-align:top;\r\n}\r\n\r\ntable.diffTable tr {\r\n\theight: 17px;\r\n}\r\n\r\n#leftNumDiv , #rightNumDiv , #leftCodeDiv , #rightCodeDiv {\r\n\tdisplay: inline-block;\r\n\tfloat: left;\r\n}\r\n\r\n#leftNumDiv , #rightNumDiv {\r\n\twidth: 6%;\r\n\tborder: none;\r\n\theight: 100%;\r\n}\r\n\r\n#leftCodeDiv, #rightCodeDiv {\r\n\twidth: 94%;\r\n\tborder: none;\r\n\theight: 100%;\r\n}\r\n\r\ndiv#leftSideDiv {\r\n\tfloat: left;\r\n}\r\n\r\ntable#leftSideNum, table#rightSideNum {\t\r\n\t border-bottom: none;\r\n}\r\n\r\ntable#leftSide tr, table#rightSide tr {\r\n\tbackground-color: white;\r\n}\r\n\r\ntable#leftSide, table#rightSide {\r\n\twhite-space:pre;\r\n}\r\n\r\ntable#leftSide th, table#rightSide th {\r\n\tborder-left: none;\r\n\tborder-right: none;\r\n\tborder-top: none;\r\n}\r\n\r\ndiv#leftSideDiv, div#rightSideDiv {\r\n\twidth: 50%;\r\n\toverflow: auto;\r\n\theight: 88%;\r\n}\r\n\r\n.ui-selecting { background: #ccffee; }\r\n.ui-selected { background: #ccffee; }\r\n\r\ntable#testTable td{\r\n\theight: 17px;\r\n\twidth: 40px;\r\n\tborder: 1px solid black;\r\n}\r\n  \r\ntable.filesTable td  {\r\n\tcolor:#222222;\r\n\tfont-size:12px;\r\n\tvertical-align:top;\r\n\theight:16px;\r\n}\r\n\r\ntable.diffTable pre \r\n{\r\n    font-size: 12px;\r\n    padding: 0; \r\n    margin: 0;\r\n}\r\n\r\ntable.diffTable td.in, table.legendTable td.in {\r\n    background:#afa;\r\n}\r\ntable.diffTable td.de, table.legendTable td.de {\r\n    background:#faa;\r\n}\r\ntable.diffTable td.ch, table.legendTable td.ch {\r\n    background:#eceb7a;\r\n}\r\ntable.diffTable td.di {\r\n    background:#D5D5D5; \r\n}\r\n\r\ntable.diffTable td.ln {\r\n    background:#ccc;\r\n    width:34px; border:1px solid #BBBBBB;\r\n}\r\n\r\ntable.diffTable \r\n{\r\n    white-space: pre-wrap; \r\n    font-family:monospace; \r\n    font-size: 12px;\r\n    padding: 0; \r\n    margin: 0; \r\n}\r\n\r\ntable.diffTable span.highlight {\r\n    background:#d2d16b; \r\n    font-weight:bolder \r\n}\r\n\r\ntable.diffTable td.center, table.filesTable td.center {\r\n   text-align:center;\r\n}\r\ntable.diffTable a, table.filesTable a {\r\n\tcolor:#3151A2;\r\n}\r\ntable.diffTable img, table.filesTable img {\r\n   border-style:none;\r\n   cursor:pointer;\r\n   float:right;\r\n   padding-left:10px;\r\n   vertical-align:middle;\r\n}\r\n\r\ntable.filesTable td \r\n{\r\n    width: 50%;\r\n    height: 20px;\r\n}\r\ntable.diffTable\r\n{\r\n    font-family: Arial;\r\n}\r\n\r\ntable.tag_table td\r\n{\r\n\tborder:0px;\r\n}\r\n\r\n#milestoneFromNameSideBySide , #milestoneNameSideBySide{\r\n\twidth: 47%;\r\n}\r\n\r\ntable.diffTable td.tag_td_milestone, table.diffTable td.tag_td, table.diffTable td.tag_td_user,\r\n    table.diffTable td.tag_td_date, table.diffTable td.file_table, table.diffTable td.tag_td_actions\r\n{\r\n\tborder:1px solid #d5d5d5;\r\n}\r\n\r\ntd.tag_td_user, td.tag_td_date, td.tag_td_actions, td.file_table\r\n{\r\n  white-space: nowrap;\r\n  padding-right: 0.5em;\r\n  padding-left: 0.5em;\r\n  width: 0%;\r\n}\r\ntd.tag_td_milestone\r\n{\r\n  padding-right: 0.5em;\r\n  padding-left: 0.5em;\r\n  width: 100%;\r\n}\r\n\r\n#milestone_list_title \r\n{\r\n\tfont-size:20px;\r\n\tpadding-bottom:5px;\r\n}\r\n\r\ndiv.fossil_error\r\n{\r\n    font-size:14px;\r\n    white-space:pre-wrap;\r\n    color:White;\r\n    background-color:#d55;\r\n    padding:7px;\r\n}\r\n\r\ndiv.fossil_error_inline\r\n{\r\n    color:red;\r\n}\r\n\r\ndiv.fossil_info\r\n{\r\n    font-family:monospace;\r\n    font-size:12px;\r\n    white-space:pre-wrap;\r\n}\r\n\r\ndiv.fossil_output\r\n{\r\n    font-family:monospace;\r\n    font-size:12px;\r\n    white-space:pre-wrap;\r\n}\r\n\r\nspan.clickable_link \r\n{\r\n    cursor: pointer;\r\n    color: #00f;\r\n}    \r\n\r\nspan.clickable_link:hover\r\n{\r\n    text-decoration: underline !important;\r\n}\r\n\r\n#switch_view, #toggle_unchanged\r\n{\r\n    width: 160px;\r\n    float: right;\r\n}\r\n\r\ninput#revisionName \r\n{\r\n    width: 100%;\r\n}\r\n\r\ntr.odd \r\n{\r\n    background-color: #eee;\r\n}\r\n\r\n#toggleButton {\r\n\theight: 18px;\r\n\tmargin-bottom: 5px;\r\n}\r\n"
