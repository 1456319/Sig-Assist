            "mimeType": "text/css",
            "text": ".tooltip{\r\n position: absolute;\r\n visibility: hidden;\r\n z-index: 20;\r\n}\r\n\r\n.tooltip_top {\r\n background-repeat: no-repeat;\r\n height: 18px;\r\n position: relative;\r\n top: 2px;\r\n width: 1px;\r\n}\r\n\r\n.tooltip_bottom {\r\n background-repeat: no-repeat;\r\n height: 18px;\r\n position: relative;\r\n top: -2px;\r\n width: 1px;\r\n}\r\n\r\n.tooltip_body {\r\n font-size: 11px;\r\n color: #333333;\r\n background-color: #ffc;\r\n border: 2px solid #c5c6a4;\r\n padding: 8px;\r\n -moz-border-radius: 8px;\r\n}\r\n\r\n"
