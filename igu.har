          ],
          "cookies": [
            {
              "name": "Mapper-SessionId",
              "value": "B52197248A0C6D5ED8EED9EF998FBFE1",
              "path": "/",
              "domain": "iguanabalt01v",
              "expires": null,
              "httpOnly": false,
              "secure": false
            }
          ],
          "content": {
            "size": 9281,
            "mimeType": "application/json",
            "compression": 0,
            "text": "{\"EditorGuid\":\"958CE44BEAAD7B580829EE4B871701FB\",\"ChannelGuid\":\"B6CC53C02E1E65A313AAD9C757284A2A\",\"ScriptData\":\"--==========================================================================================\\t\\n-- Author:\\t    Stephen L. Muskopf\\n-- Create date:     2011-11-22\\n-- Description:\\t    Takes an HL7 DFT message, sends it and calls a RESTful web service when \\n--                  successful.\\n--                  Also handles Packing Slip number requests.\\n--\\n--                  NOTE: The URL needs to be modified if a different site should be referenced.\\n--\\t\\t\\t\\t\\n-- Modification Log:\\n--\\n-- Stephen L. Muskopf   2012-08-27  cache the connection\\n-- Jamin Sink\\t\\t2012-12-28  Updated billing process to record NAck/Ack and # of attempts back to paxit\\n-- Netsanet Gizaw       2013-06-13  Handle forcibly colsed errors\\n--==========================================================================================\\n\\nrequire ('PaxitConstants')\\nrequire ('llp')\\nrequire ('node')\\nrequire ('Config')\\n\\n--CONSTANTS\\n--Site Specific overrides:\\nPaxitConstants.URL_p='http://PaxitWebRic01v/PimsRestService'\\nPaxitConstants.FWInstance = 'RicIntBalt01v'\\nPaxitConstants.FWPort = 9008\\t\\n\\n\\n-- cache the connection\\nlocal conn\\n\\n-- load Config\\nlocal Configuration = config.File(\\\"Framework.xml\\\")\\n\\n-- main() is given the original HL7 message. \\nfunction main(Data)\\n   if iguana.isTest() then\\n      -- We're in test mode so we won't use pcall\\n      ProcessMessage(Data)\\n   else\\n      local Success, Err = pcall(ProcessMessage, Data)\\n      if not Success then\\n         if conn then conn:close() end\\n         conn = nil\\n         iguana.logInfo('Message not sent. Reason: '..Err)\\n      else\\n         iguana.logInfo('Message sent successfully.')\\n      end\\n   end\\n\\nend\\n\\nfunction ProcessMessage(Msg)\\n   local jsonObject\\n   local messageType\\n   local Ack\\n   local OrgData = Msg\\n   \\n   iguana.logDebug(\\\"message received\\\")\\n\\n   --If the serialized unbilled order was sent, strip it out\\n   local index =  string.find(Msg, \\\"::{\\\")\\n   if index ~= nill and index > 0 then\\n      iguana.logDebug(\\\"json Object: \\\" .. string.sub(Msg, index + 2))\\n      jsonObject = json.parse{data=string.sub(Msg, index + 2 )}\\n      Msg = string.sub(Msg, 1, index-1)\\n      if jsonObject.PackingSlipId ~= nil then\\n         messageType = \\\"PackingSlip\\\"\\n      else \\n         messageType = \\\"BilledOrder\\\"\\n      end\\n   end\\n\\n   iguana.logDebug(\\\"Sending: \\\" .. Msg)\\n  \\n   Ack = FailoverSendMessage(Msg, OrgData, jsonObject.PharmId)\\n\\n   local Msg, Name = hl7.parse{vmd=PaxitConstants.NACK_VMD_file, data=Ack}\\n   \\n   if Msg.MSA[1]:S() == \\\"AA\\\" then\\n      iguana.logDebug(\\\"Closing: \\\" .. json.serialize{data=jsonObject})\\n      if messageType == \\\"PackingSlip\\\" then\\n         jsonObject.PackingSlipId = Msg.MSA[3]:S()\\n         UpdatePackingSlip(jsonObject)\\n      else\\n         jsonObject[\\\"Ack\\\"] = Ack\\n         UpdateOrder(jsonObject, true)  \\n      end\\n   else\\n      iguana.logInfo(messageType .. ' request to Pims Failed.  NACK: '.. Ack)\\n      jsonObject[\\\"NAck\\\"] = Ack\\n      UpdateOrder(jsonObject, false)  \\n   end \\n   \\nend\\n\\n\\nfunction UpdateOrder(BilledOrder, successfullySent)\\n      BilledOrder[\\\"SuccessfullyTransmitted\\\"] = successfullySent\\n   \\n      --This may look goofy, but we need the BillingOrder to be a table of tables    \\n      local billingOrders = {}\\n      local billingOrdersTable = {}\\n      billingOrders[1] = BilledOrder \\n      billingOrdersTable[\\\"BilledOrders\\\"] = billingOrders \\n\\n      local parms = {}\\n      parms[\\\"ItemType\\\"] = 'BillingOrders'\\n      parms[\\\"JsonValue\\\"] = json.serialize{data=billingOrdersTable}\\n      RequestBody = json.serialize{data=parms}\\n      \\n      iguana.logDebug(\\\"ClosingRequest: \\\" .. RequestBody)\\n      \\n      local R,C,H = net.http.post{\\n         url=PaxitConstants.URL_p, live = true,\\n         headers={['Content-Type']='application/json'},\\n         body=RequestBody}\\n      \\n     iguana.logDebug(\\\"ClosingResponse: \\\" .. R)\\n   \\n      --If errors during service calls, we need to grab the error message and log it\\n      local response  = xml.parse{data=R}\\n   \\n      if response == nil then\\n        iguana.logInfo('Could not mark as billed, PimsRestService returned null')  \\n      \\n      elseif  string.find(response:S(), \\\"PimsItem\\\") == nil then\\n        iguana.logInfo('Could not mark as billed: ' ..response:S())\\n\\n      elseif response.PimsItem.ItemType[1]:S() == \\\"Error\\\" then\\n        iguana.logInfo('Could not mark as billed '..response.PimsItem.JsonValue[1])\\n      end\\n\\nend\\n\\nfunction UpdatePackingSlip(PackingSlip)\\n      --This may look goofy, but we need the PackingSlip to be a table of tables    \\n      local packingSlips = {}\\n      local packingSlipsTable = {}\\n      packingSlips[1] = PackingSlip \\n      packingSlipsTable[\\\"PackingSlips\\\"] = packingSlips \\n\\n      local parms = {}\\n      parms[\\\"ItemType\\\"] = 'PackingSlipUpdate'\\n      parms[\\\"JsonValue\\\"] = json.serialize{data=packingSlipsTable}\\n      RequestBody = json.serialize{data=parms}\\n      \\n      iguana.logDebug(\\\"PackingSlipRequest: \\\" .. RequestBody)\\n      \\n      local R,C,H = net.http.post{\\n         url=PaxitConstants.URL_p, live = true,\\n         headers={['Content-Type']='application/json'},\\n         body=RequestBody}\\n      \\n     iguana.logDebug(\\\"PackingSlipResponse: \\\" .. R)\\n   \\n      --If errors during service calls, we need to grab the error message and log it\\n      local response  = xml.parse{data=R}\\n   \\n      if response == nil then\\n        iguana.logInfo('Could not update Packing Slip, PimsRestService returned null')  \\n      \\n      elseif  string.find(response:S(), \\\"PimsItem\\\") == nil then\\n        iguana.logInfo('Could not update Packing Slip: ' ..response:S())\\n\\n      elseif response.PimsItem.ItemType[1]:S() == \\\"Error\\\" then\\n        iguana.logInfo('Could not update Packing Slip '..response.PimsItem.JsonValue[1])\\n      end\\n\\nend\\n\\n\\n--Pushes the message to a Q when LLP endpoint(i.e., Framework HL7 service is down)\\nfunction FailoverSendMessage(Data, OrgData, PharmId)\\n   local Success,Err = pcall(SendMessage, Data, PharmId) \\n   \\n   if not Success then\\n       --close and nil the connection\\n      if conn then conn:close() end\\n      conn = nil\\n      \\n      iguana.logInfo('Pushing Message to Failover Channel.')\\n      --queue.push{data=Data}\\n      SendFailOver(OrgData);\\n      return GenerateAck(Data,Err);      \\n   else\\n      iguana.logInfo('Message Processed '.. Err)\\n      return Err\\n   end\\n   \\nend\\n\\n\\nfunction SendFailOver(Msg)\\n   local s = llp.connect{host='devinterface01', port=7002, timeout=30,live=true}\\n   s:send(Msg) \\n   local Ack = s:recv();\\n   iguana.logInfo('Ack From FailOver :: '..Ack);\\n   s:close();\\nend\\n\\n--Sends message to FW HL7 service.\\nfunction SendMessage(Msg, PharmId)\\n   -- We need to connect FW.      \\n   local framework = Configuration.Config[\\\"FWInt\\\"..PharmId].value:S()\\n   local fwport = tonumber(Configuration.Config[\\\"FWPort\\\"..PharmId].value:S())\\n\\n   iguana.logInfo('Sending Message to host '..framework..\\\":\\\"..fwport)\\n   --if not conn then\\n     conn = llp.connect{host=framework,port=fwport,timeout=100,live=true}\\n   --end\\n   conn:send(Msg)\\n   -- if it times out here and never gets an ACK back we need to\\n   -- push this message into Failover Q.\\n    local Ack = conn:recv()\\n\\n   --don't close unless we hit an error\\n   --conn:close()\\n   return Ack\\nend\\n\\n-- we need to custom generate an ACK if we need to push this into\\n-- Q for processing later in case our llp endpoints are down.\\nfunction GenerateAck(Data,Err)   \\n      local Ack = hl7.message{vmd=PaxitConstants.NACK_VMD_file, name='Acknowledgement'}\\n      local Msg = hl7.parse{vmd=PaxitConstants.VMD_file, data=Data}\\n      Ack.MSH[3][1] = Msg.MSH[5][1]\\n      Ack.MSH[4][1] = Msg.MSH[6][1]\\n      Ack.MSH[5][1] = Msg.MSH[3][1]\\n      Ack.MSH[6][1] = Msg.MSH[4][1]\\n      Ack.MSH[10] = Msg.MSH[10]\\n      Ack.MSA[2] = Msg.MSH[10]             \\n      Ack.MSH[9][1] = 'ACK'\\n      Ack.MSH[11][1] = 'P'\\n      Ack.MSH[12] = '2.5'\\n      Ack.MSH[7] = os.date('%Y%M%d%H%m%S')   \\n      Ack.MSA[1] = 'AE'\\n      Ack.MSA[3] = Err\\n      ack.send(Ack:S())\\n   return Ack:S()\\nend\",\"ScriptType\":\"lua\",\"ScriptName\":\"main\",\"SourceHash\":\"39A6D58E8AC68EEFEC4A80DB780686DB\",\"UsesParameter\":true,\"CountOfSample\":1,\"CacheExists\":0,\"UsesHttpsParameter\":false,\"file_info\":{\"main\":{\"label\":\"main\",\"path\":\"B6CC53C02E1E65A313AAD9C757284A2A\\\\main.lua\",\"type\":\"lua\",\"editable\":true,\"current\":true,\"sourceHash\":\"39A6D58E8AC68EEFEC4A80DB780686DB\",\"status\":\"unchanged\"},\"project\":{\"status\":\"unchanged\"},\"shared\":[{\"label\":\"Config\",\"path\":\"shared/Config.lua\",\"type\":\"lua\",\"editable\":true,\"current\":false,\"status\":\"unchanged\"},{\"label\":\"PaxitConstants\",\"path\":\"shared/PaxitConstants.lua\",\"type\":\"lua\",\"editable\":true,\"current\":false,\"status\":\"unchanged\"},{\"label\":\"llp\",\"path\":\"shared/llp.lua\",\"type\":\"lua\",\"editable\":true,\"current\":false,\"status\":\"unchanged\"},{\"label\":\"node\",\"path\":\"shared/node.lua\",\"type\":\"lua\",\"editable\":true,\"current\":false,\"status\":\"unchanged\"}],\"other\":[{\"label\":\"autonack.vmd\",\"path\":\"other/autonack.vmd\",\"type\":\"vmd\",\"editable\":false,\"current\":false,\"status\":\"unchanged\"}]}}"
          },
          "redirectURL": "",
          "headersSize": 169,
          "bodySize": 9281,
