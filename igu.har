            "compression": 88753,
            "text": "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.01//EN\"\n\"http://www.w3.org/TR/html4/strict.dtd\">\n\r\n<html>  \r\n<head>\r\n\r\n   <title>Iguana &gt; Logs</title>\r\n   <!-- IE 8 and later: enforce using the latest engine -->\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\" />\n\r\n   <script type=\"text/javascript\"><!--\r\n   UniqueInstanceId = '931D8711E361D15E2E43CB851D72A4F5';\r\n   --></script>\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"/iguana.css?ver_hash=571F6291\" />\n\n\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"log.css?ver_hash=571F6291\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"jquery-ui-1-8-16/css/ui-lightness/jquery-ui-1.8.16.custom.css\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"jquery.treeview.css?ver_hash=571F6291\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"/js/treeview/treeview.css?ver_hash=571F6291\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"/js/mapper/node_treeview.css?ver_hash=571F6291\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"/js/mapper/node_types.css?ver_hash=571F6291\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"/js/help_popup/help_popup.css?ver_hash=571F6291\" />\r\n   <link rel=\"stylesheet\" type=\"text/css\" href=\"syntax_highlight.css?ver_hash=571F6291\" />\r\n   <!-- Do not add JavaScript files here; add them to jsz/makefile instead. -->\r\n   <script type=\"text/javascript\" src=\"/js/jquery142/jquery-1.4.2.min.js\"></script>\n <script type=\"text/javascript\" src=\"/js/jquery-ui-1-8-16/js/jquery-ui-1.8.16.custom.min.js\"></script> \n<script type=\"text/javascript\" src=\"/browser.js\"></script>\n\n\r\n<script type=\"text/javascript\">\r\n<!--\r\n$(document).ready(function() {\r\n   MiniLogin.init('admin',\r\n                  'password');\r\n});\r\n\r\n\n\n//\n// General Stuff\n//\n\n// Paths to icons that may need to be switched using javascript\nvar MsgFailureAckIconSrc = 'images/msg-failure-ack.gif?ver_hash=571F6291';\nvar MsgFailureIconSrc    = 'images/msg-failure.gif?ver_hash=571F6291';\n\nvar ResubmitIconGreySrc  = 'images/log-browser-resubmit-grey.gif?ver_hash=571F6291';\n\nvar ResubmitIconSrc      = 'images/log-browser-resubmit.gif?ver_hash=571F6291' ;\n\n\nvar LOGCScurrentUserCanAdmin = true;\nvar LOGCStypeFilter = '';\nvar LOGCSstandardHl7LibraryVmdPath = 'C:\\\\Program Files\\\\iNTERFACEWARE\\\\Iguana\\\\Libraries\\\\HL7_2.7.vmd';\nvar LOGCShelpIconLocation = '/images/help_icon.gif?ver_hash=571F6291';\nvar LOGCScalendarIconLocation = '/images/calendar.gif?ver_hash=571F6291';\nvar LOGCSallEntriesOption = '';\nvar LOGCSserviceEntriesOption = ' Iguana';\n\nvar LOGCSiguanaUsagePercentage = 63;\nvar LOGCSotherUsagePercentage  = 4;\n\n\n   function canEditChannel(ChannelName) { return true; }\n\n\n//\n// View Switching\n//\n\nfunction LOGCSdropdownButtonImgSrc(Mode, Pressed)\n{\n   if (Mode == 'Text')\n   {\n      return Pressed ? 'images/log_views/dropdown-text-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-text.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'Hex')\n   {\n      return Pressed ? 'images/log_views/dropdown-hex-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-hex.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'SegmentMessage')\n   {\n      return Pressed ? 'images/log_views/dropdown-segment-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-segment.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'SegmentGrammar')\n   {\n      return Pressed ? 'images/log_views/dropdown-grammar-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-grammar.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'Table')\n   {\n      return Pressed ? 'images/log_views/dropdown-table-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-table.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'TableText')\n   {\n      return Pressed ? 'images/log_views/dropdown-tableText-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-tableText.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'SQL')\n   {\n      return Pressed ? 'images/log_views/dropdown-sql-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-sql.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'PluginOutput')\n   {\n      return Pressed ? 'images/log_views/dropdown-plugin-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-plugin.gif?ver_hash=571F6291';\n   }\n   else if (Mode == 'MapperOutput')\n   {\n      return Pressed ? 'images/log_views/dropdown-translator-on.gif?ver_hash=571F6291' : 'images/log_views/dropdown-translator.gif?ver_hash=571F6291';\n   }\n}\n\nfunction LOGCSdropdownOptionImgSrc(Option, Pressed, Disabled)\n{\n   if (Option.hasClass('Text'))\n   {\n      return Disabled ? 'images/log_views/square-text-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-text-on.gif?ver_hash=571F6291' : 'images/log_views/square-text.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('Hex'))\n   {\n      return Disabled ? 'images/log_views/square-hex-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-hex-on.gif?ver_hash=571F6291' : 'images/log_views/square-hex.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('SegmentMessage'))\n   {\n      return Disabled ? 'images/log_views/square-segment-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-segment-on.gif?ver_hash=571F6291' : 'images/log_views/square-segment.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('SegmentGrammar'))\n   {\n      return Disabled ? 'images/log_views/square-grammar-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-grammar-on.gif?ver_hash=571F6291' : 'images/log_views/square-grammar.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('Table'))\n   {\n      return Disabled ? 'images/log_views/square-table-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-table-on.gif?ver_hash=571F6291' : 'images/log_views/square-table.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('TableText'))\n   {\n      return Disabled ? 'images/log_views/square-tableText-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-tableText-on.gif?ver_hash=571F6291' : 'images/log_views/square-tableText.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('SQL'))\n   {\n      return Disabled ? 'images/log_views/square-sql-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-sql-on.gif?ver_hash=571F6291' : 'images/log_views/square-sql.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('PluginOutput'))\n   {\n      return Disabled ? 'images/log_views/square-plugin-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-plugin-on.gif?ver_hash=571F6291' : 'images/log_views/square-plugin.gif?ver_hash=571F6291');\n   }\n   else if (Option.hasClass('MapperOutput'))\n   {\n      return Disabled ? 'images/log_views/square-translator-disabled.gif?ver_hash=571F6291' :\n             (Pressed ? 'images/log_views/square-translator-on.gif?ver_hash=571F6291' : 'images/log_views/square-translator.gif?ver_hash=571F6291');\n   }\n}\n\nfunction LOGCSshowMarkButton()\n{\n   ButtonElement = document.getElementById('entryMarked');\n   ImageElement = document.getElementById('entryMarkedImg');\n   \n   if (ButtonElement)\n   {\n      ButtonElement.style.display = (CurrentEntry.Type == 'Error' ? '' : 'none');\n   }\n   \n   if (ImageElement)\n   {\n      if (CurrentEntry.Acknowledged)\n      {\n         if (CurrentEntry.Deleted)\n         { \n            ImageElement.src = 'images/log-browser-ack-yes-grey.gif?ver_hash=571F6291';\n         }\n         else\n         {\n            ImageElement.src = 'images/log-browser-ack-yes.gif?ver_hash=571F6291';\n         }\n      }\n      else\n      {\n         if (CurrentEntry.Deleted)\n         { \n            ImageElement.src = 'images/log-browser-ack-no-grey.gif?ver_hash=571F6291';\n         }\n         else\n         {\n            ImageElement.src = 'images/log-browser-ack-no.gif?ver_hash=571F6291';\n         }\n      }\n   }\n\n}\n\n\n\n\n\n\nfunction LOGCSgetAvailableResubmitDialogHeight(IncludeEditDiv, IncludePreviewDiv)\n{\n   var AvailableHeight = $('#resubmitDialog').innerHeight() - 10\n                         - $('#resubmitTopControls').outerHeight()\n                         - $('#resubmitEditControls').outerHeight()\n                         - $('#resubmitPreviewControls').outerHeight()\n                         - $('#resubmitComplete').outerHeight();\n   \n   var AvailableHeightDivisor = 0;\n   if (IncludeEditDiv)\n   {\n      AvailableHeightDivisor++;\n      AvailableHeight -= 22; // resubmitEdit's top and bottom margin and border widths\n   }\n   if (IncludePreviewDiv)\n   {\n      AvailableHeightDivisor++;\n      AvailableHeight -= 12; // resubmitPreview's top and bottom margin and border widths\n   }\n   // Make sure we don't divide by 0.\n   AvailableHeightDivisor = (AvailableHeightDivisor ? AvailableHeightDivisor : 1);\n   \n   return Math.floor(AvailableHeight/AvailableHeightDivisor);\n}\n\nfunction LOGCSresizeResubmitDialog()\n{\n   var Page = document.documentElement;\n   var Frame = document.getElementById('resubmitFrame');\n   var ResubmitDialog = document.getElementById('resubmitDialog');\n   \n   Frame.style.display = 'none';\n   Frame.style.height = Math.max(Page.scrollHeight, WINgetWindowHeight()) + 'px';\n   Frame.style.width  = Page.scrollWidth  + 'px';\n   Frame.style.display = '';\n   \n   if( Frame.contentWindow )  // IE6 doesn't use iframe background colors.\n   {\n      Frame.contentWindow.document.body.style.background = 'gray';\n   }\n   \n   show('resubmitDialog');\n   \n   ResubmitDialog.style.height = (WINgetWindowHeight()\n                                 - (2*36)\n                                 - (2*5 + 10)) + 'px';\n   ResubmitDialog.style.width  = (WINgetWindowWidth()\n                                 - (2*36)\n                                 - (2*5))  + 'px';\n   \n   var ResubmitEdit = $('#messageEditor');\n   var ResubmitPreview = $('#resubmitPreview');\n   \n   var AvailableHeight = LOGCSgetAvailableResubmitDialogHeight(visible('resubmitEdit'), visible('resubmitPreview'));\n   \n   var AvailableWidth  = $(ResubmitDialog).innerWidth();\n   \n   // 6 or 2 == element's padding and border width for left and right\n   ResubmitEdit.css(   'height', AvailableHeight + 'px');\n   ResubmitEdit.css(   'width',  (AvailableWidth - (2*16 + 6)) + 'px');\n   ResubmitPreview.css('height', AvailableHeight + 'px');\n   ResubmitPreview.css('width',  (AvailableWidth - (2*16 + 2)) + 'px');\n   \n   resizeInnerViewContents();\n}\n\nfunction LOGCSinitParsersBySource()\n{\n   return {\n             \n             undefined: ['pop me'] \n          };\n}\n\nfunction LOGCSinitIsToPluginBySource()\n{\n   return {\n             \n                'Channel Manager' : 0,\n             \n                'CL - FW Outbound' : 0,\n             \n                'CLT - FW Outbound' : 0,\n             \n                'DEN - FW Outbound' : 0,\n             \n                'DFW - FW Outbound' : 0,\n             \n                'DONOTSTART ErrChnl Restore Msg' : 0,\n             \n                'DONOTSTART: Error Channel' : 0,\n             \n                'DTW - FW Outbound' : 0,\n             \n                'FailOver' : 0,\n             \n                'IAH - FW Outbound' : 0,\n             \n                'Iguana Monitor' : 0,\n             \n                'MD - FW Outbound' : 0,\n             \n                'MessageBroker' : 0,\n             \n                'OH - FW Outbound' : 0,\n             \n                'OKC - FW Outbound' : 0,\n             \n                'Paxit: CLT - FW Outbound' : 0,\n             \n                'Paxit: CLV - FW Outbound' : 0,\n             \n                'Paxit: CLV to Clev' : 0,\n             \n                'Paxit: DTW - FW Outbound' : 0,\n             \n                'Paxit: IAH - FW Outbound' : 0,\n             \n                'Paxit: OH - FW Outbound' : 0,\n             \n                'Paxit: OKC - FW Outbound' : 0,\n             \n                'Paxit: To DTW' : 0,\n             \n                'Paxit: To IAH' : 0,\n             \n                'Paxit: To OH' : 0,\n             \n                'Paxit: To OKC' : 0,\n             \n                'Paxit: To VA' : 0,\n             \n                'Paxit: VA - FW Outbound' : 0,\n             \n                'Paxit: YBR - FW Outbound' : 0,\n             \n                'Paxit: YBR to MD' : 0,\n             \n                'Procare - FW Outbound' : 0,\n             \n                'Procare Medsure' : 0,\n             \n                'Prod-MyRemediEoe' : 0,\n             \n                'Ric - FW Outbound' : 0,\n             \n                'To CL' : 0,\n             \n                'To CLT' : 0,\n             \n                'To DEN' : 0,\n             \n                'To DFW' : 0,\n             \n                'To DTW' : 0,\n             \n                'To IAH' : 0,\n             \n                'To MD' : 0,\n             \n                'To NCPDP Interface' : 0,\n             \n                'To OH' : 0,\n             \n                'To OKC' : 0,\n             \n                'To Ric' : 0,\n             \n             undefined : undefined\n          };\n}\n\nfunction LOGCSinitIsToMapperBySource()\n{\n   return {\n             \n                'Channel Manager' : 0,\n             \n                'CL - FW Outbound' : 1,\n             \n                'CLT - FW Outbound' : 1,\n             \n                'DEN - FW Outbound' : 1,\n             \n                'DFW - FW Outbound' : 1,\n             \n                'DONOTSTART ErrChnl Restore Msg' : 0,\n             \n                'DONOTSTART: Error Channel' : 1,\n             \n                'DTW - FW Outbound' : 1,\n             \n                'FailOver' : 0,\n             \n                'IAH - FW Outbound' : 1,\n             \n                'Iguana Monitor' : 0,\n             \n                'MD - FW Outbound' : 1,\n             \n                'MessageBroker' : 0,\n             \n                'OH - FW Outbound' : 1,\n             \n                'OKC - FW Outbound' : 1,\n             \n                'Paxit: CLT - FW Outbound' : 1,\n             \n                'Paxit: CLV - FW Outbound' : 1,\n             \n                'Paxit: CLV to Clev' : 1,\n             \n                'Paxit: DTW - FW Outbound' : 1,\n             \n                'Paxit: IAH - FW Outbound' : 1,\n             \n                'Paxit: OH - FW Outbound' : 1,\n             \n                'Paxit: OKC - FW Outbound' : 1,\n             \n                'Paxit: To DTW' : 1,\n             \n                'Paxit: To IAH' : 1,\n             \n                'Paxit: To OH' : 1,\n             \n                'Paxit: To OKC' : 1,\n             \n                'Paxit: To VA' : 1,\n             \n                'Paxit: VA - FW Outbound' : 1,\n             \n                'Paxit: YBR - FW Outbound' : 1,\n             \n                'Paxit: YBR to MD' : 1,\n             \n                'Procare - FW Outbound' : 1,\n             \n                'Procare Medsure' : 1,\n             \n                'Prod-MyRemediEoe' : 0,\n             \n                'Ric - FW Outbound' : 1,\n             \n                'To CL' : 0,\n             \n                'To CLT' : 0,\n             \n                'To DEN' : 0,\n             \n                'To DFW' : 0,\n             \n                'To DTW' : 0,\n             \n                'To IAH' : 0,\n             \n                'To MD' : 0,\n             \n                'To NCPDP Interface' : 1,\n             \n                'To OH' : 0,\n             \n                'To OKC' : 0,\n             \n                'To Ric' : 0,\n             \n             undefined : undefined\n          };\n}\n\n\n//\n// Iteration\n//\n\n\n\nvar Iterator = function()\n{\n   var CurrentIndex = 0;\n   function findCurrentIndex()\n   {\n      if( CurrentIndex >= LogEntries.length )\n      {\n         CurrentIndex = Math.floor(LogEntries.length / 2);\n      }\n\n      if( LogEntries[CurrentIndex].MessageId == CurrentEntry.MessageId )\n      {\n         return true;\n      }\n\n      var CurrentDate = new Date(CurrentEntry.Date);\n      var IndexDate   = new Date(LogEntries[CurrentIndex].Date);\n\n      var Delta = +1;  // Search backward in time.\n\n      if( IndexDate < CurrentDate || !(IndexDate > CurrentDate) &&\n          1*LogEntries[CurrentIndex].Position < 1*CurrentEntry.Position )\n      {\n         Delta = -1;  // Search forward in time.\n      }\n\n      var Index = CurrentIndex + Delta;\n      while( Index >= 0 && Index < LogEntries.length )\n      {\n         if( LogEntries[Index].MessageId == CurrentEntry.MessageId )\n         {\n            CurrentIndex = Index;\n            return true;\n         }\n\n         Index += Delta;\n      }\n\n      return false;\n   }\n\n   function showTooltip(Tip)\n   {\n      return function() {\n         TOOLtooltipLink(Tip, undefined, this, { Left: -8 });\n\n         this.onmouseout = function() {\n            TOOLtooltipClose();\n         }\n      }\n   }\n\n   function apply(List, Action)\n   {\n      for(var Index in List)\n      {\n         Action(List[Index]);\n      }\n   }\n\n   var Next = {\n      Action: moveNext,\n      Tip:    'Display next matching entry.',\n      NormalImage:   'images/msg-next.gif?ver_hash=571F6291',\n      HoverImage:    'images/msg-next-hover.gif?ver_hash=571F6291',\n      PressedImage:  'images/msg-next-active.gif?ver_hash=571F6291',\n      DisabledImage: 'images/msg-next-disabled.gif?ver_hash=571F6291'\n   };\n\n   var Prev = {\n      Action: movePrev,\n      Tip:    'Display previous matching entry.',\n      NormalImage:   'images/msg-prev.gif?ver_hash=571F6291',\n      HoverImage:    'images/msg-prev-hover.gif?ver_hash=571F6291',\n      PressedImage:  'images/msg-prev-active.gif?ver_hash=571F6291',\n      DisabledImage: 'images/msg-prev-disabled.gif?ver_hash=571F6291'\n   };\n\n   function enableButton(Button, Details)\n   {\n      Button.src     = Details.NormalImage;\n      Button.onclick = Details.Action;\n\n      Button.onmouseover = function() {\n         this.src = Details.HoverImage;\n         TOOLtooltipLink(Details.Tip, undefined, this, { Left: -12 });\n      };\n      Button.onmouseout = function() {\n         this.src = Details.NormalImage;\n         TOOLtooltipClose();\n      };\n      Button.onmousedown = function() {\n         this.src = Details.PressedImage;\n      };\n      Button.onmouseup = function() {\n         this.src = Details.HoverImage;\n      };\n   }\n\n   function disableButton(Button, Details)\n   {\n      Button.src     = Details.DisabledImage;\n      Button.onclick = null;\n\n      Button.onmouseover = function() {\n         TOOLtooltipLink(Details.Tip, undefined, this, { Left: -12 });\n      };\n      Button.onmouseout = function() {\n         TOOLtooltipClose();\n      };\n      Button.onmousedown = null;\n      Button.onmouseup   = null;\n   }\n\n   var NextButtons;\n   var EnabledNext;\n   function enableNext()\n   {\n      if( !EnabledNext )\n      {\n         EnabledNext = true;\n         enableButton(document.getElementById('entryNext'), Next);\n      }\n   }\n\n   var PrevButtons;\n   var EnabledPrev;\n   function enablePrev()\n   {\n      if( !EnabledPrev )\n      {\n         EnabledPrev = true;\n         enableButton(document.getElementById('entryPrev'), Prev);\n      }\n   }\n\n   function disableNext()\n   {\n      if( EnabledNext )\n      {\n         EnabledNext = false;\n         disableButton(document.getElementById('entryNext'), Next);\n      }\n   }\n\n   function disablePrev()\n   {\n      if( EnabledPrev )\n      {\n         EnabledPrev = false;\n         disableButton(document.getElementById('entryPrev'), Prev);\n      }\n   }\n\n   function moveNext()\n   {\n      var MoveOk = true;\n      if( !findCurrentIndex() )\n      {\n         disableNext();\n         disablePrev();\n         MoveOk = false;\n      }\n      else\n      {\n         if( CurrentIndex > 0 )\n         {\n            showEntry( LogEntries[--CurrentIndex], 'next' );\n            enablePrev();\n         }\n\n         if( CurrentIndex <= 0 && Finished['forward'] )\n         {\n            disableNext();\n            MoveOk = false;\n         }\n         else if( CurrentIndex < 5 )\n         {\n            showMore('forward');\n         }\n      }\n      return MoveOk;\n   }\n\n   function movePrev()\n   {\n      var MoveOk = true;\n      if( !findCurrentIndex() )\n      {\n         disableNext();\n         disablePrev();\n         MoveOk = false;\n      }\n      else\n      {\n         if( CurrentIndex < LogEntries.length - 1 )\n         {\n            showEntry( LogEntries[++CurrentIndex], 'previous' );\n            enableNext();\n         }\n\n         if( CurrentIndex >= LogEntries.length - 1 && Finished['reverse'] )\n         {\n            disablePrev();\n            MoveOk = false;\n         }\n         else if( LogEntries.length - CurrentIndex <= 5 )\n         {\n            showMore('reverse');\n         }\n      }\n      return MoveOk;\n   }\n\n   var Enabled;\n   function updateButtons()\n   {\n      if( Enabled && CurrentEntry && findCurrentIndex() )\n      {\n         var EnableNext = CurrentIndex > 0                     || !Finished[\"forward\"];\n         var EnablePrev = CurrentIndex < LogEntries.length - 1 || !Finished[\"reverse\"];\n\n         if( EnableNext ) enableNext(); else disableNext();\n         if( EnablePrev ) enablePrev(); else disablePrev();\n      }\n   }\n\n   return {\n      enable: function() {\n         enableNext();\n         enablePrev();\n         Enabled = true;\n         updateButtons();\n      },\n      disable: function() {\n         disableNext();\n         disablePrev();\n         Enabled = false;\n      },\n      update: updateButtons,\n      next: moveNext,\n      prev: movePrev\n   };\n}();\n\n\n\n\n//\n// Side-bar Goodies\n//\n\nvar LOGCSinitialDequeueSourceNames = '';\nvar LOGCSinitialIncludeSourceLogs = '' == 'true';\nvar LOGCSinitialJumpToQueueEnd = '' == 'true';\n\nvar LOGCSchannelSources  = new Array();\n\n   LOGCSchannelSources['Channel Manager'] = [\n   'bogus'];\n   LOGCSchannelSources['Channel Manager'].pop();\n\n   LOGCSchannelSources['CL - FW Outbound'] = [\n   'CL - FW Outbound','bogus'];\n   LOGCSchannelSources['CL - FW Outbound'].pop();\n\n   LOGCSchannelSources['CLT - FW Outbound'] = [\n   'CLT - FW Outbound','bogus'];\n   LOGCSchannelSources['CLT - FW Outbound'].pop();\n\n   LOGCSchannelSources['DEN - FW Outbound'] = [\n   'DEN - FW Outbound','bogus'];\n   LOGCSchannelSources['DEN - FW Outbound'].pop();\n\n   LOGCSchannelSources['DFW - FW Outbound'] = [\n   'DFW - FW Outbound','bogus'];\n   LOGCSchannelSources['DFW - FW Outbound'].pop();\n\n   LOGCSchannelSources['DONOTSTART ErrChnl Restore Msg'] = [\n   'DONOTSTART ErrChnl Restore Msg','bogus'];\n   LOGCSchannelSources['DONOTSTART ErrChnl Restore Msg'].pop();\n\n   LOGCSchannelSources['DONOTSTART: Error Channel'] = [\n   'DONOTSTART: Error Channel','bogus'];\n   LOGCSchannelSources['DONOTSTART: Error Channel'].pop();\n\n   LOGCSchannelSources['DTW - FW Outbound'] = [\n   'DTW - FW Outbound','bogus'];\n   LOGCSchannelSources['DTW - FW Outbound'].pop();\n\n   LOGCSchannelSources['FailOver'] = [\n   'FailOver','bogus'];\n   LOGCSchannelSources['FailOver'].pop();\n\n   LOGCSchannelSources['IAH - FW Outbound'] = [\n   'IAH - FW Outbound','bogus'];\n   LOGCSchannelSources['IAH - FW Outbound'].pop();\n\n   LOGCSchannelSources['Iguana Monitor'] = [\n   'bogus'];\n   LOGCSchannelSources['Iguana Moni