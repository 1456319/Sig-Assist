            "mimeType": "text/css",
            "text": "div.EDTtoolbar_wrapper{\r\n position : absolute;\r\n top : 0px;\r\n left: 0px;\r\n right: 0px;\r\n height:24px; /* = true div height - vertical padding */\r\n -moz-border-radius:5px 5px 0 0;\r\n -webkit-border-radius:5px 5px 0 0;\r\n background:url(\"/js/mapper/images/toolbar/th_bg.gif\") repeat-x scroll left bottom #DEDEDE;\r\n font: normal 10px \"Lucida Sans\", sans-serif;\r\n color: #666666;\r\n line-height: 24px;\r\n padding: 6px 15px;\r\n -moz-text-shadow: 0 1px 1px #F7F7F7;\r\n -webkit-text-shadow: 0 1px 1px #F7F7F7;\r\n text-shadow: 0 1px 1px #F7F7F7;\r\n text-align: center;\r\n}\r\n\r\ndiv.EDTtoolbar_wrapper form {\r\n\tmargin-left: -15px;\r\n}\r\n\r\nspan.EDTno_sd{\r\n\tcolor: red;\r\n}\r\n\r\n\r\n/* SECTION class is used to group toolbar functions that belong together */\r\n\r\n.section {\r\n\tfloat: left;\r\n\tpadding: 0px 10px 0px 10px;\r\n\tborder-right: 1px solid #bbb;\r\n}\r\n\r\n.section span {\r\n\tfloat: left;\r\n}\r\n\r\n.section span a {\r\n\tcolor: #666;\r\n\ttext-decoration: none;\r\n}\r\n\r\n.section span a:hover {\r\n\tcolor: #009de8;\r\n}\r\n\r\n.label {\r\n\tmargin-right: 5px;\r\n    margin-left: 5px;\r\n}\r\n\r\n.heading {\r\n\ttext-transform: uppercase;\r\n}\r\n\r\n\r\n/* \"BACK TO\" SECTION */\r\n\r\n.back {\r\n\tfloat: left;\r\n}\r\n\r\n.back a {\r\n\tcolor: #666;\r\n}\r\n\r\n.back a:hover {\r\n\tcolor: #009de8;\r\n}\r\n\r\n\r\n/* SAMPLE DATA BUTTONS */\r\n\r\n\r\na.button_msg {\r\n    color: #444;\r\n    font: normal 10px \"Lucida Sans\", sans-serif;\r\n    text-decoration: none;\r\n}\r\n\r\na.button_msg span {\r\n    background: transparent url('/js/mapper/images/toolbar/bg_button_span.gif') no-repeat -5px 0px;\r\n    display: block;\r\n    line-height: 10px;\r\n    padding: 7px 10px 8px 10px;\r\n}\r\n\r\na.button_msg.disabled span {\r\n    background-image: url('/js/mapper/images/toolbar/bg_button_span_disable.gif');\r\n    color: #888;\r\n} \r\n\r\na.button_msg.enabled:active {\r\n    color: #000;\r\n    outline: none; /* hide dotted outline in Firefox */\r\n}\r\n\r\na.button_msg.enabled:active span {\r\n    background: transparent url('/js/mapper/images/toolbar/bg_button_span.gif') no-repeat scroll -5px -25px;\r\n} \r\n\r\na.button_msg_icon {\r\n\tdisplay: block;\r\n\theight: 25px;\r\n\twidth: 30px;\r\n\tbackground-position: top left;\r\n\tfloat: left;\r\n\tmargin-right: 0px;\r\n}\r\n\r\na.button_msg_icon span {\r\n\tdisplay: none;\r\n}\r\n\r\na.button_msg_icon.enabled:active {\r\n\tbackground-position: bottom left;\r\n}\r\n\r\n\r\n\r\n\r\n/* TOOLBAR BUTTONS */\r\n\r\na.button_icon {\r\n\tdisplay: block;\r\n\theight: 25px;\r\n\twidth: 30px;\r\n\tbackground-position: top left;\r\n\tfloat: left;\r\n\tmargin-left: 1px;\r\n\tmargin-right: 1px;\r\n        cursor: pointer;\r\n}\r\n\r\na.button_icon span {\r\n\tdisplay: none;\r\n}\r\n\r\na.button_icon.enabled:active {\r\n\tbackground-position: bottom left;\r\n}\r\n\r\na.on {\t/* For pressed toggle buttons */\r\n\tbackground-position: bottom left !important;\r\n}\r\n\r\na.disabled {\t/* For disabled toggle buttons */\r\n\tbackground-position: center left;\r\n\tcursor: default;\r\n}\r\n\r\ndiv.disabled {\r\n        width:30px;\r\n        height:25px;\r\n        float:left;\r\n        cursor:pointer;\r\n        margin-left:1px;\r\n        margin-right:1px;\r\n        display:block;\r\n}\r\n\r\n/* TOOLBAR BUTTONS */\r\na.connected{\r\n\tmargin-left: 0px;\r\n\tmargin-right: 0px;\r\n}\r\n\r\n\r\n\r\n\r\n/* BUTTON images */\r\n\r\na#edit_message {\t\r\n        background-image: url('/js/mapper/images/toolbar/button_msg_edit.gif');\r\n}\r\n\r\na#sample_data {\t\r\n        background-image: url('/js/mapper/images/toolbar/button_sample_data.gif');\r\n}\r\n\r\na#project_pane_toggle {\r\n        background-image: url('/js/mapper/images/toolbar/button_pmpane.gif');\r\n}\r\n\r\na#thumbnail_toggle {\t\r\n   background-image: url('/js/mapper/images/toolbar/button_thumbnail.gif');\r\n}\r\n\r\na#thumbnail_toggle.disabled {\r\n   background-image: url('/js/mapper/images/toolbar/button_thumbnail_disabled.gif');\r\n}\r\n\r\na#milestone {\r\n\tbackground-image: url('/js/mapper/images/toolbar/button_milestone.gif');\r\n}\r\n\r\na#revisions {\r\n\tbackground-image: url('/js/mapper/images/toolbar/button_revisions.gif');\r\n}\r\na#treeview {\r\n\tbackground-image: url('/js/mapper/images/toolbar/button_treeview.gif');\r\n}\r\na#executeScriptButton {\r\n   background-image: url('/js/mapper/images/toolbar/button_runscript.gif');\r\n}\r\na#script_stopper {\r\n   background-image: url('/js/mapper/images/toolbar/button_stop_script.gif');\r\n}\r\na#autoexecution_toggle {\r\n   background-image: url('/js/mapper/images/toolbar/button_autoexecute.gif');\r\n}\r\n\r\na#history {\r\n\tbackground-image: url('/js/mapper/images/toolbar/button_history.gif');\r\n}\r\n\r\na#log {\r\n\tbackground-image: url('/js/mapper/images/toolbar/button_log.gif');\r\n}\r\n\r\na#msg_first {\r\n\tbackground-image: url('/js/mapper/images/toolbar/button_msg_first.gif');\r\n}\r\na#msg_prev {\r\n\tbackground-image: url('/js/mapper/images/toolbar/button_msg_prev.gif');\r\n}\r\na#msg_next {\r\n\tbackground-image: url('/js/mapper/images/toolbar/button_msg_next.gif');\r\n}\r\na#msg_last {\r\n\tbackground-image: url('/js/mapper/images/toolbar/button_msg_last.gif');\r\n\tmargin-right: 1px;\r\n}\r\n\r\na#search_prev {\r\n   background-image: url('/js/mapper/images/toolbar/button_search_up.gif');\r\n   width: 23px;\r\n}\r\n\r\na#search_next {\r\n   background-image: url('/js/mapper/images/toolbar/button_search_down.gif');\r\n   width: 23px;\r\n}\r\n\r\n\r\n/* GOTO popup */\r\n\r\ndiv.EDTsd_goto{\r\n position: absolute;\r\n background: #DEDEDE;\r\n vertical-align: middle;\r\n color: #444444;\r\n border: 1px solid #B1B1B1;\r\n border-top: none;\r\n -moz-border-radius: 0px 0px 5px 5px;\r\n -webkit-border-radius: 0px 0px 5px 5px;\r\n padding: 3px 8px 3px 8px;\r\n z-index: 11; /* 1 + codemirror gutter z-index */\r\n}\r\n\r\ndiv.EDTsd_goto input.EDTsd_gotoInput{\r\n width: 30px;\r\n margin: 0;\r\n padding: 0;\r\n border: 1px solid #b1b1b1;\r\n}\r\n\r\ndiv.EDTsd_goto img{\r\n cursor: pointer;\r\n margin-top: -2px;\r\n margin-left: 3px;\r\n vertical-align: middle;\r\n}\r\n\r\n/* Search Field */\r\n\r\n#SRHbox{\r\n float: right;\r\n}\r\n\r\n#SRHbox span.SRHmatchCount{\r\n float: left;\r\n}\r\n\r\n#SRHbox div.SRHfield{\r\n border: 1px solid #BBB;\r\n background-color: #F7F7F7;\r\n -moz-box-shadow: 0px 1px 1px #D5D5D5 inset;\r\n -webkit-box-shadow: 0px 1px 1px #D5D5D5 inset;\r\n box-shadow: 0px 1px 1px #D5D5D5 inset;\r\n height: 22px;\r\n margin-left: 5px;\r\n padding-right: 2px;\r\n float: left;\r\n cursor: default;\r\n -moz-border-radius: 5px 0 0 5px;\r\n -webkit-border-radius: 5px 0 0 5px;\r\n}\r\n\r\n#imgMagnifyingGlass, #imgSearchClear{\r\n position: relative;\r\n top: 1px;\r\n padding-left: 2px;\r\n padding-right: 2px;\r\n cursor: pointer;\r\n}\r\n\r\n#SRHbox #imgMagnifyingGlass{\r\n left: 3px;\r\n}\r\n\r\n#SRHbox input#SRHsearchText {\r\n border-width: 0px;\r\n color: #343434;\r\n position: relative;\r\n left: 2px;\r\n width: 120px;\r\n font-size: 12px;\r\n background-color: transparent;\r\n}\r\n\r\n#SRHbox input#SRHsearchText:focus{\r\n outline: none;\r\n}\r\n\r\n#SRHbox.empty #imgSearchClear{\r\n visibility: hidden;\r\n}\r\n\r\n#SRHbox.empty a {\r\n background-position: center left; /* disable the button */\r\n}\r\n\r\n#SRHbox.no_match div.SRHfield{\r\n background-color: #FADCDC !important;\r\n}\r\n\r\n#SRHbox.no_match input#SRHsearchText{\r\n color: #8E2525;\r\n}\r\n\r\n/* Remove 'x' in IE10+ */\r\n#SRHbox input#SRHsearchText::-ms-clear {\r\n    display: none;\r\n}\r\n\r\n#SRHoptions{\r\n position: absolute;\r\n background: #DEDEDE;\r\n vertical-align: middle;\r\n color: #444444;\r\n border: 1px solid #B1B1B1;\r\n -moz-border-radius: 5px 5px 5px 5px;\r\n -webkit-border-radius: 5px 5px 5px 5px;\r\n padding: 3px 8px 3px 8px;\r\n display: none;\r\n z-index: 11; /* 1 + codemirror gutter z-index */\r\n font-size: 12px;\r\n line-height: normal;\r\n text-align: left;\r\n}\r\n\r\n#SRHoptions .SRHcheckboxes{\r\n text-align: left;\r\n}\r\n\r\n#SRHoptions .SRHcheckboxes input,\r\n#SRHoptions .SRHcheckboxes label{\r\n cursor: pointer;\r\n}\r\n\r\n#SRHoptions label{\r\n padding-left: 3px;\r\n}\r\n\r\n#SRHoptions .SRHdivider {\r\n border-top: 1px solid #B1B1B1;\r\n margin: 3px -5px 3px -5px;\r\n}\r\n\r\n#SRHreplacementText{\r\n width: 140px;\r\n position: relative;\r\n margin-bottom: 2px;\r\n}\r\n\r\n#SRHoptions span{\r\n position: absolute;\r\n top: 5px;\r\n left: 5px;\r\n font-size: 12px;\r\n color: #B1B1B1;\r\n cursor: text;\r\n}\r\n\r\n.subItem {\r\n    position:relative;\r\n    left: 25px;\r\n}\r\n\r\n.settingsDropDownButton {\r\n    background-image: url('/js/mapper/images/toolbar/button_settings_dropdown.gif');\r\n}\r\n\r\n.toolbarSubMenu {\r\n    position: absolute;\r\n    background: #DEDEDE;\r\n    color: #444444;\r\n    border: 1px solid #B1B1B1;\r\n    border-radius: 5px 5px 5px 5px;\r\n    top:25px;\r\n    left:0px;\r\n    height:auto;\r\n    padding: 2px 10px 10px 10px;\r\n    clear:both;\r\n    float:none;\r\n    text-align:left;\r\n    font: 10px/20px \"Lucida Sans\", sans-serif;\r\n    text-shadow: 0 1px 1px #F7F7F7;\r\n}\r\n\r\nh3.SubMenuHeader {\r\n    border-bottom: 1px solid #B1B1B1;\r\n    margin: 6px 0px;\r\n    color: #777777;\r\n    font-weight: normal;\r\n    font-size: 9px;\r\n    text-transform: uppercase;\r\n    text-shadow: 0 1px 1px #F7F7F7;\r\n}\r\n\r\n.toolbarSubMenu label input {\r\n    margin-right: 5px;\r\n}\r\n\r\n.toolbarSubMenu label {\r\n    display: block;\r\n    padding-left: 15px;\r\n    text-indent: -15px;\r\n    font-weight: normal;\r\n    color: #666666;\r\n}\r\n\r\na.button_icon_wide {\r\n    display: block;\r\n    height: 25px;\r\n    width: 40px;\r\n    background-position: top left;\r\n    float: left;\r\n    margin-left: 1px;\r\n    margin-right: 1px;\r\n    cursor: pointer;\r\n}\r\n\r\n.toolbarSectionChild {\r\n    display:inline-block;position:relative;float:left;\r\n}"
