            "mimeType": "text/css",
            "text": "/* \r\n   Important Note: The dock toolbar, tabs and dock content are positioned relative to one another.  Changing any style that \r\n   will affect size or position of a component may impact other components of the dock.  In particular, components may become \r\n   misaligned and tab scrolling may break.  If any changes are required, please ensure that all aspects of the dock are \r\n   well tested at all zoom levels. \r\n*/\r\n\r\ndiv#bottom_dock{\r\n position:absolute;\r\n bottom:32px;\r\n left:0px;\r\n right:0px;\r\n height:100px;\r\n display:none;\r\n background-color:#FFFFFF;\r\n padding:10px;\r\n border-top:5px double #B1B1B1;\r\n /*border-top: 1px solid #B1B1B1;*/\r\n min-width:950px;\r\n}\r\n\r\ndiv#popup_dock{\r\n left:0px;\r\n right:0px;\r\n display:none;\r\n background-color:#FFFFFF;\r\n padding:10px;\r\n}\r\n\r\ndiv.dock_content{\r\n position:absolute;\r\n overflow: auto;\r\n right:0px;\r\n left:0px;\r\n margin-top:1px;\r\n padding-left:10px;\r\n padding-right:10px;\r\n}\r\n\r\ndiv#bottom_dock div.dock_content{\r\n top:30px;\r\n bottom:0px;\r\n}\r\n\r\ndiv#popup_dock div.dock_content{\r\n top:69px;\r\n bottom:5px;\r\n}\r\n\r\ndiv.dock_content div.hidden{\r\n display:none;\r\n}\r\n\r\ndiv.dock_toolbar{\r\n position:absolute;\r\n left:0px;\r\n right:0px;\r\n height:30px;\r\n color:#444444;\r\n background: url(\"/js/mapper/images/toolbar/th_bg.gif\") repeat-x scroll left bottom #DEDEDE;\r\n border-bottom: 3px solid #B1B1B1;  \r\n}\r\n\r\ndiv#bottom_dock div.dock_toolbar{\r\n top:0px;\r\n}\r\n\r\ndiv#popup_dock div.dock_toolbar{\r\n border-top:1px solid #B1B1B1;\r\n top:39px;\r\n width:100%;\r\n}\r\n\r\ndiv.dock_tabs{\r\n float:left;\r\n overflow:hidden;\r\n} \r\n\r\nul.dock_tabs{\r\n list-style:none;\r\n padding:0;\r\n margin:0;\r\n}\r\n\r\nul.dock_tabs li{\r\n -moz-border-radius-topleft:4px;\r\n -moz-border-radius-topright:4px;\r\n -webkit-border-top-left-radius:4px;\r\n -webkit-border-top-right-radius:4px;\r\n border-radius-topleft:4px;\r\n border-radius-topright:4px; \r\n padding:0px;\r\n padding-top:5px;\r\n border:1px solid #B1B1B1;\r\n position:absolute;\r\n bottom:-1px;\r\n margin:0;\r\n font-weight:bold;\r\n font-family:Verdana;\r\n color:#315D00;\r\n width:150px;\r\n height:18px;\r\n cursor:pointer;\r\n background: #DEDEDE;\r\n}\r\n\r\nul.dock_tabs li div.tab_content{\r\n padding-right:5px;\r\n padding-left:5px;\r\n}\r\n\r\nul.dock_tabs li div.tab_content div{\r\n position: relative;\r\n z-index: 1;\r\n}\r\n\r\nul.dock_tabs li div.highlight_tab{\r\n position: absolute;\r\n top: 0px;\r\n bottom: -3px;\r\n left: 0px;\r\n right: 0px;\r\n background-color: #A0CFEC;\r\n}\r\n\r\nul.dock_tabs li.visible{\r\n visibility:visible;\r\n}\r\n\r\nul.dock_tabs li.hidden{\r\n visibility:hidden;\r\n}\r\n\r\nul.dock_tabs li a{\r\n font-weight:bold;\r\n font-family:Monospace,Verdana;\r\n color:#315D00;\r\n font-size:11px;\r\n outline:0;\r\n text-decoration:none;\r\n}\r\n\r\nul.dock_tabs li a:hover{\r\n color:#315D00;\r\n}\r\n\r\nul.dock_tabs li a.icon{\r\n padding-left:20px;\r\n}\r\n\r\nul.dock_tabs li a.dock_tab_label{\r\n float:left;\r\n}\r\n\r\nul.dock_tabs li a.dock_tab_label.error{\r\n background-image: url('/js/mapper/images/icon_error.gif');\r\n background-position: 2px;\r\n}\r\n\r\nul.dock_tabs li a.dock_tab_label.help{\r\n background-image: url('/js/mapper/images/icon_help.gif');\r\n}\r\n\r\ndiv.dock_tabs li.waiting a.dock_tab_label{\r\n background-image: url('/js/mapper/images/spinner.gif') !important;\r\n}\r\n\r\ndiv.dock_tabs li.error_stack a.dock_tab_label{\r\n padding-left: 18px;\r\n padding-top: 1px;\r\n padding-bottom: 1px;\r\n background: transparent url('/js/mapper/images/error_call_stack.png') no-repeat center left;\r\n}\r\n\r\nul.dock_tabs li a.dock_tab_button{\r\n float:right;\r\n}\r\n\r\nul.dock_tabs li a.dock_tab_button img{\r\n height:10px;\r\n width:10px;\r\n border:0px;\r\n padding:1px;\r\n vertical-align:middle;\r\n}\r\n\r\nul.dock_tabs li.selected{\r\n background-color:#FFFFFF;\r\n}\r\n\r\nul.dock_tabs li.selected div.tab_content{\r\n height:23px;\r\n background-color:#FFFFFF;\r\n}\r\n\r\ndiv.dock_buttons{\r\n float:right;\r\n padding:3px;\r\n}\r\n\r\ndiv.dock_buttons a.scroll img{\r\n height:27px;\r\n width:20px;\r\n vertical-align:bottom;\r\n border:0px;\r\n}\r\n\r\ndiv.dock_buttons a{\r\n text-decoration:none;\r\n border:0px;\r\n}\r\n\r\ndiv.dock_buttons img{\r\n height:20px;\r\n width:20px;\r\n border:0px;\r\n vertical-align:top;\r\n}\r\n\r\n/* added to support jquery ui dialog.  It allows adding a dock button next to the current close button in the dialog */\r\n.ui-dialog .ui-dialog-titlebar-dock{\r\n position: absolute;\r\n right: 23px; top: 50%;\r\n width: 19px;\r\n margin: -10px 0 0 0;\r\n padding: 1px;\r\n height: 18px;\r\n}\r\n\r\n.ui-dialog .ui-dialog-titlebar-dock span {\r\n display: block;\r\n margin: 1px;\r\n}\r\n\r\n.ui-dialog .ui-dialog-titlebar-dock:hover, .ui-dialog .ui-dialog-titlebar-dock:focus {\r\n padding: 0;\r\n}\r\n/* =======================================================================================   */\r\n"
          },
