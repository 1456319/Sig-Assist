            "mimeType": "text/css",
            "text": "div.ITSpopupProtector{\r\n   position: absolute;\r\n   top: 0px;\r\n   left: 0px;\r\n   right: 0px;\r\n   bottom: 0px;\r\n   overflow: hidden;\r\n}\r\n\r\n.intellisensePopup\r\n{\r\n   z-index: 100;\r\n   position: absolute;\r\n   border: 1px solid #C5C6A4;\r\n   background-color: #FFFFCC;\r\n   font-family: monospace;\r\n\r\n   box-shadow: 0 1px 2px #AAA;\r\n   -moz-box-shadow: 0 1px 2px #AAA;\r\n   -webkit-box-shadow: 0 1px 2px #AAA;\r\n   border-radius: 4px;\r\n   -moz-border-radius: 4px 4px;\r\n   -webkit-border-radius: 4px 4px;\r\n}\r\n\r\n.intellisenseOptionsContainer\r\n{\r\n   overflow: auto;\r\n   height: 100%\r\n}\r\n\r\n.intellisensePopup table.intellisenseOptionsList\r\n{\r\n    width: 100%;\r\n    position: static;\r\n}\r\n\r\n.intellisensePopup table.intellisenseOptionsList tr\r\n{\r\n   cursor: pointer;\r\n}\r\n\r\n.intellisensePopup table.intellisenseOptionsList tr.hover td\r\n{\r\n   background-color: #B9F5D0;\r\n}\r\n\r\n.intellisensePopup table.intellisenseOptions td\r\n{\r\n   padding-right: 4px;\r\n   padding-left: 24px;\r\n   background-repeat: no-repeat;\r\n   background-position: 2px 0;\r\n   white-space: nowrap;\r\n   font-size: 12px;\r\n}\r\n\r\n.intellisensePopup table.intellisenseOptionsHelp td\r\n{\r\n   white-space: nowrap;\r\n   padding-right: 10px;\r\n   font-size: 12px;\r\n}\r\n\r\n.intellisensePopup div.intellisenseHelpTitle\r\n{\r\n    padding: 2px 2px 3px 0px;\r\n    font-size: 9px;\r\n    font-family: Verdana, Geneva, sans-serif;\r\n    color: #898671;\r\n    border-bottom: 1px solid #e4e3c5;\r\n    background: #f8f2cc; /* for non-css3 browsers */\r\n    background: -moz-linear-gradient(#fffddc, #f5efc6) repeat scroll 0 0 transparent;\r\n    background: -webkit-gradient(linear, left top, left bottom, from(#fffddc), to(#f5efc6));\r\n}\r\n\r\ndiv.intellisenseHelpTitle div.intellisenseHelpButtons\r\n{\r\n   float: right;\r\n   padding-left: 7px;\r\n   padding-top: 1px;\r\n   padding-right: 1px;\r\n   height: 0px; /* minimum height */\r\n}\r\n\r\ndiv.intellisenseHelpButtons img\r\n{\r\n   padding-bottom: 1px;\r\n}\r\n\r\ndiv.intellisenseHelpTitle\r\n{\r\n   cursor: pointer;\r\n}\r\n\r\nspan.intellisenseOptionValue\r\n{\r\n   color: #666666;\r\n}\r\n\r\nspan.intellisenseOptionHelpValue\r\n{\r\n   color: #5C5C5C;\r\n}\r\n\r\nspan.intellisenseSearchMatch\r\n{\r\n   font-weight: bold;\r\n}\r\n\r\nspan.intellisenseLevelDivider\r\n{\r\n   padding-left: 16px;\r\n   background-image: url(/js/treeview/images/arrow-contracted.gif);\r\n   background-repeat: no-repeat;\r\n   background-position: 6px center;\r\n}\r\n\r\ntd.intellisenseOptionsTruncatedWarning\r\n{\r\n   background-image: url(/js/treeview/images/ellipsis.gif);\r\n   font-family: Verdana,Arial,Helvetica,Geneva,Lucida,sans-serif;\r\n   font-style: italic;\r\n   color: #333333;\r\n   background-color: #ddded6;\r\n   cursor: default;\r\n}\r\n"
