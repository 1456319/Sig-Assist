          "content": {
            "size": 4281,
            "mimeType": "text/css",
            "text": "div.PRJtitle{\r\n padding-left: 14px;\r\n border-bottom: 1px solid #d2dee2;\r\n background: #e1edf0 url(/js/mapper/images/shadow.png) repeat-y scroll right top;\r\n color: #4e6f91;\r\n font-size: 10px;\r\n line-height: 26px;\r\n height: 26px;\r\n text-transform: uppercase;\r\n cursor: default;\r\n}\r\n\r\ndiv.PRJtitle span.PRJps_edited{\r\n background: transparent url('/js/mapper/images/icon_modified.gif') no-repeat scroll right 1px;\r\n padding-right: 14px;\r\n}\r\n\r\ndiv#PRJcontents{\r\n position: absolute;\r\n top: 26px;\r\n bottom: 0px;\r\n left: 0px;\r\n right: 0px;\r\n overflow: auto;\r\n padding-top: 7px;\r\n}\r\n\r\nspan.PRJfile{\r\n border: 1px solid transparent;\r\n height: 16px;\r\n}\r\n\r\n/* selectable */\r\nspan.PRJfile.s{\r\n cursor: pointer;\r\n}\r\n\r\n/* current */\r\nspan.PRJfile.c{\r\n background-color: #DFF4FC;\r\n border-color: #c1e4fb;\r\n border-radius: 4px;\r\n -moz-border-radius: 4px;\r\n padding-right: 4px !important;\r\n}\r\n\r\n/* waiting */\r\nspan.PRJfile.w{\r\n background-image: url(/js/mapper/images/spinner.gif);\r\n background-position: 5px 0px !important; /* in case the status changes the position */\r\n}\r\n\r\n/* file types */\r\nspan.PRJft_lua   { background-image: url(/js/mapper/images/project/file-script.gif); }\r\nspan.PRJft_css   { background-image: url(/js/mapper/images/project/file-css.gif); }\r\nspan.PRJft_dbs   { background-image: url(/js/mapper/images/project/file-dbs.gif); }\r\nspan.PRJft_htmlmixed   { background-image: url(/js/mapper/images/project/file-htmlmixed.gif); }\r\nspan.PRJft_javascript   { background-image: url(/js/mapper/images/project/file-javascript.gif); }\r\nspan.PRJft_plsql   { background-image: url(/js/mapper/images/project/file-plsql.gif) ; }\r\nspan.PRJft_xml   { background-image: url(/js/mapper/images/project/file-xml.gif); }\r\nspan.PRJft_vmd   { background-image: url(/js/mapper/images/project/file-vmd.gif); }\r\nspan.PRJft_other { background-image: url(/js/mapper/images/project/file-generic.gif); }\r\n\r\n/* file status */\r\nspan.PRJfs_new    { background-position: 5px -32px !important; }\r\nspan.PRJfs_edited { background-position: 5px -64px !important; }\r\nspan.PRJfs_missing { background-position: 5px -96px !important; }\r\n\r\n/* folders */\r\nli.expandable  span.PRJfolder { background-image: url(/js/mapper/images/project/folder-closed.gif); }\r\nli.collapsable span.PRJfolder { background-image: url(/js/mapper/images/project/folder-open.gif); }\r\n\r\na.PRJcontextMenuButton img{\r\n padding-left: 4px;\r\n padding-right: 4px;\r\n}\r\n\r\ndiv.PRJfileContextMenu{\r\n position: absolute;\r\n background-color: white;\r\n cursor: default;\r\n display: none;\r\n z-index: 11; /* 1 + codemirror gutter z-index */\r\n}\r\n\r\ndiv.PRJfileContextMenu, div.PRJleft{\r\n border: 1px solid #488AC7;\r\n}\r\n\r\ndiv.PRJleft{\r\n width: 16px;\r\n height: 15px;\r\n border-right: none;\r\n background: white url(/js/treeview/images/arrow-expanded.gif) no-repeat scroll center center;\r\n float: left;\r\n position: relative;\r\n left: -17px;\r\n top: -1px;\r\n z-index: 11; /* 1 + codemirror gutter z-index */\r\n}\r\n\r\ndiv.PRJinner{\r\n float: left;\r\n position: relative;\r\n left: -17px;\r\n}\r\n\r\ndiv.PRJinner a:visited,\r\ndiv.PRJinner a,\r\nspan.PRJfolder a:visited,\r\nspan.PRJfolder a {\r\n color: #2B547E;\r\n}\r\n\r\ndiv.PRJinner a div{\r\n padding-left: 25px;\r\n padding-top: 3px;\r\n padding-bottom: 3px;\r\n background-repeat: no-repeat;\r\n background-position: 5px 1px;\r\n cursor: pointer;\r\n}\r\n\r\ndiv.PRJinner a:hover div,\r\nspan.PRJfolder a:hover {\r\n color: #488AC7;\r\n}\r\n\r\ndiv.PRJoptionDiff { background-image: url(/js/mapper/images/project/action-diff.gif); }\r\ndiv.PRJoptionFileHistory { background-image: url(/js/mapper/images/project/action-filehistory.gif); }\r\ndiv.PRJoptionRemove { background-image: url(/js/mapper/images/project/action-remove.gif); }\r\ndiv.PRJoptionDownload { background-image: url(/js/mapper/images/project/action-get.gif); }\r\ndiv.PRJoptionUpload { background-image: url(/js/mapper/images/project/action-replace.gif); }\r\n\r\n.PRJerror{\r\n color: red;\r\n}\r\n\r\ndiv#PRJuploadDialog{\r\n white-space: nowrap;\r\n}\r\n\r\n#PRJaddOtherFileDialog fieldset,\r\n#PRJaddSharedFileDialog fieldset{\r\n border-radius: 4px;\r\n border: solid 1px #AAAAAA;\r\n margin-top: 3px;\r\n margin-bottom: 3px;\r\n padding: 4px 10px 8px 10px;\r\n}\r\n\r\n#PRJaddOtherFileDialog legend,\r\n#PRJaddSharedFileDialog legend{\r\n color: #2567b0;\r\n}\r\n\r\n#PRJaddOtherFileDialog select,\r\n#PRJaddSharedFileDialog select{\r\n width: 232px;\r\n}\r\n"
          },
