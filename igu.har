            "mimeType": "text/css",
            "text": "div.SPDnavPane{\r\n text-align: center;\r\n position: relative;\r\n top:30px;\r\n height:30px;\r\n}\r\n\r\ndiv.SPDnavPanePadding{\r\n height:15px;\r\n}\r\n\r\nspan.SPDnavText{\r\n margin-right: 7px;\r\n cursor: pointer;\r\n}\r\n\r\ndiv.SPDnavPaneBlocker{\r\n position: absolute;\r\n top: -10px;\r\n bottom: -10px;\r\n left: 0px;\r\n right: 0px;\r\n text-align: center;\r\n z-index: 1;\r\n padding-top: 10px;\r\n}\r\n\r\ndiv.SPDnavPaneBlocker img{\r\n display: none;\r\n opacity: 0.8;              /* Standard style for transparency */\r\n -moz-opacity: 0.8;         /* Transparency for older Mozillas */\r\n filter: alpha(opacity=80); /* For IE */\r\n}\r\n\r\na.SPDdisabled{\r\n color: #AAAAAA;\r\n cursor: default;\r\n}\r\n\r\na.SPDdeleteBTN {\r\n background-color: #EFEFEF;\r\n cursor: pointer;\r\n border: 1px solid #CCC;\r\n padding: 5px;\r\n margin: -4px 0px 0px 5px;\r\n float: left;\r\n border-radius: 3px;\r\n -moz-border-radius: 3px;\r\n}\r\n\r\na.SPDaddBTN{\r\n background-color: #EFEFEF;\r\n cursor: pointer;\r\n border: 1px solid #CCC;\r\n padding: 5px;\r\n margin: -4px 5px 0px 0px;\r\n position: absolute;\r\n right: 55px;\r\n top: 0px;\r\n border-radius: 3px;\r\n -moz-border-radius: 3px;\r\n}\r\n\r\n a.SPDimportBTN{\r\n background-color: #EFEFEF;\r\n cursor: pointer;\r\n border: 1px solid #CCC;\r\n padding: 5px;\r\n margin: -4px 5px 0px 0px;\r\n position: absolute;\r\n right: -8px;\r\n top: 0px;\r\n border-radius: 3px;\r\n -moz-border-radius: 3px;\r\n}\r\n\r\na.SPDaddBTN:link, a.SPDimportBTN:link{\r\n text-decoration:none;\r\n color: black;\r\n}\r\n\r\ninput.DeleteAll{\r\n margin-left: 46px;\r\n float: left;\r\n cursor: default;\r\n}\r\n\r\ninput.SPDdeleteBox{\r\n cursor: default;\r\n}\r\n\r\na.SPDdeleteBTN:hover , a.SPDaddBTN:hover, a.SPDimportBTN:hover{\r\n background-color:#dff4ff;\r\n border:1px solid #c2e1ef;\r\n color:#336699;\r\n}\r\n\r\n.SPDrowHover {\r\n background-color: #FFF8C6;\r\n}\r\n\r\ndiv.SPDgoto{\r\n position: absolute;\r\n background: #DEDEDE url(/js/mapper/images/th_bg.gif) repeat-x 0% 100%;\r\n vertical-align: middle;\r\n border: 1px solid #B1B1B1;\r\n width: auto;\r\n padding: 3px;\r\n}\r\n\r\ndiv.SPDgoto input.SPDgotoInput{\r\n width: 64px;\r\n margin: 0;\r\n padding: 0;\r\n}\r\n\r\ndiv.SPDgoto img{\r\n cursor: pointer;\r\n margin-left: 8px;\r\n vertical-align: middle;\r\n}\r\n\r\ndiv.SPDdataTable{\r\n margin: 15px -15px 15px -15px;\r\n}\r\n\r\ntable.SPDdataTable{\r\n vertical-align:middle;\r\n border-collapse:collapse;\r\n font-size:14px;\r\n background-color: #ffffff;\r\n width: 100%;\r\n table-layout: fixed;\r\n}\r\n\r\ntable.SPDdataTable th{\r\n/* background-color:#dedede;*/\r\n background: #dedede url('/js/mapper/images/th_bg.gif') repeat-x left bottom;\r\n border:1px solid #bbbbbb;\r\n border-bottom: 1px solid #b1b1b1;\r\n color: #666;\r\n padding:6px;\r\n padding-left:10px;\r\n padding-right:10px;\r\n vertical-align:top;\r\n font-size: 11px;\r\n font-weight: normal;\r\n text-shadow: 0 1px 1px #F7F7F7;\r\n}\r\n\r\ntable.SPDdataTable tr{\r\n background-color: #fdfdfd;\r\n}\r\n\r\ntable.SPDdataTable td{\r\n /*background: #fdfdfd url('/js/mapper/images/tr_bg.gif') repeat-x left bottom;*/\r\n border: 1px solid #d5d5d5;\r\n padding:5px;\r\n padding-left: 10px;\r\n vertical-align:top;\r\n font-size: 10px;\r\n color: #555;\r\n white-space: nowrap;\r\n font-family: Monospace,Verdana,Arial,Helvetica,Geneva,Lucida,sans-serif;\r\n font-size: 11px;\r\n overflow: hidden;\r\n}\r\n\r\ntable.SPDdataTable td.SPDop, table.SPDdataTable th.SPDop, table.SPDdataTable td.SPDdeleteRow{\r\n width: 30px;\r\n text-align: center;\r\n padding-left: 0;\r\n padding-right: 0;\r\n}\r\n\r\ntable.SPDdataTable td.SPDindex, table.SPDdataTable th.SPDindex{\r\n width: 50px;\r\n text-align: right;\r\n padding-left: 0;\r\n padding-right: 0;\r\n}\r\n\r\nspan.SPDerrorMessage{\r\n color: red;\r\n}\r\n\r\nspan.SPDsuccessMessage{\r\n color: green;\r\n}\r\n\r\nimg.SPDdeleteButton, img.SPDeditButton{\r\n cursor: pointer;\r\n border: 0;\r\n}\r\n\r\nform.SPDuploadForm{\r\n display: inline;\r\n}\r\n\r\ndiv.SPDwarning{\r\n background-color: #f9fdcb;\r\n background-image: url('/js/mapper/images/icon_warning_large.gif');\r\n background-repeat: no-repeat;\r\n background-position: 15px 12px;\r\n padding-left: 58px;\r\n padding-right: 15px;\r\n height: 50px;\r\n border: 1px solid #d5a95d;\r\n display: table;\r\n position:absolute;\r\n top:40px;\r\n right:10px;\r\n left:10px;\r\n}\r\n\r\n/* We use display:table above and display:table-cell here to accomplish\r\n * vertical centering. */\r\ndiv.SPDwarning div{\r\n display: table-cell;\r\n vertical-align: middle;\r\n}\r\n\r\ndiv.SPDeditorWrapper{\r\n position: absolute;\r\n top: 40px;\r\n left: 10px;\r\n right: 10px;\r\n bottom: 30px;\r\n}\r\n\r\ndiv.SPDajaxError{\r\n position: absolute;\r\n left: 10px;\r\n right: 10px;\r\n bottom: 10px;\r\n color:red;\r\n}\r\n\r\n.SPDeditor{\r\n resize: none;\r\n width: 100%;\r\n height: 100%;\r\n white-space: pre;\r\n overflow : auto;\r\n font-family : monospace;\r\n}\r\n\r\n#SPDmessageEditorWrapper {\r\n   position: absolute;\r\n   top: 70px;\r\n   left: 0px;\r\n   bottom: 30px;\r\n   right: 0px;\r\n}\r\n\r\n/* The buttons need to be absolutely positioned so that they will be displayed\r\nafter the textarea. */\r\ndiv.SPDeditorWrapper div.BTNbuttons {\r\n   position: absolute;\r\n   bottom: -10px;\r\n}\r\n\r\ntable.import_table th {\r\n\ttext-align: left;\r\n\tvertical-align: top;\r\n\tpadding-top: 7px;\r\n\tpadding-right: 10px;\r\n\tfont-size: 12px;\r\n\tcolor: #444;\r\n}\r\n\r\ntable.import_table td {\r\n\tfont-size: 12px;\r\n\tcolor: #555;\r\n\tpadding-top: 6px;\r\n}\r\n\r\nhr {\r\n\tcolor: #ddd;\r\n\tbackground-color: #ddd;\r\n\theight: 1px;\r\n\tborder: none;\r\n\tmargin-bottom: 10px;\r\n}\r\n"
          },
